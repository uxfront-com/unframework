{
  "$schema": "https://json.schemastore.org/tsconfig",
  // L4 for the Vue target: vue-tsc (TypeScript 6) over every case's golden Vue output, with the
  // type strictness every target's checker shares (the strictest of the seven frameworks'
  // project defaults; harness/toolchain-strictness.unit.test.ts). The toolchain's `typecheck`
  // extends this file with an explicit file list, so these options are the contract for both. Vue resolves from the files' own location (tests/integration).
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "preserve",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": [],
    // Consumer fixtures (ADR-0059) sit here, outside tests/integration, where nothing resolves
    // `vue`: map it to the copy the outputs resolve, so both sides see one declaration.
    "paths": { "vue": ["../../integration/node_modules/vue"] }
  },
  // Unknown components, props and events in templates are errors, as in a strict TSX target.
  // `data-*` attributes are allowed on every element, as in HTML and every other target's types:
  // Vue's element types do not declare them, so strict templates would reject each one. The same
  // holds for `accept-charset`, which Vue renders as written but its types misspell
  // (`acceptcharset`); TSX lets the source through, so only the Vue output would fail (ADR-0042).
  "vueCompilerOptions": {
    "strictTemplates": true,
    "dataAttributes": ["data-*", "accept-charset"]
  },
  "include": ["../../integration/cases/**/__output__/vue/**/*.vue", "consumers/**/*.vue"]
}
