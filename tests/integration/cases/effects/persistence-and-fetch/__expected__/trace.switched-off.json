        "    <button aria-pressed=\"true\" type=\"button\">",
        "      \"All\"",
        "    </button>",
        "    <button aria-pressed=\"false\" type=\"button\">",
        "      \"Unread\"",
        "    </button>",
        "  </div>",
        "  <button aria-pressed=\"false\" type=\"button\" uf:focused=\"\">",
        "    \"Check for new books\"",
        "  </button>",
        "  <p>",
        "    \"Checks: 2\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Refresh shelves\"",
        "  </button>",
        "  <ul aria-label=\"Shelves\">",
        "    <li>",
        "      \"Fiction: not counted\"",
