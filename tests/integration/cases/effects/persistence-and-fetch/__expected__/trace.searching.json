        "  - button \"Check for new books\"",
        "  - paragraph: \"Checks: 0\"",
        "  - button \"Refresh shelves\"",
        "  - list \"Shelves\":",
        "    - listitem: \"Fiction: not counted\"",
        "    - listitem: \"History: not counted\"",
        "  - paragraph: Up to date"
      ],
      "events": {
        "cancelled": [
          [
            "d"
          ]
        ],
        "requested": [
          [
            "/api/books?q=du&shelf=all"
          ]
        ]
      }
    }
  ]
}
