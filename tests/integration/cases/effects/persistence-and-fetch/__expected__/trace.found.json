{
  "version": 1,
  "steps": [
    {
      "action": "tick 100ms",
      "dom": [
        "<section aria-label=\"Reading list\" class=\"reading-list\">",
        "  <label>",
        "    \"Search\"",
        "    <input name=\"query\" type=\"search\" uf:focused=\"\" uf:value=\"du\">",
        "  </label>",
        "  <p role=\"status\">",
        "    \"2 found\"",
        "  </p>",
        "  <ul aria-label=\"Books\">",
        "    <li>",
        "      \"Dubliners\"",
        "    </li>",
        "    <li>",
        "      \"Dune\"",
        "    </li>",
        "  </ul>",
        "  <div aria-label=\"Shelf\" role=\"group\">",
        "    <button aria-pressed=\"true\" type=\"button\">",
        "      \"All\"",
        "    </button>",
        "    <button aria-pressed=\"false\" type=\"button\">",
        "      \"Unread\"",
        "    </button>",
        "  </div>",
        "  <button aria-pressed=\"false\" type=\"button\">",
        "    \"Check for new books\"",
        "  </button>",
        "  <p>",
        "    \"Checks: 0\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Refresh shelves\"",
        "  </button>",
        "  <ul aria-label=\"Shelves\">",
        "    <li>",
        "      \"Fiction: not counted\"",
        "    </li>",
        "    <li>",
        "      \"History: not counted\"",
        "    </li>",
        "  </ul>",
        "  <p>",
        "    \"Up to date\"",
        "  </p>",
        "</section>"
      ],
      "aria": [
        "- region \"Reading list\":",
        "  - text: Search",
        "  - searchbox \"Search\": du",
        "  - status: 2 found",
        "  - list \"Books\":",
        "    - listitem: Dubliners",
        "    - listitem: Dune",
        "  - group \"Shelf\":",
        "    - button \"All\" [pressed]",
        "    - button \"Unread\"",
        "  - button \"Check for new books\"",
        "  - paragraph: \"Checks: 0\"",
        "  - button \"Refresh shelves\"",
        "  - list \"Shelves\":",
        "    - listitem: \"Fiction: not counted\"",
        "    - listitem: \"History: not counted\"",
        "  - paragraph: Up to date"
      ],
      "events": {
        "found": [
          [
            "du",
            2
          ]
        ]
      }
    }
  ]
}
