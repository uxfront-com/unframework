{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Mark all read' })",
      "dom": [
        "<section aria-label=\"Inbox\" class=\"unread-badge\">",
        "  <p role=\"status\">",
        "    \"0 unread\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Receive a message\"",
        "  </button>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Mark all read\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Inbox\":",
        "  - status: 0 unread",
        "  - button \"Receive a message\"",
        "  - button \"Mark all read\""
      ],
      "events": {}
    }
  ]
}
