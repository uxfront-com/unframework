        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Inbox\":",
        "  - status: 0 unread",
        "  - button \"Receive a message\"",
        "  - button \"Mark all read\""
      ],
      "events": {
        "titleChange": [
          [
            "(0) Inbox"
          ]
        ],
        "titleRelease": [
          [
            "(2) Inbox"
          ]
        ]
      }
    }
  ]
