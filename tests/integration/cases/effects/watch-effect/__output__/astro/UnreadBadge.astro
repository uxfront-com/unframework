---
import type { HTMLAttributes } from "astro/types";

export interface UnreadBadgeProps {
  appName: string;
}

interface Props extends UnreadBadgeProps, Omit<HTMLAttributes<"section">, "appName"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  appName: _appName,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;

const unread = 0 as number;
---

<section
  class:list={["unread-badge", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Inbox"}
  style={style}
  {...attrs}
>
  <p role="status">{unread} unread</p>
  <button type="button">Receive a message</button>
  <button type="button">Mark all read</button>
</section>
