{
  "version": 1,
  "steps": [
    {
      "action": "rerender {\"currency\":\"USD\"}",
      "dom": [
        "<section aria-label=\"Price range\" class=\"price-range\">",
        "  <p role=\"status\">",
        "    \"10 to 50 USD\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Shift up\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Widen\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Price range\":",
        "  - status: 10 to 50 USD",
        "  - button \"Shift up\"",
        "  - button \"Widen\""
      ],
      "events": {
        "currencyUpdate": [
          [
            "USD"
          ]
        ]
      }
    }
  ]
}
