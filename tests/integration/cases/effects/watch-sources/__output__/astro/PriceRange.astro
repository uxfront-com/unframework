---
import type { HTMLAttributes } from "astro/types";

export interface PriceRangeProps {
  currency: string;
}

interface Props extends PriceRangeProps, Omit<HTMLAttributes<"section">, "currency"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { currency, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const low = 10 as number;
const high = 50 as number;
---

<section
  class:list={["price-range", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Price range"}
  style={style}
  {...attrs}
>
  <p role="status">{low} to {high} {currency}</p>
  <button type="button">Shift up</button>
  <button type="button">Widen</button>
</section>
