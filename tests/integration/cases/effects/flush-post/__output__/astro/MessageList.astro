---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

const messages = ["Welcome to the team"];
---

<section class:list={["message-list", className]} aria-label="Messages" style={style}>
  <ul>
    {messages.map((message) => (
      <li>{message}</li>
    ))}
  </ul>
  <button type="button">Add a message</button>
</section>
