---
import type { HTMLAttributes } from "astro/types";

export interface ImportQueueProps {
  files: string[];
}

interface Props extends ImportQueueProps, Omit<HTMLAttributes<"section">, "files"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { files: _files, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const status = "idle" as string;
const attempts = 0 as number;
---

<section
  class:list={["import-queue", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Import"}
  style={style}
  {...attrs}
>
  <button type="button">Import all</button>
  <p role="status">{status}, {attempts} attempts</p>
</section>
