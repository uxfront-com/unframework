---
export interface MailboxProps {
  folder: string;
}

interface Props extends MailboxProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

const name = "Loading" as string;
const status = "idle" as string;
const summary = "No messages" as string;
---

<section class:list={["mailbox", className]} aria-label="Mailbox" style={style}>
  <h2>{name}</h2>
  <p role="status">{summary}</p>
  <p>Status: {status}</p>
  <button type="button">Save</button>
  <button type="button">Refresh every second</button>
  <button type="button">Mark all read</button>
  <button type="button">Note</button>
</section>
