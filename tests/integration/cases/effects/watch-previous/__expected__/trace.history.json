{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Zoom in' })",
      "dom": [
        "<section aria-label=\"Zoom\" class=\"zoom-control\">",
        "  <output>",
        "    \"125%\"",
        "  </output>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Zoom in\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Zoom out\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Reset\"",
        "  </button>",
        "  <ol aria-label=\"History\">",
        "    <li>",
        "      \"100% to 125%\"",
        "    </li>",
        "  </ol>",
        "</section>"
      ],
      "aria": [
        "- region \"Zoom\":",
        "  - status: 125%",
        "  - button \"Zoom in\"",
        "  - button \"Zoom out\"",
        "  - button \"Reset\"",
        "  - list \"History\":",
        "    - listitem: 100% to 125%"
      ],
      "events": {}
    },
