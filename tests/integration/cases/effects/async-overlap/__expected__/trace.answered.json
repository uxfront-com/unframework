{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Answer lookups' })",
      "dom": [
        "<section aria-label=\"Inbox\" class=\"inbox-lookup\">",
        "  <button type=\"button\">",
        "    \"Find Ann\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Find Anna\"",
        "  </button>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Answer lookups\"",
        "  </button>",
        "  <ol aria-label=\"Answers\">",
        "    <li>",
        "      \"Anna: found\"",
        "    </li>",
        "  </ol>",
        "  <button type=\"button\">",
        "    \"Switch order\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Answer order\"",
        "  </button>",
        "  <p>",
        "    \"Order: none\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Load\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Refresh\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Reply\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Fail\"",
        "  </button>",
        "  <p role=\"status\">",
        "    \"0 messages\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Mark twice\"",
        "  </button>",
        "  <p>",
        "    \"Unread: 0\"",
        "  </p>",
        "</section>"
      ],
      "aria": [
        "- region \"Inbox\":",
        "  - button \"Find Ann\"",
        "  - button \"Find Anna\"",
        "  - button \"Answer lookups\"",
        "  - list \"Answers\":",
        "    - listitem: \"Anna: found\"",
        "  - button \"Switch order\"",
        "  - button \"Answer order\"",
        "  - paragraph: \"Order: none\"",
        "  - button \"Load\"",
        "  - button \"Refresh\"",
        "  - button \"Reply\"",
        "  - button \"Fail\"",
        "  - status: 0 messages",
        "  - button \"Mark twice\"",
        "  - paragraph: \"Unread: 0\""
      ],
      "events": {}
    }
  ]
}
