---
export interface SectionHeadingProps {
  title: string;
}

interface Props extends SectionHeadingProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, class: className, style } = Astro.props;
---

<h2 class:list={["section-heading", className]} style={style}>{title}</h2>
