---
import type { HTMLAttributes } from "astro/types";

export interface SectionHeadingProps {
  title: string;
}

interface Props extends SectionHeadingProps, Omit<HTMLAttributes<"h2">, "title"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, class: className, style, ...attrs } = Astro.props;
---

<h2 class:list={["section-heading", className]} style={style} {...attrs}>{title}</h2>
