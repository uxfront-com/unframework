---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const status = "Loading" as string;
const results = [] as string[];
const doubled = 0 as number;
---

<section
  class:list={["search-results", className]}
  aria-label="Search"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <p>{status}</p>
  <label>Query<input name="query" /></label>
  <ul aria-label="Results">
    {results.map((result) => (
      <li>{result}</li>
    ))}
  </ul>
  <output>{doubled}</output>
  <button type="button">Add one</button>
</section>
