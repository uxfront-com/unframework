---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const channel = "general" as string;
---

<section
  class:list={["channel-picker", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Channels"}
  style={style}
  {...attrs}
>
  <p role="status">Channel: #{channel}</p>
  <button type="button">Join #random</button>
  <button type="button">Join #General</button>
</section>
