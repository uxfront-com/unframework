---
import type { Labelled } from "./types";
import type { HTMLAttributes } from "astro/types";
import type { TimeInterval } from "rxjs";

type StatusProps = TimeInterval<string> & Labelled;

interface Props extends StatusProps, Omit<HTMLAttributes<"p">, "value" | "interval" | "label"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { value, interval, label, class: className, style, ...attrs } = Astro.props;
---

<p class:list={[className]} style={style} {...attrs}>{label}: {value} after {interval} ms</p>
