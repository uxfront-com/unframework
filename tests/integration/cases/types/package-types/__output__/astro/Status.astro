---
export type StatusProps = Pick<SubscriptionLike, "closed"> & { label: string };

interface Props extends StatusProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { closed, label, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<p
  class:list={[className]}
  style={style}
  {...scopeAttributes(Astro.props)}
>{label}: {closed ? "closed" : "open"}</p>
