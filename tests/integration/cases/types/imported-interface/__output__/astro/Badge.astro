---
import type { BadgeProps } from "./types";
import type { HTMLAttributes } from "astro/types";

interface Props extends BadgeProps, Omit<HTMLAttributes<"span">, "label" | "tone"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, tone = "info", class: className, style, ...attrs } = Astro.props;
---

<span class:list={[`badge badge-${tone}`, className]} style={style} {...attrs}>{label}</span>
