---
import Swatch from "./Swatch.astro";
import type { Tone } from "./types";
import type { HTMLAttributes } from "astro/types";

export type { Tone } from "./types";

interface Props extends Omit<HTMLAttributes<"div">, "tone"> {
  tone: Tone;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { tone, class: className, style, ...attrs } = Astro.props;
---

<div class:list={["palette", className]} style={style} {...attrs}>
  <Swatch tone={tone} />
</div>
