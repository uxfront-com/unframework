---
import type { Tone } from "./types";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"span">, "tone"> {
  tone: Tone;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { tone, class: className, style, ...attrs } = Astro.props;
---

<span class:list={[`swatch swatch-${tone}`, className]} style={style} {...attrs}>{tone}</span>
