---
import type { HTMLAttributes } from "astro/types";

export type ButtonTone = "primary" | "secondary";

export type ButtonSize = "small" | "large";

export interface ButtonProps {
  label: string;
  tone?: ButtonTone;
}

interface Props extends ButtonProps, Omit<HTMLAttributes<"button">, "label" | "tone"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, tone = "primary", class: className, style, type, ...attrs } = Astro.props;
---

<button
  type={"type" in Astro.props ? type : "button"}
  class:list={[`button button-${tone}`, className]}
  style={style}
  {...attrs}
>{label}</button>
