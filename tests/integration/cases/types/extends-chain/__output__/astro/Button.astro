---
import type { ButtonProps } from "./types";
import type { HTMLAttributes } from "astro/types";

interface Props extends ButtonProps, Omit<HTMLAttributes<"button">, "disabled" | "label" | "id"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { id, label, disabled = false, class: className, style, type, ...attrs } = Astro.props;
---

<button
  id={id}
  type={"type" in Astro.props ? type : "button"}
  disabled={disabled}
  class:list={[className]}
  style={style}
  {...attrs}
>{label}</button>
