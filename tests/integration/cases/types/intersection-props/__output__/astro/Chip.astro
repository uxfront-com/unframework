---
import type { Sized, Toned } from "./types";
import type { HTMLAttributes } from "astro/types";

type ChipProps = Sized & Toned & { label: string };

interface Props extends ChipProps, Omit<HTMLAttributes<"span">, "size" | "tone" | "label"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { size, tone = "neutral", label, class: className, style, ...attrs } = Astro.props;
---

<span
  class:list={[`chip chip-${size} chip-${tone}`, className]}
  style={style}
  {...attrs}
>{label}</span>
