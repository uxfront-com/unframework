---
import type { HTMLAttributes } from "astro/types";

export interface FieldProps {
  name: string;
  label: string;
}

interface Props extends FieldProps, Omit<HTMLAttributes<"label">, "name" | "label"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { name, label, class: className, style, ...attrs } = Astro.props;
---

<label class:list={[className]} style={style} {...attrs}>{label}<input name={name} /></label>
