{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Rename' })",
      "dom": [
        "<section aria-label=\"Card\" class=\"card\">",
        "  <div class=\"disclosure\">",
        "    <button aria-expanded=\"false\" type=\"button\">",
        "      \"Details\"",
        "    </button>",
        "  </div>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Rename\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Card\":",
        "  - button \"Details\"",
        "  - button \"Rename\""
      ],
      "events": {}
    }
  ]
}
