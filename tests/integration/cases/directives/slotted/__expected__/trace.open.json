{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Details' })",
      "dom": [
        "<section aria-label=\"Card\" class=\"card\">",
        "  <div class=\"disclosure\">",
        "    <button aria-expanded=\"true\" type=\"button\" uf:focused=\"\">",
        "      \"Details\"",
        "    </button>",
        "    <div class=\"body\">",
        "      <p data-name=\"body\">",
        "        \"Body\"",
        "      </p>",
        "    </div>",
        "  </div>",
        "</section>"
      ],
      "aria": [
        "- region \"Card\":",
        "  - button \"Details\" [expanded]",
        "  - paragraph: Body"
      ],
      "events": {}
    }
  ]
}
