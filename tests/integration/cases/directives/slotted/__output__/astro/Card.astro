---
import Disclosure from "./Disclosure.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const note = { name: "note" } as { name: string } | null;
---

<section
  class:list={["card", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Card"}
  style={style}
  {...attrs}
>
  <Disclosure>
    <p data-name="body">Body</p>
    {note ? (
      <p data-name="note">Note</p>
    ) : null}
  </Disclosure>
  <button type="button">Rename</button>
</section>
