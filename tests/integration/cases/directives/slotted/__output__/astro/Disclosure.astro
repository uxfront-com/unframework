---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, ...attrs } = Astro.props;

const open = false as boolean;
---

<div class:list={["disclosure", className]} style={style} {...attrs}>
  <button type="button" aria-expanded={open}>Details</button>
  {open ? (
    <div class="body">
      <slot />
    </div>
  ) : null}
</div>
