---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const open = false as boolean;
---

<section
  class:list={["settings", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Settings"}
  style={style}
  {...attrs}
>
  <button type="button">Open</button>
  {open ? (
    <div role="dialog" aria-label="Preferences" tabindex="-1" class="dialog">
      <button type="button">Theme</button>
      <button type="button">Language</button>
      <button type="button">Close</button>
    </div>
  ) : null}
</section>
