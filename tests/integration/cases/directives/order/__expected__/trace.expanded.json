{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Toggle' })",
      "dom": [
        "<section aria-label=\"Tree\" class=\"tree\" data-name=\"outer\">",
        "  <p data-name=\"first\">",
        "    \"First\"",
        "  </p>",
        "  <em data-name=\"note\">",
        "    \"Note\"",
        "  </em>",
        "  <div class=\"branch\" data-name=\"branch\">",
        "    <span data-name=\"leaf\">",
        "      \"Leaf\"",
        "    </span>",
        "  </div>",
        "  <p data-name=\"last\">",
        "    \"Last\"",
        "  </p>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Toggle\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Tree\":",
        "  - paragraph: First",
        "  - emphasis: Note",
        "  - text: Leaf",
        "  - paragraph: Last",
        "  - button \"Toggle\""
      ],
      "events": {}
    }
  ]
}
