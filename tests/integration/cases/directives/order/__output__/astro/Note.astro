---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"em"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "data-name": dataName, ...attrs } = Astro.props;
---

<em
  data-name={"data-name" in Astro.props ? dataName : "note"}
  class:list={[className]}
  style={style}
  {...attrs}
>Note</em>
