---
import Note from "./Note.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  class: className,
  style,
  "aria-label": ariaLabel,
  "data-name": dataName,
  ...attrs
} = Astro.props;

const shown = true as boolean;
---

<section
  class:list={["tree", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Tree"}
  data-name={"data-name" in Astro.props ? dataName : "outer"}
  style={style}
  {...attrs}
>
  <p data-name="first">First</p>
  <Note />
  {shown ? (
    <div class="branch" data-name="branch">
      <span data-name="leaf">Leaf</span>
    </div>
  ) : (
    <p data-name="placeholder">Placeholder</p>
  )}
  <p data-name="last">Last</p>
  <button type="button">Toggle</button>
</section>
