---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "option"> {
  option?: (props: { option: { id: string; label: string } }) => unknown;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { option: option_1, class: className, style, ...attrs } = Astro.props;

const options = [
  { id: "x", label: "Xray" },
  { id: "y", label: "Yankee" },
];
---

<div class:list={["picker", className]} style={style} {...attrs}>
  <ul aria-label="Options">
    {options.map((option) => (
      <li>{option_1?.({ option })}</li>
    ))}
  </ul>
  <button type="button">Reverse options</button>
  <button type="button">Remove option</button>
</div>
