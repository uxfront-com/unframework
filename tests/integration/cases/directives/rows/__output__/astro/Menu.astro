---
import Picker from "./Picker.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const items = [
  { id: "a", label: "Alpha", note: "First" },
  { id: "b", label: "Beta" },
  { id: "c", label: "Gamma" },
] as { id: string; label: string; note?: string }[];

const focused = 0 as number;
---

<section
  class:list={["menu", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Menu"}
  style={style}
  {...attrs}
>
  <ul aria-label="Items">
    {items.map((item) => (
      <li
        data-name={item.id}
      >{item.label}{item.note ? <b data-name={`note-${item.id}`}>{item.note}</b> : null}</li>
    ))}
  </ul>
  <ul aria-label="Marked">
    {items.map((item) => (
      <li data-name={`both-${item.id}`}>{item.label}</li>
    ))}
  </ul>
  <div class="focus">
    {items.map((item) => (
      <button type="button" data-name={`focus-${item.id}`}>Focus {item.label}</button>
    ))}
  </div>
  <output>{focused}</output>
  <ul aria-label="Prefixed">
    {items.map((item) => (
      <li data-name={`prefixed-${item.id}`}>{item.label}</li>
    ))}
  </ul>
  <Picker option={({ option }) => <span data-name={`option-${option.id}`}>{option.label}</span>} />
  <button type="button">Rename first</button>
  <button type="button">Reverse</button>
  <button type="button">Remove second</button>
  <button type="button">Add item</button>
  <button type="button">Change prefix</button>
</section>
