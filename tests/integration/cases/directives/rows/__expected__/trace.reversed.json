        "    </li>",
        "    <li data-name=\"both-b\">",
        "      \"Beta\"",
        "    </li>",
        "    <li data-name=\"both-c\">",
        "      \"Gamma\"",
        "    </li>",
        "  </ul>",
        "  <div class=\"focus\">",
        "    <button data-name=\"focus-a\" type=\"button\">",
        "      \"Focus Alpha 2\"",
        "    </button>",
        "    <button data-name=\"focus-b\" type=\"button\" uf:focused=\"\">",
        "      \"Focus Beta\"",
        "    </button>",
        "    <button data-name=\"focus-c\" type=\"button\">",
        "      \"Focus Gamma\"",
        "    </button>",
        "  </div>",
        "  <output>",
