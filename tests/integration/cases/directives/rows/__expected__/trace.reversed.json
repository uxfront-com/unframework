        "    \"Add item\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Change prefix\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Menu\":",
        "  - list \"Items\":",
        "    - listitem: Alpha 2",
        "    - listitem: Beta",
        "    - listitem: Gamma",
        "  - list \"Marked\":",
        "    - listitem: Alpha 2",
        "    - listitem: Beta",
        "    - listitem: Gamma",
        "  - button \"Focus Alpha 2\"",
        "  - button \"Focus Beta\"",
        "  - button \"Focus Gamma\"",
        "  - status: \"2\"",
        "  - list \"Prefixed\":",
        "    - listitem: Alpha 2",
        "    - listitem: Beta",
        "    - listitem: Gamma",
        "  - list \"Options\":",
        "    - listitem: Xray",
        "    - listitem: Yankee",
        "  - button \"Rename option\"",
        "  - button \"Reverse options\"",
        "  - button \"Remove option\"",
        "  - button \"Rename first\"",
        "  - button \"Reverse\"",
        "  - button \"Remove second\"",
        "  - button \"Add item\"",
        "  - button \"Change prefix\""
      ],
      "events": {}
    },
