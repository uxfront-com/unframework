        "      <li>",
        "        <span data-name=\"option-x\">",
        "          \"Xray\"",
        "        </span>",
        "      </li>",
        "      <li>",
        "        <span data-name=\"option-y\">",
        "          \"Yankee\"",
        "        </span>",
        "      </li>",
        "    </ul>",
        "    <button type=\"button\">",
        "      \"Rename option\"",
        "    </button>",
        "    <button type=\"button\">",
