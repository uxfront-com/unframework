{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Rename option' })",
      "dom": [
        "<section aria-label=\"Page\" class=\"page\">",
        "  <div class=\"picker\">",
        "    <ul aria-label=\"Options\">",
        "      <li>",
        "        <span data-name=\"option-x\">",
        "          \"Xenon\"",
        "        </span>",
        "      </li>",
        "      <li>",
        "        <span data-name=\"option-y\">",
        "          \"Yankee\"",
        "        </span>",
        "      </li>",
        "    </ul>",
        "    <button type=\"button\" uf:focused=\"\">",
        "      \"Rename option\"",
        "    </button>",
        "  </div>",
        "</section>"
      ],
      "aria": [
        "- region \"Page\":",
        "  - list \"Options\":",
        "    - listitem: Xenon",
        "    - listitem: Yankee",
        "  - button \"Rename option\""
      ],
      "events": {}
    }
  ]
}
