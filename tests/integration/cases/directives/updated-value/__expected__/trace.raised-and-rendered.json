{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Render again' })",
      "dom": [
        "<section aria-label=\"Meter\" class=\"meter\">",
        "  <output class=\"level\" data-old-value=\"1\" data-updates=\"1\" data-value=\"2\">",
        "    \"Level 2\"",
        "  </output>",
        "  <p>",
        "    \"Rendered again 2 times\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Raise\"",
        "  </button>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Render again\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Meter\":",
        "  - status: Level 2",
        "  - paragraph: Rendered again 2 times",
        "  - button \"Raise\"",
        "  - button \"Render again\""
      ],
      "events": {}
    }
  ]
}
