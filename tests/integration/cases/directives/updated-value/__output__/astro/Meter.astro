---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const level = 1 as number;
const renders = 0 as number;
---

<section
  class:list={["meter", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Meter"}
  style={style}
  {...attrs}
>
  <output class="level">Level {level}</output>
  <p>Rendered again {renders} times</p>
  <button type="button">Raise</button>
  <button type="button">Render again</button>
</section>
