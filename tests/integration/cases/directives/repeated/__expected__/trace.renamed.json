{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Rename' })",
      "dom": [
        "<section aria-label=\"Page\" class=\"page\">",
        "  <section aria-label=\"Rows\" class=\"wrapper\">",
        "    <div class=\"rows\">",
        "      <ul>",
        "        <li>",
        "          <span data-name=\"row\">",
        "            \"Row\"",
        "          </span>",
        "        </li>",
        "        <li>",
        "          <span data-name=\"row\">",
        "            \"Row\"",
        "          </span>",
        "        </li>",
        "      </ul>",
        "      <button type=\"button\">",
        "        \"Add row\"",
        "      </button>",
        "      <button type=\"button\">",
        "        \"Remove row\"",
        "      </button>",
        "    </div>",
        "  </section>",
        "  <div class=\"choice\">",
        "    <b>",
        "      <em data-name=\"body\">",
        "        \"Body\"",
        "      </em>",
        "    </b>",
        "    <button type=\"button\">",
        "      \"Switch\"",
        "    </button>",
        "  </div>",
        "  <ol>",
        "    <li>",
        "      <strong data-name=\"item\">",
        "        \"a\"",
        "      </strong>",
        "    </li>",
        "    <li>",
        "      <strong data-name=\"item\">",
        "        \"b\"",
        "      </strong>",
        "    </li>",
        "  </ol>",
        "  <p data-name=\"note\">",
        "    \"Note\"",
        "  </p>",
        "  <output>",
        "    \"note\"",
        "  </output>",
        "  <button type=\"button\">",
        "    \"Check\"",
        "  </button>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Rename\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Page\":",
        "  - region \"Rows\":",
        "    - list:",
        "      - listitem: Row",
        "      - listitem: Row",
        "    - button \"Add row\"",
        "    - button \"Remove row\"",
        "  - emphasis: Body",
        "  - button \"Switch\"",
        "  - list:",
        "    - listitem:",
        "      - strong: a",
        "    - listitem:",
        "      - strong: b",
        "  - paragraph: Note",
        "  - status: note",
        "  - button \"Check\"",
        "  - button \"Rename\""
      ],
      "events": {}
    }
  ]
}
