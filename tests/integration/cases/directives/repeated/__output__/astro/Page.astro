---
import Choice from "./Choice.astro";
import List from "./List.astro";
import Wrapper from "./Wrapper.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const noted = "" as string;
---

<section
  class:list={["page", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Page"}
  style={style}
  {...attrs}
>
  <Wrapper>
    <Fragment slot="row">
      <span data-name="row">Row</span>
    </Fragment>
  </Wrapper>
  <Choice>
    <Fragment slot="body">
      <em data-name="body">Body</em>
    </Fragment>
  </Choice>
  <List items={["a", "b"]} item={({ item }) => <strong data-name="item">{item}</strong>} />
  <p data-name="note">Note</p>
  <output>{noted}</output>
  <button type="button">Check</button>
  <button type="button">Rename</button>
</section>
