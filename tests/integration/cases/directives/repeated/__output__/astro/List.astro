---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"ol">, "items" | "item"> {
  items: string[];
  item?: (props: { item: string }) => unknown;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { items, item: item_1, class: className, style, ...attrs } = Astro.props;
---

<ol class:list={[className]} style={style} {...attrs}>
  {items.map((item) => (
    <li>{item_1?.({ item })}</li>
  ))}
</ol>
