---
import type { HTMLAttributes } from "astro/types";

export interface TagProps {
  name: string;
}

interface Props extends TagProps, Omit<HTMLAttributes<"em">, "name"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { name, class: className, style, ...attrs } = Astro.props;
---

<em class:list={["tag", className]} style={style} {...attrs}>#{name}</em>
