---
import type { HTMLAttributes } from "astro/types";

interface User {
  name: string;
}

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const user = { name: "Ada" } as User | null;
const note = "Hello" as string;
const label = "Lovelace" as string | number;
const nick = "Al" as string | undefined;
const cleanup = "Tidy" as string | null;
---

<section
  class:list={["profile", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Profile"}
  style={style}
  {...attrs}
>
  {user ? (
    <p>{user.name}</p>
  ) : null}
  {typeof label === "string" ? (
    <b>{label}</b>
  ) : null}
  {nick ? (
    <i>{nick}</i>
  ) : null}
  {cleanup ? (
    <s>{cleanup}</s>
  ) : null}
  <textarea aria-label="Note">{note}</textarea>
  <button type="button">Toggle</button>
  <button type="button">Count</button>
  <button type="button">Forget</button>
</section>
