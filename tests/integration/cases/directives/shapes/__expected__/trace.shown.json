{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Toggle' })",
      "dom": [
        "<section aria-label=\"Profile\" class=\"profile\">",
        "  <p data-element=\"mounted\" data-hooks=\"Grace\">",
        "    \"Grace\"",
        "  </p>",
        "  <b data-element=\"mounted\" data-hooks=\"Lovelace\">",
        "    \"Lovelace\"",
        "  </b>",
        "  <i data-element=\"mounted\" data-hooks=\"Al\">",
        "    \"Al\"",
        "  </i>",
        "  <s data-element=\"mounted\" data-hooks=\"TidyTrail\">",
        "    \"Tidy\"",
        "  </s>",
        "  <textarea aria-label=\"Note\" data-element=\"mounted\" data-hooks=\"updated Hi\" data-queue=\"queued\" data-selectable=\"true\" data-untrack=\"mounted\" uf:value=\"Hi\"></textarea>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Toggle\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Count\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Forget\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Profile\":",
        "  - paragraph: Grace",
        "  - text: LovelaceAlTidy",
        "  - textbox \"Note\": Hi",
        "  - button \"Toggle\"",
        "  - button \"Count\"",
        "  - button \"Forget\""
      ],
      "events": {}
    }
  ]
}
