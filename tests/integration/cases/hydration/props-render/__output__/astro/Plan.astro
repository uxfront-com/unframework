---
import type { HTMLAttributes } from "astro/types";

export interface PlanProps {
  name: string;
  price: number;
  href: string;
  featured?: boolean;
  note?: string;
}

interface Props
  extends
    PlanProps,
    Omit<HTMLAttributes<"article">, "name" | "price" | "href" | "featured" | "note"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  name,
  price,
  href,
  featured = false,
  note,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
---

<article
  class:list={[featured ? "plan featured" : "plan", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : name}
  style={style}
  {...attrs}
>
  <h2>{name}</h2>
  <p>{price} EUR a month</p>
  {note ? (
    <p class="note">{note}</p>
  ) : (
    <p class="note">No commitment.</p>
  )}
  <a href={href}>Choose {name}</a>
</article>
