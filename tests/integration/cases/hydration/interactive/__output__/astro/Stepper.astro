---
import type { HTMLAttributes } from "astro/types";

export interface StepperProps {
  start?: number;
}

interface Props extends StepperProps, Omit<HTMLAttributes<"div">, "start"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { start = 0, class: className, style, ...attrs } = Astro.props;

const count = start;
---

<div class:list={["stepper", className]} style={style} {...attrs}>
  <output>{count}</output>
  <button type="button">Add one</button>
</div>
