---
import Field from "./Field.astro";
import type { HTMLAttributes } from "astro/types";

export interface SignupProps {
  name: string;
  email: string;
}

interface Props extends SignupProps, Omit<HTMLAttributes<"form">, "name" | "email"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { name, email, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;
---

<form
  class:list={["signup", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Sign up"}
  style={style}
  {...attrs}
>
  <Field label={name} hint="As it appears on your card." />
  <Field label={email} hint="We send the receipt here." />
</form>
