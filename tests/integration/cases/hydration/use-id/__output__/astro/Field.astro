---
export interface FieldProps {
  label: string;
  hint: string;
}

interface Props extends FieldProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, hint, class: className, style } = Astro.props;

function uniqueId(): string {
  const locals = Astro.locals as { ufIdCount?: number };
  locals.ufIdCount = (locals.ufIdCount ?? 0) + 1;
  return `uf-id-${locals.ufIdCount}`;
}

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const inputId = uniqueId();
const hintId = uniqueId();
---

<p class:list={["field", className]} style={style} {...scopeAttributes(Astro.props)}>
  <label for={inputId}>{label}</label>
  <input id={inputId} type="text" aria-describedby={hintId} />
  <small id={hintId}>{hint}</small>
</p>
