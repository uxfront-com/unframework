---
import type { HTMLAttributes } from "astro/types";

export interface SizePickerProps {
  legend: string;
  sizes: string[];
}

interface Props extends SizePickerProps, Omit<HTMLAttributes<"fieldset">, "legend" | "sizes"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  legend,
  sizes,
  class: className,
  style,
  "aria-describedby": ariaDescribedby,
  ...attrs
} = Astro.props;

function uniqueId(): string {
  const locals = Astro.locals as { ufIdCount?: number };
  locals.ufIdCount = (locals.ufIdCount ?? 0) + 1;
  return `uf-id-${locals.ufIdCount}`;
}

const group = uniqueId();
const hintId = uniqueId();
const picked = "" as string;
---

<fieldset
  class:list={["size-picker", className]}
  aria-describedby={"aria-describedby" in Astro.props ? ariaDescribedby : hintId}
  style={style}
  {...attrs}
>
  <legend>{legend}</legend>
  <p id={hintId}>Pick one size.</p>
  {sizes.map((size, index) => (
    <div class="size">
      <input type="radio" id={`${group}-${index}`} name={group} value={size} />
      <label for={`${group}-${index}`}>{size}</label>
    </div>
  ))}
  <output>{picked || "none"}</output>
</fieldset>
