---
export interface SizePickerProps {
  legend: string;
  sizes: string[];
}

interface Props extends SizePickerProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { legend, sizes, class: className, style } = Astro.props;

function uniqueId(): string {
  const locals = Astro.locals as { ufIdCount?: number };
  locals.ufIdCount = (locals.ufIdCount ?? 0) + 1;
  return `uf-id-${locals.ufIdCount}`;
}

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const group = uniqueId();
const hintId = uniqueId();
const picked = "" as string;
---

<fieldset
  class:list={["size-picker", className]}
  aria-describedby={hintId}
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <legend>{legend}</legend>
  <p id={hintId}>Pick one size.</p>
  {sizes.map((size, index) => (
    <div class="size">
      <input type="radio" id={`${group}-${index}`} name={group} value={size} />
      <label for={`${group}-${index}`}>{size}</label>
    </div>
  ))}
  <output>{picked || "none"}</output>
</fieldset>
