{
  "version": 1,
  "steps": [
    {
      "action": "click getByText('M')",
      "dom": [
        "<fieldset aria-describedby=\"uf-id-1\" class=\"size-picker\">",
        "  <legend>",
        "    \"Size\"",
        "  </legend>",
        "  <p id=\"uf-id-1\">",
        "    \"Pick one size.\"",
        "  </p>",
        "  <div class=\"size\">",
        "    <input id=\"uf-id-2\" name=\"uf-id-3\" type=\"radio\" uf:checked=\"false\" value=\"S\">",
        "    <label for=\"uf-id-2\">",
        "      \"S\"",
        "    </label>",
        "  </div>",
        "  <div class=\"size\">",
        "    <input id=\"uf-id-4\" name=\"uf-id-3\" type=\"radio\" uf:checked=\"true\" uf:focused=\"\" value=\"M\">",
        "    <label for=\"uf-id-4\">",
        "      \"M\"",
        "    </label>",
        "  </div>",
        "  <div class=\"size\">",
        "    <input id=\"uf-id-5\" name=\"uf-id-3\" type=\"radio\" uf:checked=\"false\" value=\"L\">",
        "    <label for=\"uf-id-5\">",
        "      \"L\"",
        "    </label>",
        "  </div>",
        "  <output>",
        "    \"M\"",
        "  </output>",
        "</fieldset>"
      ],
      "aria": [
        "- group \"Size\":",
        "  - text: Size",
        "  - paragraph: Pick one size.",
        "  - radio \"S\"",
        "  - text: S",
        "  - radio \"M\" [checked]",
        "  - text: M",
        "  - radio \"L\"",
        "  - text: L",
        "  - status: M"
      ],
      "events": {}
    }
  ]
}
