---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"label">, "label"> {
  label: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, class: className, style, ...attrs } = Astro.props;
---

<label
  class:list={["search", className]}
  style={style}
  {...attrs}
>{label}<input type="search" /></label>
