{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Reset' })",
      "dom": [
        "<div class=\"controls\">",
        "  <output class=\"count\">",
        "    \"10\"",
        "  </output>",
        "  <button type=\"button\">",
        "    \"More\"",
        "  </button>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Reset\"",
        "  </button>",
        "</div>"
      ],
      "aria": [
        "- status: \"10\"",
        "- button \"More\"",
        "- button \"Reset\""
      ],
      "events": {}
    }
  ]
}
