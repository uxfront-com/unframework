---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"output">, "start"> {
  start: number;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { start, class: className, style, ...attrs } = Astro.props;

const count = start;
---

<output class:list={["count", className]} style={style} {...attrs}>{count}</output>
