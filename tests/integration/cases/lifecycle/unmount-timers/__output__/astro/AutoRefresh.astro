---
import type { HTMLAttributes } from "astro/types";

export interface AutoRefreshProps {
  /** Milliseconds between two refreshes. */
  interval: number;
}

interface Props extends AutoRefreshProps, Omit<HTMLAttributes<"section">, "interval"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  interval: _interval,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;

const enabled = false as boolean;
---

<section
  class:list={["auto-refresh", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Auto-refresh"}
  style={style}
  {...attrs}
>
  <button type="button" aria-pressed={enabled}>Auto-refresh</button>
  <p role="status">{enabled ? "Refreshing" : "Paused"}</p>
</section>
