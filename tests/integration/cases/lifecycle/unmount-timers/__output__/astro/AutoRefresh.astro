---
export interface AutoRefreshProps {
  /** Milliseconds between two refreshes. */
  interval: number;
}

interface Props extends AutoRefreshProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const enabled = false as boolean;
---

<section
  class:list={["auto-refresh", className]}
  aria-label="Auto-refresh"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <button type="button" aria-pressed={enabled}>Auto-refresh</button>
  <p role="status">{enabled ? "Refreshing" : "Paused"}</p>
</section>
