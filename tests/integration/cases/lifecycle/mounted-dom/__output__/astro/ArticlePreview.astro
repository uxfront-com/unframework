---
export interface ArticlePreviewProps {
  title: string;
  text: string;
}

interface Props extends ArticlePreviewProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, text, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const characters = 0 as number;
const counted = false as boolean;
---

<article
  class:list={["article-preview", className]}
  aria-label={title}
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <h2>{title}</h2>
  <p>{text}</p>
  <p role="status">{counted ? `${characters} characters` : "Counting the characters"}</p>
</article>
