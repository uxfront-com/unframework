---
import type { HTMLAttributes } from "astro/types";

export interface ArticlePreviewProps {
  title: string;
  text: string;
}

interface Props extends ArticlePreviewProps, Omit<HTMLAttributes<"article">, "title" | "text"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, text, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const characters = 0 as number;
const counted = false as boolean;
---

<article
  class:list={["article-preview", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : title}
  style={style}
  {...attrs}
>
  <h2>{title}</h2>
  <p>{text}</p>
  <p role="status">{counted ? `${characters} characters` : "Counting the characters"}</p>
</article>
