{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Account' })",
      "dom": [
        "<section aria-label=\"Profile\" class=\"profile-menu\">",
        "  <div class=\"menu\">",
        "    <button aria-expanded=\"true\" type=\"button\" uf:focused=\"\">",
        "      \"Account\"",
        "    </button>",
        "    <ul aria-label=\"Account actions\">",
        "      <li>",
        "        <button type=\"button\">",
        "          \"Settings\"",
        "        </button>",
        "      </li>",
        "      <li>",
        "        <button type=\"button\">",
        "          \"Sign out\"",
        "        </button>",
        "      </li>",
        "    </ul>",
        "  </div>",
        "  <p>",
        "    \"Outside the menu\"",
        "  </p>",
        "</section>"
      ],
      "aria": [
        "- region \"Profile\":",
        "  - button \"Account\" [expanded]",
        "  - list \"Account actions\":",
        "    - listitem:",
        "      - button \"Settings\"",
        "    - listitem:",
        "      - button \"Sign out\"",
        "  - paragraph: Outside the menu"
      ],
      "events": {}
    }
  ]
}
