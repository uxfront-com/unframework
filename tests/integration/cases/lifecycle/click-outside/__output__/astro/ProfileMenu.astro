---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const open = false as boolean;
---

<section
  class:list={["profile-menu", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Profile"}
  style={style}
  {...attrs}
>
  <div class="menu">
    <button type="button" aria-expanded={open}>Account</button>
    {open ? (
      <ul aria-label="Account actions">
        <li>
          <button type="button">Settings</button>
        </li>
        <li>
          <button type="button">Sign out</button>
        </li>
      </ul>
    ) : null}
  </div>
  <p>Outside the menu</p>
</section>
