---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const results = [] as string[];
---

<section
  class:list={["search-session", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Search"}
  style={style}
  {...attrs}
>
  <label>Query<input name="query" /></label>
  <ul aria-label="Results">
    {results.map((result) => (
      <li>{result}</li>
    ))}
  </ul>
  <button type="button">Clear results</button>
</section>
