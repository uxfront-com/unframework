{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Shortcut K' })",
      "dom": [
        "<section aria-label=\"Shortcuts\" class=\"shortcut-tip\">",
        "  <p>",
        "    \"Press Escape to hide this tip.\"",
        "  </p>",
        "  <button aria-pressed=\"false\" type=\"button\" uf:focused=\"\">",
        "    \"Shortcut K\"",
        "  </button>",
        "  <p role=\"status\">",
        "    \"Used: 1\"",
        "  </p>",
        "</section>"
      ],
      "aria": [
        "- region \"Shortcuts\":",
        "  - paragraph: Press Escape to hide this tip.",
        "  - button \"Shortcut K\"",
        "  - status: \"Used: 1\""
      ],
      "events": {}
    },
    {
