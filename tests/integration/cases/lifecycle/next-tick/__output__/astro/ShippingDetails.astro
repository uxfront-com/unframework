---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

const open = false as boolean;
---

<section class:list={["shipping-details", className]} aria-label="Shipping" style={style}>
  <button type="button" aria-expanded={open}>Shipping details</button>
  {open ? (
    <ul>
      <li>Ships in two days</li>
      <li>Free returns</li>
      <li>Tracked delivery</li>
    </ul>
  ) : null}
</section>
