---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const open = false as boolean;
---

<section
  class:list={["shipping-details", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Shipping"}
  style={style}
  {...attrs}
>
  <button type="button" aria-expanded={open}>Shipping details</button>
  {open ? (
    <ul>
      <li>Ships in two days</li>
      <li>Free returns</li>
      <li>Tracked delivery</li>
    </ul>
  ) : null}
</section>
