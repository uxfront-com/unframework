{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Search' })",
      "dom": [
        "<div class=\"search-toggle\" role=\"search\">",
        "  <button type=\"button\">",
        "    \"Search\"",
        "  </button>",
        "  <input aria-label=\"Search the docs\" name=\"query\" uf:focused=\"\" uf:value=\"\">",
        "</div>"
      ],
      "aria": [
        "- search:",
        "  - button \"Search\"",
        "  - textbox \"Search the docs\""
      ],
      "events": {}
    }
  ]
}
