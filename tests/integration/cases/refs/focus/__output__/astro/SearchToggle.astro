---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, role, ...attrs } = Astro.props;
---

<div
  class:list={["search-toggle", className]}
  role={"role" in Astro.props ? role : "search"}
  style={style}
  {...attrs}
>
  <button type="button">Search</button>
  <input name="query" aria-label="Search the docs" />
</div>
