---
export interface StepListProps {
  title: string;
  steps: string[];
}

interface Props extends StepListProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, steps, class: className, style } = Astro.props;
---

<ol class:list={["step-list", className]} aria-label={title} style={style}>
  {steps.map((step, index) => (
    <li data-step={index + 1}>Step {index + 1}: {step}</li>
  ))}
</ol>
