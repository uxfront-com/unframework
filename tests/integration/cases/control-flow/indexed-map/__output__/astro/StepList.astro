---
import type { HTMLAttributes } from "astro/types";

export interface StepListProps {
  title: string;
  steps: string[];
}

interface Props extends StepListProps, Omit<HTMLAttributes<"ol">, "title" | "steps"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, steps, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;
---

<ol
  class:list={["step-list", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : title}
  style={style}
  {...attrs}
>
  {steps.map((step, index) => (
    <li data-step={index + 1}>Step {index + 1}: {step}</li>
  ))}
</ol>
