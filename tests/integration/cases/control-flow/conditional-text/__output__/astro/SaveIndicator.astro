---
export interface SaveIndicatorProps {
  saving: boolean;
  changes: number;
  savedAt?: string;
}

interface Props extends SaveIndicatorProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { saving, changes, savedAt, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<p
  class:list={["save-indicator", className]}
  role="status"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  {saving ? <em>Saving</em> : "Saved"}, {changes === 1 ? "1 change" : `${changes} changes`}{savedAt ? <time
    datetime={savedAt}
  >{" at " + savedAt}</time> : " just now"}
</p>
