---
import type { HTMLAttributes } from "astro/types";

export interface SaveIndicatorProps {
  saving: boolean;
  changes: number;
  savedAt?: string;
}

interface Props
  extends SaveIndicatorProps, Omit<HTMLAttributes<"p">, "saving" | "changes" | "savedAt"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { saving, changes, savedAt, class: className, style, role, ...attrs } = Astro.props;
---

<p
  class:list={["save-indicator", className]}
  role={"role" in Astro.props ? role : "status"}
  style={style}
  {...attrs}
>
  {saving ? <em>Saving</em> : "Saved"}, {changes === 1 ? "1 change" : `${changes} changes`}{savedAt ? <time
    datetime={savedAt}
  >{" at " + savedAt}</time> : " just now"}
</p>
