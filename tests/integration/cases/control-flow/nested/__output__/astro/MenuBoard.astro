---
export interface MenuDish {
  id: string;
  name: string;
  price: number;
  vegetarian: boolean;
}

export interface MenuCourse {
  id: string;
  title: string;
  dishes: MenuDish[];
}

export interface MenuBoardProps {
  courses: MenuCourse[];
  closed: boolean;
}

interface Props extends MenuBoardProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { courses, closed, class: className, style } = Astro.props;
---

<div class:list={["menu-board", className]} style={style}>
  {closed ? (
    <p>The kitchen is closed.</p>
  ) : (
    <>
      {courses.map((course) => (
        <section aria-label={course.title}>
          <h2>{course.title}</h2>
          <ul>
            {course.dishes.map((dish) => (
              <li>{dish.name}, {dish.price.toFixed(2)}{dish.vegetarian ? <span> (vegetarian)</span> : null}</li>
            ))}
          </ul>
        </section>
      ))}
    </>
  )}
</div>
