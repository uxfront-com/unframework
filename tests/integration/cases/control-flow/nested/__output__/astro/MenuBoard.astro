---
export interface MenuDish {
  id: string;
  name: string;
  price: number;
  vegetarian: boolean;
}

export interface MenuCourse {
  id: string;
  title: string;
  dishes: MenuDish[];
}

export interface MenuBoardProps {
  courses: MenuCourse[];
  closed: boolean;
}

type Props = MenuBoardProps;

const { courses, closed } = Astro.props;
---

<div class="menu-board">
  {closed ? (
    <p>The kitchen is closed.</p>
  ) : (
    <>
      {courses.map((course) => (
        <section aria-label={course.title}>
          <h2>{course.title}</h2>
          <ul>
            {course.dishes.map((dish) => (
              <li>{dish.name}, {dish.price.toFixed(2)}{dish.vegetarian ? <span> (vegetarian)</span> : null}</li>
            ))}
          </ul>
        </section>
      ))}
    </>
  )}
</div>
