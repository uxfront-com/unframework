---
export interface OrderStatusProps {
  status: "pending" | "shipped" | "delivered" | "cancelled";
  carrier?: string;
  eta?: string;
}

interface Props extends OrderStatusProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { status, carrier, eta, class: className, style } = Astro.props;
---

<p class:list={["order-status", className]} style={style}>
  {status === "pending" ? "Waiting for payment." : status === "shipped" ? <><strong>Shipped</strong> with {carrier ?? "our courier"}, arriving {eta ?? "soon"}.</> : status === "delivered" ? <strong>Delivered</strong> : <em>Cancelled</em>}
</p>
