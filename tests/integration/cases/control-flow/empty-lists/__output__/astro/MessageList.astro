---
import type { HTMLAttributes } from "astro/types";

export interface InboxMessage {
  id: string;
  subject: string;
}

export interface MessageListProps {
  messages: InboxMessage[];
  archived?: InboxMessage[];
  emptyText?: string;
}

interface Props
  extends MessageListProps, Omit<HTMLAttributes<"section">, "messages" | "archived" | "emptyText"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  messages,
  archived = [],
  emptyText = "Nothing here yet.",
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
---

<section
  class:list={["message-list", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Messages"}
  style={style}
  {...attrs}
>
  <h2>Inbox</h2>
  <ul>
    {messages.map((message) => (
      <li>{message.subject}</li>
    ))}
  </ul>
  {messages.length === 0 ? (
    <p>{emptyText}</p>
  ) : null}
  <h2>Archive</h2>
  <ul>
    {archived.map((message) => (
      <li>{message.subject}</li>
    ))}
  </ul>
  {archived.length === 0 ? (
    <p>No archived messages.</p>
  ) : (
    <p>{archived.length} archived</p>
  )}
</section>
