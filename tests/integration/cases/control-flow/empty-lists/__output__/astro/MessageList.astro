---
export interface InboxMessage {
  id: string;
  subject: string;
}

export interface MessageListProps {
  messages: InboxMessage[];
  archived?: InboxMessage[];
  emptyText?: string;
}

type Props = MessageListProps;

const { messages, archived = [], emptyText = "Nothing here yet." } = Astro.props;
---

<section class="message-list" aria-label="Messages">
  <h2>Inbox</h2>
  <ul>
    {messages.map((message) => (
      <li>{message.subject}</li>
    ))}
  </ul>
  {messages.length === 0 ? (
    <p>{emptyText}</p>
  ) : null}
  <h2>Archive</h2>
  <ul>
    {archived.map((message) => (
      <li>{message.subject}</li>
    ))}
  </ul>
  {archived.length === 0 ? (
    <p>No archived messages.</p>
  ) : (
    <p>{archived.length} archived</p>
  )}
</section>
