---
export interface InboxMessage {
  id: string;
  subject: string;
}

export interface MessageListProps {
  messages: InboxMessage[];
  archived?: InboxMessage[];
  emptyText?: string;
}

interface Props extends MessageListProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  messages,
  archived = [],
  emptyText = "Nothing here yet.",
  class: className,
  style,
} = Astro.props;
---

<section class:list={["message-list", className]} aria-label="Messages" style={style}>
  <h2>Inbox</h2>
  <ul>
    {messages.map((message) => (
      <li>{message.subject}</li>
    ))}
  </ul>
  {messages.length === 0 ? (
    <p>{emptyText}</p>
  ) : null}
  <h2>Archive</h2>
  <ul>
    {archived.map((message) => (
      <li>{message.subject}</li>
    ))}
  </ul>
  {archived.length === 0 ? (
    <p>No archived messages.</p>
  ) : (
    <p>{archived.length} archived</p>
  )}
</section>
