---
export interface Contributor {
  login: string;
  name: string;
  commits: number;
}

export interface ContributorTableProps {
  caption: string;
  contributors: Contributor[];
}

interface Props extends ContributorTableProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { caption, contributors, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<table class:list={["contributors", className]} style={style} {...scopeAttributes(Astro.props)}>
  <caption>{caption}</caption>
  <thead>
    <tr>
      <th scope="col">Name</th>
      <th scope="col">Commits</th>
    </tr>
  </thead>
  <tbody>
    {contributors.map((contributor) => (
      <tr>
        <td>
          <a href={`https://example.com/people/${contributor.login}`}>{contributor.name}</a>
        </td>
        <td>{contributor.commits}</td>
      </tr>
    ))}
  </tbody>
</table>
