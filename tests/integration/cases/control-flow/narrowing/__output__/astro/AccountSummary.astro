---
interface Team {
  name: string;
}

interface Member {
  name: string;
  email: string;
  admin: boolean;
  team?: Team;
}

interface Seat {
  holder: string;
}

type Plan = { kind: "paid"; renews: string } | { kind: "trial"; daysLeft: number };

export interface AccountSummaryProps {
  loading: boolean;
  member?: Member;
  uptime?: number;
  storage: number | string;
  plan: Plan;
  seats: (Seat | null)[];
}

interface Props extends AccountSummaryProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { loading, member, uptime, storage, plan, seats, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<section
  class:list={["account-summary", className]}
  aria-label="Account"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  {loading ? (
    <p>Loading the account</p>
  ) : !member ? (
    <p>Signed out</p>
  ) : (
    <h2>{member.name}</h2>
  )}
  {member ? (
    <p>Signed in as {member.email}</p>
  ) : null}
  {member ? (
    <p>Role: {member.admin ? "administrator" : "member"}</p>
  ) : (
    <p>Role: guest</p>
  )}
  {!member ? (
    <p>No profile</p>
  ) : (
    <p>Profile of {member.name}</p>
  )}
  {member && member.team ? (
    <p>Team: {member.team.name}</p>
  ) : null}
  {uptime !== undefined ? (
    <p>Uptime {uptime.toFixed(1)}%</p>
  ) : null}
  {typeof storage === "number" ? (
    <p>Storage {storage.toFixed(1)} GB</p>
  ) : (
    <p>Storage {storage}</p>
  )}
  {plan.kind === "paid" ? (
    <p>Renews on {plan.renews}</p>
  ) : (
    <p>Trial ends in {plan.daysLeft} days</p>
  )}
  <ul aria-label="Seats">
    {seats.map((seat) => (
      <li>
        {seat ? <b>{seat.holder}</b> : "Vacant"}
      </li>
    ))}
  </ul>
</section>
