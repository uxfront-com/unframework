---
import type { HTMLAttributes } from "astro/types";

export type Source =
  | { kind: "link"; id: string; title: string; href: string }
  | { kind: "book"; id: string; title: string; note?: string };

export interface ReadingProps {
  sources: Source[];
}

interface Props extends ReadingProps, Omit<HTMLAttributes<"ul">, "sources"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { sources, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;
---

<ul
  class:list={["reading", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Reading list"}
  style={style}
  {...attrs}
>
  {sources.map((source, index) => (
    <li
      title={source.kind === "link" ? source.href : source.title}
    >{index + 1}. {source.title}{source.kind === "book" && source.note ? ` (${source.note.trim()})` : ""}{source.kind === "link" ? <button
      type="button"
    >{`Open ${source.title}`}</button> : null}</li>
  ))}
</ul>
