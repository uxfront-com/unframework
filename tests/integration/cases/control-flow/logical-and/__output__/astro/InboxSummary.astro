---
export interface InboxSummaryProps {
  folder: string;
  unread: number;
  flagged: number;
  signature: string;
}

interface Props extends InboxSummaryProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { folder, unread, flagged, signature, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<section
  class:list={["inbox-summary", className]}
  aria-label="Inbox summary"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <h2>{folder || "Inbox"}</h2>
  {unread ? (
    <p>{unread} unread</p>
  ) : null}
  {flagged ? (
    <p>{flagged} flagged</p>
  ) : null}
  {unread > 0 && flagged > 0 ? (
    <p>Some unread messages are flagged.</p>
  ) : null}
  {folder ? (
    <p>Filed under {folder}</p>
  ) : null}
  {signature ? (
    <p class="inbox-signature">{signature}</p>
  ) : null}
</section>
