---
import type { HTMLAttributes } from "astro/types";

export interface InboxSummaryProps {
  folder: string;
  unread: number;
  flagged: number;
  signature: string;
}

interface Props
  extends
    InboxSummaryProps,
    Omit<HTMLAttributes<"section">, "folder" | "unread" | "flagged" | "signature"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  folder,
  unread,
  flagged,
  signature,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
---

<section
  class:list={["inbox-summary", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Inbox summary"}
  style={style}
  {...attrs}
>
  <h2>{folder || "Inbox"}</h2>
  {unread ? (
    <p>{unread} unread</p>
  ) : null}
  {flagged ? (
    <p>{flagged} flagged</p>
  ) : null}
  {unread > 0 && flagged > 0 ? (
    <p>Some unread messages are flagged.</p>
  ) : null}
  {folder ? (
    <p>Filed under {folder}</p>
  ) : null}
  {signature ? (
    <p class="inbox-signature">{signature}</p>
  ) : null}
</section>
