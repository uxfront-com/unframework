---
interface LogLine {
  id: string;
  text: string;
}

export interface BuildLogProps {
  target: string;
  failed: boolean;
  lines?: LogLine[] | null;
  warnings?: string[];
}

interface Props extends BuildLogProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { target, failed, lines, warnings, class: className, style } = Astro.props;
---

<section class:list={["build-log", className]} aria-label="Build log" style={style}>
  <pre>$ make {target}{failed ? <strong> (failed)</strong> : null}
{(lines ?? []).map((line) => <code>{line.text}{"\n"}</code>)}</pre>
  <ul aria-label="Warnings">
    {(warnings ?? []).map((warning) => (
      <li>{warning}</li>
    ))}
  </ul>
</section>
