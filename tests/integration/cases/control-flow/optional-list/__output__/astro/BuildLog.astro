---
import type { HTMLAttributes } from "astro/types";

interface LogLine {
  id: string;
  text: string;
}

export interface BuildLogProps {
  target: string;
  failed: boolean;
  lines?: LogLine[] | null;
  warnings?: string[];
}

interface Props
  extends
    BuildLogProps,
    Omit<HTMLAttributes<"section">, "target" | "failed" | "lines" | "warnings"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  target,
  failed,
  lines,
  warnings,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
---

<section
  class:list={["build-log", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Build log"}
  style={style}
  {...attrs}
>
  <pre>$ make {target}{failed ? <strong> (failed)</strong> : null}
{(lines ?? []).map((line) => <code>{line.text}{"\n"}</code>)}</pre>
  <ul aria-label="Warnings">
    {(warnings ?? []).map((warning) => (
      <li>{warning}</li>
    ))}
  </ul>
</section>
