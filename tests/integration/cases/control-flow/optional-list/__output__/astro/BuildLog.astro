---
interface LogLine {
  id: string;
  text: string;
}

export interface BuildLogProps {
  target: string;
  failed: boolean;
  lines?: LogLine[] | null;
  warnings?: string[];
}

interface Props extends BuildLogProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { target, failed, lines, warnings, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<section
  class:list={["build-log", className]}
  aria-label="Build log"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <pre>$ make {target}{failed ? <strong> (failed)</strong> : null}
{(lines ?? []).map((line) => <code>{line.text}{"\n"}</code>)}</pre>
  <ul aria-label="Warnings">
    {(warnings ?? []).map((warning) => (
      <li>{warning}</li>
    ))}
  </ul>
</section>
