---
import type { HTMLAttributes } from "astro/types";
import "./Drawer.uf.tsx.css";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const shown = true as boolean;
const open = true as boolean;
---

<section
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Filters"}
  class:list={[className]}
  style={style}
  data-uf-54e3e959=""
  {...attrs}
>
  <button type="button" data-uf-54e3e959="">Drawer</button>
  <button type="button" data-uf-54e3e959="">Body</button>
  {shown ? (
    <>
      {open ? (
        <p class="body" data-uf-54e3e959="">Colour, size</p>
      ) : null}
    </>
  ) : null}
</section>
