---
import type { HTMLAttributes } from "astro/types";
import "./Menu.uf.tsx.css";

interface Props extends HTMLAttributes<"nav"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const open = true as boolean;
---

<nav
  class:list={["menu", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Account"}
  style={style}
  data-uf-e688a71a=""
  {...attrs}
>
  <button type="button" aria-expanded={open} data-uf-e688a71a="">Account</button>
  {open ? (
    <ul class="items" data-uf-e688a71a="">
      <li data-uf-e688a71a="">Profile</li>
      <li data-uf-e688a71a="">Sign out</li>
    </ul>
  ) : null}
</nav>
