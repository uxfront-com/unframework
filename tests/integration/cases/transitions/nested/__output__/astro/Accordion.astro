---
import type { HTMLAttributes } from "astro/types";
import "./Accordion.uf.tsx.css";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const open = true as boolean;
---

<section
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Shipping"}
  class:list={[className]}
  style={style}
  data-uf-357b6b1f=""
  {...attrs}
>
  <button type="button" aria-expanded={open} data-uf-357b6b1f="">Shipping</button>
  {open ? (
    <div class="panel" data-uf-357b6b1f="">
      <p class="note" data-uf-357b6b1f="">Ships in two days.</p>
    </div>
  ) : null}
</section>
