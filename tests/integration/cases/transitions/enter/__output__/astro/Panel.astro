---
import type { HTMLAttributes } from "astro/types";
import "./Panel.uf.tsx.css";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const open = false as boolean;
---

<section
  class:list={["panel", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Delivery"}
  style={style}
  data-uf-eab7eeb4=""
  {...attrs}
>
  <button type="button" aria-expanded={open} data-uf-eab7eeb4="">Details</button>
  {open ? (
    <p class="details" data-uf-eab7eeb4="">Ships in two days.</p>
  ) : null}
</section>
