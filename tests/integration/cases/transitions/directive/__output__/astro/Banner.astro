---
import type { HTMLAttributes } from "astro/types";
import "./Banner.uf.tsx.css";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const shown = true as boolean;
---

<section
  aria-label={"aria-label" in Astro.props ? ariaLabel : "News"}
  class:list={[className]}
  style={style}
  data-uf-53025c4a=""
  {...attrs}
>
  <button type="button" data-uf-53025c4a="">Dismiss</button>
  {shown ? (
    <p class="banner" data-uf-53025c4a="">New releases are out.</p>
  ) : null}
</section>
