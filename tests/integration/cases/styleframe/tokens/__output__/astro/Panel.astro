---
import type { HTMLAttributes } from "astro/types";
import "virtual:styleframe.css";
import "./Panel.uf.tsx.css";

interface Props extends Omit<HTMLAttributes<"section">, "text"> {
  text: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { text, class: className, style, ...attrs } = Astro.props;
---

<section class:list={["panel", className]} style={style} data-uf-b6be1fd3="" {...attrs}>
  <p class="body" data-uf-b6be1fd3="">{text}</p>
</section>
