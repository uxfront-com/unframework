---
import type { HTMLAttributes } from "astro/types";
import { button } from "virtual:styleframe";
import "virtual:styleframe.css";

interface Props extends Omit<HTMLAttributes<"button">, "label" | "size" | "tone"> {
  label: string;
  size?: "sm" | "lg";
  tone?: "neutral" | "primary";
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, size, tone, class: className, style, type, ...attrs } = Astro.props;
---

<button
  type={"type" in Astro.props ? type : "button"}
  class:list={[button({ size, tone }), className]}
  style={style}
  {...attrs}
>{label}</button>
