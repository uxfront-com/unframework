---
import type { HTMLAttributes } from "astro/types";
import { badge } from "virtual:styleframe";
import "virtual:styleframe.css";

interface Props extends Omit<HTMLAttributes<"span">, "label"> {
  label: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, class: className, style, ...attrs } = Astro.props;
---

<span class:list={[badge(), className]} style={style} {...attrs}>{label}</span>
