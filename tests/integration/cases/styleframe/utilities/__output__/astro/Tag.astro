---
import type { HTMLAttributes } from "astro/types";
import "virtual:styleframe.css";

interface Props extends Omit<HTMLAttributes<"span">, "label"> {
  label: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, class: className, style, ...attrs } = Astro.props;
---

<span
  class:list={["_padding:lg _background-color:primary _color:on-primary _border-radius:[4px]", className]}
  style={style}
  {...attrs}
>{label}</span>
