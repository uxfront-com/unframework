---
import type { HTMLAttributes } from "astro/types";

export interface ArticleProps {
  title: string;
  body: string;
}

interface Props extends ArticleProps, Omit<HTMLAttributes<"article">, "title" | "body"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, body, class: className, style, ...attrs } = Astro.props;
---

<article class:list={["article", className]} style={style} {...attrs}>
  <h2>{title}</h2>
  <div class="body" set:html={body}></div>
  <footer set:html={"<small>Filed under <em>News</em></small>"}></footer>
</article>
