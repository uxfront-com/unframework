---
export interface ArticleProps {
  title: string;
  body: string;
}

interface Props extends ArticleProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, body, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<article class:list={["article", className]} style={style} {...scopeAttributes(Astro.props)}>
  <h2>{title}</h2>
  <div class="body" set:html={body}></div>
  <footer set:html={"<small>Filed under <em>News</em></small>"}></footer>
</article>
