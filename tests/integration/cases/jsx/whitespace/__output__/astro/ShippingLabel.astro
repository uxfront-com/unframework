---
import type { HTMLAttributes } from "astro/types";

export interface ShippingLabelProps {
  recipient: string;
  street: string;
  city: string;
  postcode: string;
}

interface Props
  extends
    ShippingLabelProps,
    Omit<HTMLAttributes<"article">, "recipient" | "street" | "city" | "postcode"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  recipient,
  street,
  city,
  postcode,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
---

<article
  class:list={["shipping-label", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Shipping label"}
  style={style}
  {...attrs}
>
  <p><strong>To:</strong> {recipient}</p>
  <p>
    <span class="shipping-label-city">{city}</span> <span
      class="shipping-label-postcode"
    >{postcode}</span> <span class="shipping-label-country">United Kingdom</span>
  </p>
  <p>  Handle with care </p>
  <pre>{recipient}
{street}
{city + "  " + postcode}</pre>
  <pre>Parcel:	1 of 2
Weight:	2.5 kg</pre>
  <p>Sent by <em>Unframework Ltd</em>{", on two\nlines."}</p>
</article>
