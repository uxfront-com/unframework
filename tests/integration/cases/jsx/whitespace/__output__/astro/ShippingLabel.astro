---
export interface ShippingLabelProps {
  recipient: string;
  street: string;
  city: string;
  postcode: string;
}

interface Props extends ShippingLabelProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { recipient, street, city, postcode, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<article
  class:list={["shipping-label", className]}
  aria-label="Shipping label"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <p><strong>To:</strong> {recipient}</p>
  <p>
    <span class="shipping-label-city">{city}</span> <span
      class="shipping-label-postcode"
    >{postcode}</span> <span class="shipping-label-country">United Kingdom</span>
  </p>
  <p>  Handle with care </p>
  <pre>{recipient}
{street}
{city + "  " + postcode}</pre>
  <pre>Parcel:	1 of 2
Weight:	2.5 kg</pre>
  <p>Sent by <em>Unframework Ltd</em>{", on two\nlines."}</p>
</article>
