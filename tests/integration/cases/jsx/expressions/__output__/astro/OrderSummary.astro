---
import type { HTMLAttributes } from "astro/types";

export interface OrderSummaryProps {
  customer: string;
  orderNumber: number;
  unitPrice: number;
  quantity: number;
  discount: number;
  coupon?: string;
}

interface Props
  extends
    OrderSummaryProps,
    Omit<
      HTMLAttributes<"section">,
      "customer" | "orderNumber" | "unitPrice" | "quantity" | "discount" | "coupon"
    > {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  customer,
  orderNumber,
  unitPrice,
  quantity,
  discount,
  coupon,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
---

<section
  class:list={["order-summary", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Order summary"}
  style={style}
  {...attrs}
>
  <h2>Order {String(orderNumber).padStart(6, "0")}</h2>
  <p>Customer: {customer.trim().toUpperCase()}</p>
  <p>{`${quantity} item${quantity === 1 ? "" : "s"} at ${unitPrice.toFixed(2)} each`}</p>
  <p>Subtotal: {(unitPrice * quantity).toFixed(2)}</p>
  <p>Discount: {Math.min(Math.max(discount, 0), 50)}%</p>
  <p>Total: {(unitPrice * quantity * (1 - Math.min(Math.max(discount, 0), 50) / 100)).toFixed(2)}</p>
  <p>{quantity > 10 ? "Bulk order" : "Standard order"}, {coupon ? "coupon applied" : "no coupon"}</p>
  <p>Points earned: {Math.round(unitPrice * quantity) % 100}</p>
</section>
