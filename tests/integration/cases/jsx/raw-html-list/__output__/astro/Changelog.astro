---
import type { HTMLAttributes } from "astro/types";

export interface Entry {
  id: number;
  html: string;
}

export interface ChangelogProps {
  entries: Entry[];
}

interface Props extends ChangelogProps, Omit<HTMLAttributes<"ul">, "entries"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { entries, class: className, style, ...attrs } = Astro.props;
---

<ul class:list={["changelog", className]} style={style} {...attrs}>
  {entries.map((entry) => (
    <li set:html={entry.html}></li>
  ))}
</ul>
