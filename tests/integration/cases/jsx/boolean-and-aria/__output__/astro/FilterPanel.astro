---
export interface FilterPanelProps {
  heading: string;
  hint: string;
  category: string;
  expanded: boolean;
  inStockOnly: boolean;
  locked: boolean;
  mandatory: boolean;
  loading: boolean;
  invalid?: boolean;
  current?: "page" | "step";
}

type Props = FilterPanelProps;

const {
  heading,
  hint,
  category,
  expanded,
  inStockOnly,
  locked,
  mandatory,
  loading,
  invalid,
  current,
} = Astro.props;
---

<section class="filter-panel" aria-label={heading} data-category={category} data-layout="stacked">
  <button
    type="button"
    aria-expanded={expanded}
    aria-describedby="filter-panel-hint"
  >Price filters</button>
  <p id="filter-panel-hint">{hint}</p>
  <details open={expanded}>
    <summary>Price range</summary>
    <label>Minimum price<input
      type="number"
      name="min-price"
      required={mandatory}
      disabled={locked}
      aria-invalid={invalid}
    /></label>
  </details>
  <button type="button" aria-pressed={inStockOnly} disabled={locked}>In stock only</button>
  <nav aria-label="Filter steps">
    <a href="#filters" aria-current={current}>Filters</a>
  </nav>
  <p
    role="status"
    aria-live="polite"
    aria-busy={loading}
  >{loading ? "Loading results" : "Results ready"}</p>
</section>
