---
export interface GlossaryProps {
  terms: string[];
  definitions: string[];
}

interface Props extends GlossaryProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { terms, definitions, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const index = 0 as number;
const definition = definitions[index] ?? "";
---

<section
  class:list={["glossary", className]}
  aria-label="Glossary"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <h2>{terms[index]}</h2>
  <div class="definition" set:html={definition}></div>
  <button type="button">Next term</button>
</section>
