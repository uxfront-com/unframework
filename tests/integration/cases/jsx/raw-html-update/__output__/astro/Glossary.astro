---
import type { HTMLAttributes } from "astro/types";

export interface GlossaryProps {
  terms: string[];
  definitions: string[];
}

interface Props extends GlossaryProps, Omit<HTMLAttributes<"section">, "terms" | "definitions"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  terms,
  definitions,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;

const index = 0 as number;
const definition = definitions[index] ?? "";
---

<section
  class:list={["glossary", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Glossary"}
  style={style}
  {...attrs}
>
  <h2>{terms[index]}</h2>
  <div class="definition" set:html={definition}></div>
  <button type="button">Next term</button>
</section>
