---
export interface TemplateTipProps {
  example: string;
  note: string;
  path: string;
}

type Props = TemplateTipProps;

const { example, note, path } = Astro.props;
---

<figure class="template-tip">
  <figcaption
    title="Vue {{ name }}, Svelte {#if ok}, Angular @if (ok) &amp; JSX {name}"
  >Template syntax &amp; escaping</figcaption>
  <pre><code>{example}</code></pre>
  <p
    data-sample="<b> &quot;double&quot; 'single' C:\temp"
  >Static: &lt;b&gt;not bold&lt;/b&gt;, &#123;&#123; name &#125;&#125;, @if (ok) &#123; &#125;</p>
  <p>Literal: &#123;&#123; name &#125;&#125; &lt;i&gt;not italic&lt;/i&gt; &#123;#each items&#125; @for "quoted" C:\temp café</p>
  <p title="Say &quot;hi&quot; &amp; wave">Quoted attribute</p>
  <p title={note} data-path={path}>Bound: {note} in {path + "\\index.ts"}</p>
  <p>Mustache: {"{{ " + path + " }}"}</p>
  <p>Done &amp;check;</p>
</figure>
