---
import type { HTMLAttributes } from "astro/types";
import { chip } from "virtual:fixture-engine";
import "virtual:fixture-engine.css";

interface Props extends Omit<HTMLAttributes<"span">, "label" | "tone"> {
  label: string;
  tone?: "plain" | "accent";
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, tone, class: className, style, ...attrs } = Astro.props;
---

<span class:list={[chip(tone), className]} style={style} {...attrs}>{label}</span>
