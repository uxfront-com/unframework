{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Focus chained' })",
      "dom": [
        "<section aria-label=\"Page\">",
        "  <button aria-label=\"Direct\" class=\"base\" data-testid=\"direct\" id=\"direct\" title=\"Go\">",
        "    \"Direct\"",
        "  </button>",
        "  <button aria-label=\"Chained\" class=\"base primary\" data-testid=\"chained\" id=\"chained\" title=\"Base\" uf:focused=\"\">",
        "    \"Chained\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Toggle\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Focus direct\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Focus chained\"",
        "  </button>",
        "  <ol aria-label=\"Log\"></ol>",
        "</section>"
      ],
      "aria": [
        "- region \"Page\":",
        "  - button \"Direct\"",
        "  - button \"Chained\"",
        "  - button \"Toggle\"",
        "  - button \"Focus direct\"",
        "  - button \"Focus chained\"",
        "  - list \"Log\""
      ],
      "events": {}
    }
  ]
}
