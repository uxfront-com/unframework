---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"button">, "label"> {
  label: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, class: className, style, type, ...attrs } = Astro.props;
---

<button
  type={"type" in Astro.props ? type : "button"}
  class:list={["chip", className]}
  style={style}
  {...attrs}
>{label}</button>
