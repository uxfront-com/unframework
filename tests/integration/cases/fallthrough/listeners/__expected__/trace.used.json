{
  "version": 1,
  "steps": [
    {
      "action": "keyboard \"a\"",
      "dom": [
        "<section aria-label=\"Picker\">",
        "  <button class=\"chip\" type=\"button\" uf:focused=\"\">",
        "    \"Ada\"",
        "  </button>",
        "  <ol aria-label=\"Log\">",
        "    <li>",
        "      \"focus on button\"",
        "    </li>",
        "    <li>",
        "      \"keydown a on button\"",
        "    </li>",
        "  </ol>",
        "</section>"
      ],
      "aria": [
        "- region \"Picker\":",
        "  - button \"Ada\"",
        "  - list \"Log\":",
        "    - listitem: focus on button",
        "    - listitem: keydown a on button"
      ],
      "events": {}
    },
    {
      "action": "click getByRole('button', { name: 'Ada' })",
      "dom": [
        "<section aria-label=\"Picker\">",
        "  <button class=\"chip\" type=\"button\" uf:focused=\"\">",
        "    \"Ada\"",
        "  </button>",
        "  <ol aria-label=\"Log\">",
        "    <li>",
        "      \"focus on button\"",
        "    </li>",
        "    <li>",
        "      \"keydown a on button\"",
        "    </li>",
        "    <li>",
        "      \"pick Ada\"",
        "    </li>",
        "    <li>",
        "      \"click on button\"",
        "    </li>",
        "  </ol>",
        "</section>"
      ],
      "aria": [
        "- region \"Picker\":",
        "  - button \"Ada\"",
        "  - list \"Log\":",
        "    - listitem: focus on button",
        "    - listitem: keydown a on button",
        "    - listitem: pick Ada",
        "    - listitem: click on button"
      ],
      "events": {}
    }
  ]
}
