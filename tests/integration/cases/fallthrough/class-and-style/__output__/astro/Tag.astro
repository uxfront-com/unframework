---
interface Props {
  label: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, class: className, style } = Astro.props;
---

<span
  class:list={["tag", className]}
  style={{ padding: "2px 6px", color: "rgb(30, 30, 30)", ...style }}
>{label}</span>
