{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Toggle' })",
      "dom": [
        "<div class=\"tags\">",
        "  <span class=\"tag\" style=\"color: rgb(30, 30, 30); padding: 2px 6px;\">",
        "    \"plain\"",
        "  </span>",
        "  <span class=\"tag wide\" style=\"color: rgb(30, 30, 30); margin-left: 8px; padding: 2px 6px;\">",
        "    \"wide\"",
        "  </span>",
        "  <span class=\"active picked tag\" style=\"color: rgb(200, 0, 0); padding: 2px 6px;\">",
        "    \"toggled\"",
        "  </span>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Toggle\"",
        "  </button>",
        "</div>"
      ],
      "aria": [
        "- text: plainwidetoggled",
        "- button \"Toggle\""
      ],
      "events": {}
    }
  ]
}
