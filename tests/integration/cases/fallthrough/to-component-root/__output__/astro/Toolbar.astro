---
import Primary from "./Primary.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, role, "aria-label": ariaLabel, ...attrs } = Astro.props;
---

<div
  role={"role" in Astro.props ? role : "toolbar"}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Actions"}
  class:list={[className]}
  style={style}
  {...attrs}
>
  <Primary text="Save" class="wide" />
</div>
