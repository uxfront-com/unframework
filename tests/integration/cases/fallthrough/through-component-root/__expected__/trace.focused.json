{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Focus save' })",
      "dom": [
        "<div aria-label=\"Actions\" role=\"toolbar\">",
        "  <button aria-label=\"Save draft\" class=\"pressable save\" id=\"save\" type=\"button\" uf:focused=\"\">",
        "    \"Save\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Focus save\"",
        "  </button>",
        "  <p>",
        "    \"Clicks: 0\"",
        "  </p>",
        "</div>"
      ],
      "aria": [
        "- toolbar \"Actions\":",
        "  - button \"Save draft\": Save",
        "  - button \"Focus save\"",
        "  - paragraph: \"Clicks: 0\""
      ],
      "events": {}
    }
  ]
}
