---
import { scopeAttributes } from "./_unframework/scopeAttributes";

interface Props {
  busy: boolean;
  text: string;
}

const { busy, text } = Astro.props;
---

{busy ? (
  <span class="badge" role="status" {...scopeAttributes(Astro.props)}>Saving</span>
) : (
  <button type="button" class="badge" {...scopeAttributes(Astro.props)}>{text}</button>
)}
