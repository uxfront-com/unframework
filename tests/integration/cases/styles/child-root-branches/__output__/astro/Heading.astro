---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"h2"> & HTMLAttributes<"h3">, "big" | "text"> {
  big: boolean;
  text: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { big, text, class: className, style, ...attrs } = Astro.props;

const Tag = big ? "h2" : "h3";
---

<Tag class:list={["heading", className]} style={style} {...attrs}>{text}</Tag>
