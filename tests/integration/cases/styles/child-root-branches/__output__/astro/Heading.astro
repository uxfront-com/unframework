---
import { scopeAttributes } from "./_unframework/scopeAttributes";

interface Props {
  big: boolean;
  text: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { big, text, class: className, style } = Astro.props;

const Tag = big ? "h2" : "h3";
---

<Tag
  class:list={["heading", className]}
  style={style}
  {...scopeAttributes(Astro.props)}
>{text}</Tag>
