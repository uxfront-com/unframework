---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"button">, "text"> {
  text: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { text, class: className, style, type, ...attrs } = Astro.props;
---

<button
  type={"type" in Astro.props ? type : "button"}
  class:list={["button", className]}
  style={style}
  {...attrs}
><span class="icon" aria-hidden="true">+</span>{text}</button>
