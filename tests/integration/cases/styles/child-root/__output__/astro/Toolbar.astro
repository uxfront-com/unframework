---
import Button from "./Button.astro";
import type { HTMLAttributes } from "astro/types";
import "./Toolbar.uf.tsx.css";

interface Props extends HTMLAttributes<"div"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, role, "aria-label": ariaLabel, ...attrs } = Astro.props;
---

<div
  role={"role" in Astro.props ? role : "toolbar"}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Actions"}
  class:list={["toolbar", className]}
  style={style}
  data-uf-a33d603f=""
  {...attrs}
>
  <Button text="Save" data-uf-a33d603f="" />
  <Button text="Cancel" data-uf-a33d603f="" />
</div>
