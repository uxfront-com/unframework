---
import Amber from "./Amber.astro";
import Blue from "./Blue.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, ...attrs } = Astro.props;

const items = [
  { label: "Warm", warm: true },
  { label: "Cool", warm: false },
];
---

<section class:list={[className]} style={style} {...attrs}>
  <Blue>
    <p class="caption" data-uf-721c504a-s="">In blue</p>
  </Blue>
  <Amber>
    <p class="caption" data-uf-c97301b3-s="">In amber</p>
  </Amber>
  {items.map((item) => (
    <div>
      {(() => { const Tag = item.warm ? Amber : Blue; return (
        <Tag>
          <p class="caption" data-uf-c97301b3-s="" data-uf-721c504a-s="">{item.label}</p>
        </Tag>
      ); })()}
    </div>
  ))}
</section>
