---
import Amber from "./Amber.astro";
import Blue from "./Blue.astro";

interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const items = [
  { label: "Warm", warm: true },
  { label: "Cool", warm: false },
];
---

<section class:list={[className]} style={style} {...scopeAttributes(Astro.props)}>
  <Blue>
    <p class="caption" data-uf-721c504a-s="">In blue</p>
  </Blue>
  <Amber>
    <p class="caption" data-uf-c97301b3-s="">In amber</p>
  </Amber>
  {items.map((item) => (
    <div>
      {(() => { const Tag = item.warm ? Amber : Blue; return (
        <Tag>
          <p class="caption" data-uf-c97301b3-s="" data-uf-721c504a-s="">{item.label}</p>
        </Tag>
      ); })()}
    </div>
  ))}
</section>
