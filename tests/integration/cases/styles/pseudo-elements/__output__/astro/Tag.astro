---
import type { HTMLAttributes } from "astro/types";
import "./Tag.uf.tsx.css";

interface Props extends Omit<HTMLAttributes<"span">, "name"> {
  name: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { name, class: className, style, ...attrs } = Astro.props;
---

<span class:list={["tag", className]} style={style} data-uf-ef5e671c="" {...attrs}>{name}</span>
