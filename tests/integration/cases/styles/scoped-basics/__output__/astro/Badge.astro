---
import type { HTMLAttributes } from "astro/types";
import "./Badge.uf.tsx.css";

interface Props extends Omit<HTMLAttributes<"span">, "label" | "count"> {
  label: string;
  count: number;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, count, class: className, style, ...attrs } = Astro.props;
---

<span class:list={["badge", className]} style={style} data-uf-d9cef2e7="" {...attrs}>
  <span class="label" data-uf-d9cef2e7="">{label}</span>
  <span class="count" data-uf-d9cef2e7="">{count}</span>
</span>
