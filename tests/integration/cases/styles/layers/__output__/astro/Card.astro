---
import type { HTMLAttributes } from "astro/types";
import "./Card.uf.tsx.css";

interface Props extends Omit<HTMLAttributes<"section">, "title"> {
  title: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, class: className, style, ...attrs } = Astro.props;
---

<section class:list={["card", className]} style={style} data-uf-bb60e985="" {...attrs}>
  <h2 class="title" data-uf-bb60e985="">{title}</h2>
</section>
