---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"p">, "text"> {
  text: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { text, class: className, style, ...attrs } = Astro.props;
---

<p
  class:list={["hint", className]}
  style={style}
  {...attrs}
>Tip: <span class="uf-highlight">{text}</span></p>
