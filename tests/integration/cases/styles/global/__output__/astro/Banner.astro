---
import Hint from "./Hint.astro";
import type { HTMLAttributes } from "astro/types";
import "./Banner.uf.tsx.css";

interface Props extends Omit<HTMLAttributes<"div">, "tip"> {
  tip: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { tip, class: className, style, ...attrs } = Astro.props;
---

<div class:list={["banner", className]} style={style} data-uf-e25060c2="" {...attrs}>
  <Hint text={tip} data-uf-e25060c2="" />
</div>
