---
import type { HTMLAttributes } from "astro/types";
import "./Panel.uf.tsx.css";

interface Props extends Omit<HTMLAttributes<"aside">, "text"> {
  text: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { text, class: className, style, ...attrs } = Astro.props;
---

<aside class:list={["panel", className]} style={style} data-uf-48dda3f4="" {...attrs}>
  <p class="text" data-uf-48dda3f4="">{text}</p>
</aside>
