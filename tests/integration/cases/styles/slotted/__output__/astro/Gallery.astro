---
import Frame from "./Frame.astro";
import Mat from "./Mat.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "matted"> {
  matted?: boolean;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { matted = true, class: className, style, ...attrs } = Astro.props;

const Tag = matted ? Mat : Frame;
---

<section class:list={[className]} style={style} {...attrs}>
  <Frame>
    <p class="caption" data-uf-9dc516fd-s="">A quiet harbour</p>
  </Frame>
  <Frame label={({ text }) => <p class="caption" data-uf-9dc516fd-s="">{text}</p>} />
  <Tag>
    <p class="caption" data-uf-09929c4a-s="" data-uf-9dc516fd-s="">A matted print</p>
  </Tag>
  <p class="caption">Outside the frame</p>
</section>
