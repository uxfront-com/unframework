---
import type { HTMLAttributes } from "astro/types";
import "./Frame.uf.tsx.css";

interface Props extends Omit<HTMLAttributes<"figure">, "label"> {
  label?: (props: { text: string }) => unknown;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, class: className, style, ...attrs } = Astro.props;
---

<figure
  class:list={["frame", className]}
  style={style}
  data-uf-9dc516fd=""
  {...attrs}
><slot />{label?.({ text: "Harbour at dusk" })}</figure>
