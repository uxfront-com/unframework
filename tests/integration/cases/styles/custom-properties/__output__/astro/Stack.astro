---
import "./Stack.uf.tsx.css";

interface Props {
  gap: string;
  accent: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { gap, accent, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<ul
  class:list={["stack", className]}
  style={{ "--gap": gap, "--accent": accent, ...style }}
  data-uf-e3a22111=""
  {...scopeAttributes(Astro.props)}
>
  <li class="item" data-uf-e3a22111="">One</li>
  <li class="item" data-uf-e3a22111="">Two</li>
  <li class="item" data-uf-e3a22111="">Three</li>
</ul>
