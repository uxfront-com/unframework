---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "text"> {
  text: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { text, class: className, style, ...attrs } = Astro.props;
---

<div class:list={["note-box", className]} style={style} {...attrs}>
  <p class="note">{text}</p>
</div>
