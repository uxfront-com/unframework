---
import Note from "./Note.astro";
import type { HTMLAttributes } from "astro/types";
import "./Article.uf.tsx.css";

interface Props extends Omit<HTMLAttributes<"article">, "title" | "note"> {
  title: string;
  note: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, note, class: className, style, ...attrs } = Astro.props;
---

<article class:list={["article", className]} style={style} data-uf-15946226="" {...attrs}>
  <h2 class="title" data-uf-15946226="">{title}</h2>
  <Note text={note} data-uf-15946226="" />
</article>
