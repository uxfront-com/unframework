        {
          "specifier": "./Progress.css",
          "source": "/* Renamed with the scope id, as the `animation` that names it is. */\n@keyframes arrive {\n  from {\n    background-color: rgb(229, 231, 235);\n  }\n\n  to {\n    background-color: rgb(37, 99, 235);\n  }\n}\n\n.progress {\n  display: flex;\n  align-items: center;\n  column-gap: 8px;\n}\n\n/* The browser projects run every animation in no time, so `forwards` keeps the last frame. */\n.dot {\n  display: block;\n  width: 16px;\n  height: 16px;\n  border-radius: 8px;\n  animation: arrive 1s ease-out forwards;\n}\n",
