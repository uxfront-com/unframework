---
import type { HTMLAttributes } from "astro/types";
import "./Progress.uf.tsx.css";

interface Props extends Omit<HTMLAttributes<"div">, "label"> {
  label: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, class: className, style, ...attrs } = Astro.props;
---

<div class:list={["progress", className]} style={style} data-uf-0738d8af="" {...attrs}>
  <span class="dot" data-uf-0738d8af=""></span>
  <span data-uf-0738d8af="">{label}</span>
</div>
