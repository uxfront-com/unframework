---
import type { HTMLAttributes } from "astro/types";

export interface InvoiceTotalProps {
  quantity: number;
}

interface Props extends InvoiceTotalProps, Omit<HTMLAttributes<"div">, "quantity"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { quantity, class: className, style, ...attrs } = Astro.props;

const refunded = 0 as number;

function getTotal() {
  const units = quantity - refunded;
  if (units < 0) {
    throw new Error("The total is negative");
  }
  return units * 5;
}

const total = getTotal();
---

<div class:list={[className]} style={style} {...attrs}>
  <output>{`${total} after ${refunded} refunded`}</output>
  <button type="button">Refund</button>
</div>
