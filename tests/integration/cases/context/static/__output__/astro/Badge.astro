---
import type { ThemeKey } from "./ThemeProvider.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"span">, "text"> {
  text: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { text, class: className, style, ...attrs } = Astro.props;

const theme = undefined as ThemeKey | undefined;
---

<span
  class:list={["badge", theme?.accent, className]}
  style={style}
  {...attrs}
>{text} in {theme?.label ?? "no theme"}</span>
