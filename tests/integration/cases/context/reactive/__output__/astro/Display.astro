---
import type { CountKey } from "./Counter.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"output"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, ...attrs } = Astro.props;

const none = 0 as number;
const count = none as CountKey;
---

<output class:list={[className]} style={style} {...attrs}>Count: {count}</output>
