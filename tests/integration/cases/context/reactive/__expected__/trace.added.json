{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Add one' })",
      "dom": [
        "<section aria-label=\"Counter\">",
        "  <output>",
        "    \"Count: 2\"",
        "  </output>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Add one\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Counter\":",
        "  - status: \"Count: 2\"",
        "  - button \"Add one\""
      ],
      "events": {}
    }
  ]
}
