---
import Level from "./Level.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "title"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, ...attrs } = Astro.props;
---

<Level title="Book" class:list={[className]} style={style} {...attrs}>
  <Level title="Part">
    <Level title="Chapter" />
  </Level>
  <Level title="Appendix" />
</Level>
