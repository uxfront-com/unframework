---
import type { HTMLAttributes } from "astro/types";

export type DepthKey = number;

interface Props extends Omit<HTMLAttributes<"section">, "title"> {
  title: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const depth = 0 as DepthKey;
---

<section
  aria-label={"aria-label" in Astro.props ? ariaLabel : title}
  class:list={[className]}
  style={style}
  {...attrs}
>
  <h2>{title} at depth {depth}</h2>
  <slot />
</section>
