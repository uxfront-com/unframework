---
export type DepthKey = number;

interface Props {
  title: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, class: className, style } = Astro.props;

const depth = 0 as DepthKey;
---

<section aria-label={title} class:list={[className]} style={style}>
  <h2>{title} at depth {depth}</h2>
  <slot />
</section>
