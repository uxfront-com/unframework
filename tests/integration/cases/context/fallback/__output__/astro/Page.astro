---
import Greeting from "./Greeting.astro";
import LocaleProvider from "./LocaleProvider.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"main"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, ...attrs } = Astro.props;
---

<main class:list={[className]} style={style} {...attrs}>
  <Greeting name="Ada" />
  <LocaleProvider locale="pt">
    <Greeting name="Inês" />
  </LocaleProvider>
</main>
