---
import type { LocaleKey } from "./LocaleProvider.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"p">, "name"> {
  name: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { name, class: className, style, ...attrs } = Astro.props;

const locale = "en" as LocaleKey;
---

<p
  class:list={[className]}
  style={style}
  {...attrs}
>{locale === "pt" ? "Olá" : "Hello"}, {name} ({locale})</p>
