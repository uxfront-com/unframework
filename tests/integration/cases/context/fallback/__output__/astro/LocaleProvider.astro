---
import type { HTMLAttributes } from "astro/types";

export type LocaleKey = string;

interface Props extends Omit<HTMLAttributes<"div">, "locale"> {
  locale: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { locale, class: className, style, lang, ...attrs } = Astro.props;
---

<div lang={"lang" in Astro.props ? lang : locale} class:list={[className]} style={style} {...attrs}>
  <slot />
</div>
