---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"a">, "href" | "label"> {
  href: string;
  label?: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { href, label, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;
---

<a
  href={href}
  aria-label={"aria-label" in Astro.props ? ariaLabel : label}
  class:list={[className]}
  style={style}
  {...attrs}
>
  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
    <path d="M2 8h10M8 4l4 4-4 4" />
  </svg>
</a>
