---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"button">, "label"> {
  label?: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, class: className, style, type, "aria-label": ariaLabel, ...attrs } = Astro.props;

if (import.meta.env.DEV) {
  if (!label) console.warn("IconButton has no accessible name: pass it a `label`.");
}
---

<button
  type={"type" in Astro.props ? type : "button"}
  aria-label={"aria-label" in Astro.props ? ariaLabel : label}
  class:list={[className]}
  style={style}
  {...attrs}
>
  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
    <path d="M8 1l2 5h5l-4 3 2 6-5-4-5 4 2-6-4-3h5z" />
  </svg>
</button>
