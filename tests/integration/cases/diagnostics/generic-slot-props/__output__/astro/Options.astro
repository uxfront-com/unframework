---
import type { HTMLAttributes } from "astro/types";

interface Props<T extends { value: string }> extends Omit<
  HTMLAttributes<"ul">,
  "options" | "option"
> {
  options: T[];
  option?: (props: { option: T }) => unknown;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { options, option: option_1, class: className, style, ...attrs } = Astro.props;
---

<ul class:list={[className]} style={style} {...attrs}>
  {options.map((option) => (
    <li>{option_1?.({ option })}</li>
  ))}
</ul>
