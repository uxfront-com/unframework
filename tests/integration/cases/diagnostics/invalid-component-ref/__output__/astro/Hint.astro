---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"small">, "text"> {
  text: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { text, class: className, style, ...attrs } = Astro.props;
---

<small class:list={["hint", className]} style={style} {...attrs}>{text}</small>
