---
import type { HTMLAttributes } from "astro/types";

export type Tone = "info" | "warning";

interface Props extends Omit<HTMLAttributes<"span">, "tone"> {
  tone: Tone;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { tone, class: className, style, ...attrs } = Astro.props;
---

<span class:list={["tag", tone, className]} style={style} {...attrs}>{tone}</span>
