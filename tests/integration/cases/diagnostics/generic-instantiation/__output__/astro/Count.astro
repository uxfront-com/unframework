---
import type { HTMLAttributes } from "astro/types";

interface Fruit {
  id: string;
  name: string;
  children: Fruit[];
}

interface Props extends Omit<HTMLAttributes<"p">, "items"> {
  items: Fruit[];
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { items, class: className, style, ...attrs } = Astro.props;
---

<p class:list={[className]} style={style} {...attrs}>{items.length} fruits</p>
