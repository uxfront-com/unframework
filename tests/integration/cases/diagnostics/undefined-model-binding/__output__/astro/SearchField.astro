---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"input">, "query"> {
  query?: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { query, class: className, style, type, "aria-label": ariaLabel, ...attrs } = Astro.props;
---

<input
  type={"type" in Astro.props ? type : "search"}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Search"}
  value={query}
  class:list={[className]}
  style={style}
  {...attrs}
/>
