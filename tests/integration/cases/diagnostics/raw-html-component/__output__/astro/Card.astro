---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "heading"> {
  heading: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { heading, class: className, style, ...attrs } = Astro.props;
---

<section class:list={["card", className]} style={style} {...attrs}>
  <h2>{heading}</h2>
</section>
