---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"button">, "picked"> {
  picked?: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { picked = "", class: className, style, type, ...attrs } = Astro.props;
---

<button
  type={"type" in Astro.props ? type : "button"}
  class:list={[className]}
  style={style}
  {...attrs}
>Yes ({picked})</button>
