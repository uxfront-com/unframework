---
import Card from "./Card.astro";
import Tip from "./Tip.astro";
import type { HTMLAttributes } from "astro/types";

interface Row {
  id: number;
  label: string;
}

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const rows = [
  { id: 1, label: "Alpha" },
  { id: 2, label: "Beta" },
  { id: 3, label: "Gamma" },
] as Row[];
---

<section
  class:list={["board", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Board"}
  style={style}
  {...attrs}
>
  <button type="button">Reverse tips</button>
  <button type="button">Show late</button>
  {rows.map((row) => (
    <Tip label={row.label} />
  ))}
  <Card></Card>
</section>
