{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Toggle card' })",
      "dom": [
        "<section aria-label=\"Board\" class=\"board\">",
        "  <button type=\"button\">",
        "    \"Reverse tips\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Show late\"",
        "  </button>",
        "  <div class=\"card\">",
        "    <button type=\"button\" uf:focused=\"\">",
        "      \"Toggle card\"",
        "    </button>",
        "  </div>",
        "</section>",
        "<uf:teleported>",
        "  <p class=\"tip\" data-teleported=\"true\" role=\"note\">",
        "    \"Alpha tip\"",
        "  </p>",
        "</uf:teleported>",
        "<uf:teleported>",
        "  <p class=\"tip\" data-teleported=\"true\" role=\"note\">",
        "    \"Beta tip\"",
        "  </p>",
        "</uf:teleported>",
        "<uf:teleported>",
        "  <p class=\"tip\" data-teleported=\"true\" role=\"note\">",
        "    \"Gamma tip\"",
        "  </p>",
        "</uf:teleported>"
      ],
      "aria": [
        "- region \"Board\":",
        "  - button \"Reverse tips\"",
        "  - button \"Show late\"",
        "  - button \"Toggle card\"",
        "- note: Alpha tip",
        "- note: Beta tip",
        "- note: Gamma tip"
      ],
      "events": {}
    }
  ]
}
