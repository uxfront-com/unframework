---
import type { HTMLAttributes } from "astro/types";

export interface FilesProps {
  file: string;
}

interface Props extends FilesProps, Omit<HTMLAttributes<"section">, "file"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { file, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;
---

<section
  class:list={["files", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Files"}
  style={style}
  {...attrs}
>
  <p>{file}</p>
  <button type="button">Delete {file}</button>
</section>
