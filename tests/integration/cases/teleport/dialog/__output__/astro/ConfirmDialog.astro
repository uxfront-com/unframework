---
import type { HTMLAttributes } from "astro/types";

export interface ConfirmDialogProps {
  title: string;
}

interface Props extends ConfirmDialogProps, Omit<HTMLAttributes<"div">, "title"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  title,
  class: className,
  style,
  role,
  "aria-modal": ariaModal,
  "aria-labelledby": ariaLabelledby,
  tabindex,
  ...attrs
} = Astro.props;

function uniqueId(): string {
  const locals = Astro.locals as { ufIdCount?: number };
  locals.ufIdCount = (locals.ufIdCount ?? 0) + 1;
  return `uf-id-${locals.ufIdCount}`;
}

const titleId = uniqueId();
---

<div
  role={"role" in Astro.props ? role : "dialog"}
  aria-modal={"aria-modal" in Astro.props ? ariaModal : "true"}
  aria-labelledby={"aria-labelledby" in Astro.props ? ariaLabelledby : titleId}
  tabindex={"tabindex" in Astro.props ? tabindex : "-1"}
  class:list={["dialog", className]}
  style={style}
  {...attrs}
>
  <h2 id={titleId}>{title}</h2>
  <button type="button">Cancel</button>
  <button type="button">Delete</button>
</div>
