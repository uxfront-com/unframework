{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Delete notes.txt' })",
      "dom": [
        "<section aria-label=\"Files\" class=\"files\">",
        "  <p>",
        "    \"notes.txt\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Delete notes.txt\"",
        "  </button>",
        "</section>",
        "<uf:teleported>",
        "  <div class=\"backdrop\" data-teleported=\"true\">",
        "    <div aria-labelledby=\"uf-id-1\" aria-modal=\"true\" class=\"dialog\" role=\"dialog\" tabindex=\"-1\">",
        "      <h2 id=\"uf-id-1\">",
        "        \"Delete notes.txt?\"",
        "      </h2>",
        "      <button type=\"button\" uf:focused=\"\">",
        "        \"Cancel\"",
        "      </button>",
        "      <button type=\"button\">",
        "        \"Delete\"",
        "      </button>",
        "    </div>",
        "  </div>",
        "</uf:teleported>"
      ],
      "aria": [
        "- region \"Files\":",
        "  - paragraph: notes.txt",
        "  - button \"Delete notes.txt\"",
        "- dialog \"Delete notes.txt?\":",
        "  - heading \"Delete notes.txt?\" [level=2]",
        "  - button \"Cancel\"",
        "  - button \"Delete\""
      ],
      "events": {}
    },
    {
      "action": "keyboard \"{Escape}\"",
      "dom": [
        "<section aria-label=\"Files\" class=\"files\">",
        "  <p>",
        "    \"notes.txt\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Delete notes.txt\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Files\":",
        "  - paragraph: notes.txt",
        "  - button \"Delete notes.txt\""
      ],
      "events": {}
    }
  ]
}
