---
import Panel from "./Panel.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"main"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, ...attrs } = Astro.props;

const shown = true as boolean;
---

<main class:list={["board", className]} style={style} {...attrs}>
  <button type="button">Remove panel</button>
  {shown ? (
    <Panel />
  ) : null}
</main>
