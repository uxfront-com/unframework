---
interface Row {
  id: number;
  label: string;
}

interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const note = false as boolean;
const extras = [] as string[];

const rows = [
  { id: 1, label: "Alpha" },
  { id: 2, label: "Beta" },
] as Row[];
---

<section
  class:list={["panel", className]}
  aria-label="Panel"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <button type="button">Show note</button>
  <button type="button">Add extra</button>
  <button type="button">Reverse rows</button>
  {note ? (
    <p class="note">Note</p>
  ) : null}
  {extras.map((extra) => (
    <span>{extra}</span>
  ))}
  <ul>
    {rows.map((row) => (
      <li>{row.label}</li>
    ))}
  </ul>
</section>
