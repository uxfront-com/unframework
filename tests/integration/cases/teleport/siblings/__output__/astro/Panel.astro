---
import type { HTMLAttributes } from "astro/types";

interface Row {
  id: number;
  label: string;
}

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const note = false as boolean;
const extras = [] as string[];

const rows = [
  { id: 1, label: "Alpha" },
  { id: 2, label: "Beta" },
] as Row[];
---

<section
  class:list={["panel", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Panel"}
  style={style}
  {...attrs}
>
  <button type="button">Show note</button>
  <button type="button">Add extra</button>
  <button type="button">Reverse rows</button>
  {note ? (
    <p class="note">Note</p>
  ) : null}
  {extras.map((extra) => (
    <span>{extra}</span>
  ))}
  <ul>
    {rows.map((row) => (
      <li>{row.label}</li>
    ))}
  </ul>
</section>
