{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Reverse rows' })",
      "dom": [
        "<main class=\"board\">",
        "  <button type=\"button\">",
        "    \"Remove panel\"",
        "  </button>",
        "  <section aria-label=\"Panel\" class=\"panel\">",
        "    <button type=\"button\">",
        "      \"Show note\"",
        "    </button>",
        "    <button type=\"button\">",
        "      \"Add extra\"",
        "    </button>",
        "    <button type=\"button\" uf:focused=\"\">",
        "      \"Reverse rows\"",
        "    </button>",
        "    <ul>",
        "      <li>",
        "        \"Beta\"",
        "      </li>",
        "      <li>",
        "        \"Alpha\"",
        "      </li>",
        "    </ul>",
        "  </section>",
        "</main>",
        "<uf:teleported>",
        "  <div class=\"first\" data-teleported=\"true\">",
        "    \"First\"",
        "  </div>",
        "</uf:teleported>",
        "<uf:teleported>",
        "  <div class=\"second\" data-teleported=\"true\">",
        "    \"Second\"",
        "  </div>",
        "</uf:teleported>",
        "<uf:teleported>",
        "  <p class=\"tip\" data-teleported=\"true\">",
        "    \"Alpha tip\"",
        "  </p>",
        "</uf:teleported>",
        "<uf:teleported>",
        "  <p class=\"tip\" data-teleported=\"true\">",
        "    \"Beta tip\"",
        "  </p>",
        "</uf:teleported>"
      ],
      "aria": [
        "- main:",
        "  - button \"Remove panel\"",
        "  - region \"Panel\":",
        "    - button \"Show note\"",
        "    - button \"Add extra\"",
        "    - button \"Reverse rows\"",
        "    - list:",
        "      - listitem: Beta",
        "      - listitem: Alpha",
        "- text: First",
        "- text: Second",
        "- paragraph: Alpha tip",
        "- paragraph: Beta tip"
      ],
      "events": {}
    }
  ]
}
