---
import Toast from "./Toast.astro";
import type { HTMLAttributes } from "astro/types";
import "./Page.uf.tsx.css";

export interface PageProps {
  message: string;
}

interface Props extends PageProps, Omit<HTMLAttributes<"section">, "message"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { message, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;
---

<section
  class:list={["page", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Page"}
  style={style}
  data-uf-5a3bed67=""
  {...attrs}
>
  <p data-uf-5a3bed67="">Saving…</p>
  <Toast message={message} data-uf-5a3bed67="" />
</section>
