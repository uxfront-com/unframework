---
import type { HTMLAttributes } from "astro/types";

export interface NoticeProps {
  message: string;
}

interface Props extends NoticeProps, Omit<HTMLAttributes<"section">, "message"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  message: _message,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;

const dismissed = 0 as number;
---

<section
  class:list={["inbox", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Inbox"}
  style={style}
  {...attrs}
>
  <p>Dismissed {dismissed} times</p>
</section>
