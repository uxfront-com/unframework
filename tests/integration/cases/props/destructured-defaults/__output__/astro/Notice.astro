---
import type { HTMLAttributes } from "astro/types";

export interface NoticeProps {
  message: string;
  title?: string;
  tone?: "info" | "warning";
  priority?: number;
  expanded?: boolean;
  tags?: string[];
  author?: { name: string };
}

interface Props
  extends
    NoticeProps,
    Omit<
      HTMLAttributes<"section">,
      "message" | "title" | "tone" | "priority" | "expanded" | "tags" | "author"
    > {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  message,
  title = "Notice",
  tone = "info",
  priority = 1,
  expanded = false,
  tags = ["general"],
  author = { name: "System" },
  class: className,
  style,
  "aria-label": ariaLabel,
  "data-tone": dataTone,
  ...attrs
} = Astro.props;
---

<section
  class:list={["notice", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : title}
  data-tone={"data-tone" in Astro.props ? dataTone : tone}
  style={style}
  {...attrs}
>
  <h2>{title}</h2>
  <p>{message}</p>
  <details open={expanded}>
    <summary>Priority {priority}</summary>
    <p>Tagged {tags.join(", ")}, posted by {author.name}.</p>
  </details>
</section>
