---
export interface NoticeProps {
  message: string;
  title?: string;
  tone?: "info" | "warning";
  priority?: number;
  expanded?: boolean;
  tags?: string[];
  author?: { name: string };
}

interface Props extends NoticeProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  message,
  title = "Notice",
  tone = "info",
  priority = 1,
  expanded = false,
  tags = ["general"],
  author = { name: "System" },
  class: className,
  style,
} = Astro.props;
---

<section class:list={["notice", className]} aria-label={title} data-tone={tone} style={style}>
  <h2>{title}</h2>
  <p>{message}</p>
  <details open={expanded}>
    <summary>Priority {priority}</summary>
    <p>Tagged {tags.join(", ")}, posted by {author.name}.</p>
  </details>
</section>
