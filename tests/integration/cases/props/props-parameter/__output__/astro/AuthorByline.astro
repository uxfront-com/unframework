---
export interface AuthorBylineProps {
  author: string;
  published: string;
  minutes: number;
  affiliation?: string;
}

interface Props extends AuthorBylineProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const props = Astro.props;
const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<p
  class:list={["byline", className]}
  style={style}
  {...scopeAttributes(Astro.props)}
>By {props.author}, {props.affiliation ?? "independent"}<br /><time
  datetime={props.published}
>{props.published}</time> · {props.minutes} min read</p>
