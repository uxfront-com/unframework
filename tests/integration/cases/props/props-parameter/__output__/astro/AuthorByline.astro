---
import type { HTMLAttributes } from "astro/types";

export interface AuthorBylineProps {
  author: string;
  published: string;
  minutes: number;
  affiliation?: string;
}

interface Props
  extends
    AuthorBylineProps,
    Omit<HTMLAttributes<"p">, "author" | "published" | "minutes" | "affiliation"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const props = Astro.props;
const {
  author: _author,
  published: _published,
  minutes: _minutes,
  affiliation: _affiliation,
  class: className,
  style,
  ...attrs
} = Astro.props;
---

<p
  class:list={["byline", className]}
  style={style}
  {...attrs}
>By {props.author}, {props.affiliation ?? "independent"}<br /><time
  datetime={props.published}
>{props.published}</time> · {props.minutes} min read</p>
