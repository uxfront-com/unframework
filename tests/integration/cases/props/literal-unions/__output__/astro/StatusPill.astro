---
export interface StatusPillProps {
  status: "active" | "paused" | "archived";
  size?: "small" | "large";
  level?: 1 | 2 | 3;
}

type Props = StatusPillProps;

const { status, size = "small", level = 1 } = Astro.props;
---

<span
  class:list={["pill", `pill-${status}`, `pill-${size}`, `pill-level-${level}`]}
>{status === "active" ? "Active" : status === "paused" ? "Paused" : "Archived"}{level === 3 ? " (critical)" : ""}</span>
