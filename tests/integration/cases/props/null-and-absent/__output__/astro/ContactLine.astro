---
export interface ContactLineProps {
  name: string;
  phone?: string | null;
  verified?: boolean | null;
}

interface Props extends ContactLineProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { name, phone, verified, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<section
  class:list={["contact-line", className]}
  aria-label={name}
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <p
    data-phone={phone === null ? "withheld" : phone}
  >Phone: {phone === null ? "withheld" : (phone ?? "not given yet")}</p>
  <p>{verified === null ? "Verification pending" : verified ? "Verified" : "Not verified"}</p>
</section>
