---
import type { HTMLAttributes } from "astro/types";

export interface ContactLineProps {
  name: string;
  phone?: string | null;
  verified?: boolean | null;
}

interface Props
  extends ContactLineProps, Omit<HTMLAttributes<"section">, "name" | "phone" | "verified"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  name,
  phone,
  verified,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
---

<section
  class:list={["contact-line", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : name}
  style={style}
  {...attrs}
>
  <p
    data-phone={phone === null ? "withheld" : phone}
  >Phone: {phone === null ? "withheld" : (phone ?? "not given yet")}</p>
  <p>{verified === null ? "Verification pending" : verified ? "Verified" : "Not verified"}</p>
</section>
