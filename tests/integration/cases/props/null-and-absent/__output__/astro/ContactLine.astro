---
export interface ContactLineProps {
  name: string;
  phone?: string | null;
  verified?: boolean | null;
}

interface Props extends ContactLineProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { name, phone, verified, class: className, style } = Astro.props;
---

<section class:list={["contact-line", className]} aria-label={name} style={style}>
  <p
    data-phone={phone === null ? "withheld" : phone}
  >Phone: {phone === null ? "withheld" : (phone ?? "not given yet")}</p>
  <p>{verified === null ? "Verification pending" : verified ? "Verified" : "Not verified"}</p>
</section>
