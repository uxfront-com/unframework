---
type Availability = "in-stock" | "backorder" | "discontinued";

interface Finish {
  sku: string;
  label: string;
}

export interface ProductSpecProps {
  name: string;
  availability: Availability;
  size: { width: number; depth: number; unit: "cm" | "in" };
  finishes: Finish[];
}

interface Props extends ProductSpecProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { name, availability, size, finishes, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<section
  class:list={["product-spec", className]}
  aria-label={name}
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <h2>{name}</h2>
  <dl>
    <dt>Availability</dt>
    <dd>{availability}</dd>
    <dt>Size</dt>
    <dd>{size.width} × {size.depth} {size.unit}</dd>
  </dl>
  <ul>
    {finishes.map((finish) => (
      <li>{finish.label} ({finish.sku})</li>
    ))}
  </ul>
</section>
