---
import type { HTMLAttributes } from "astro/types";

type Availability = "in-stock" | "backorder" | "discontinued";

interface Finish {
  sku: string;
  label: string;
}

export interface ProductSpecProps {
  name: string;
  availability: Availability;
  size: { width: number; depth: number; unit: "cm" | "in" };
  finishes: Finish[];
}

interface Props
  extends
    ProductSpecProps,
    Omit<HTMLAttributes<"section">, "name" | "availability" | "size" | "finishes"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  name,
  availability,
  size,
  finishes,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
---

<section
  class:list={["product-spec", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : name}
  style={style}
  {...attrs}
>
  <h2>{name}</h2>
  <dl>
    <dt>Availability</dt>
    <dd>{availability}</dd>
    <dt>Size</dt>
    <dd>{size.width} × {size.depth} {size.unit}</dd>
  </dl>
  <ul>
    {finishes.map((finish) => (
      <li>{finish.label} ({finish.sku})</li>
    ))}
  </ul>
</section>
