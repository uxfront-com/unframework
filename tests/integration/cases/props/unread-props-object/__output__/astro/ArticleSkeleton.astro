---
export interface ArticleSkeletonProps {
  title: string;
  summary?: string;
  minutes?: number;
}

interface Props extends ArticleSkeletonProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;
---

<article
  class:list={["article-skeleton", className]}
  aria-busy="true"
  aria-label="Loading article"
  style={style}
>
  <p>Loading the article</p>
</article>
