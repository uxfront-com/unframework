---
import type { HTMLAttributes } from "astro/types";

export interface ArticleTeaserProps {
  title: string;
  summary: string;
  author: string;
  minutes?: number;
  featured?: boolean;
  category?: string;
  pinned?: boolean;
  layout?: "row" | "column";
}

interface Props
  extends
    ArticleTeaserProps,
    Omit<
      HTMLAttributes<"article">,
      "title" | "summary" | "author" | "minutes" | "featured" | "category" | "pinned" | "layout"
    > {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  title,
  summary,
  minutes = 5,
  pinned: _pinned,
  layout: _layout,
  author: _author,
  featured: _featured,
  category: _category,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
---

<article
  class:list={["article-teaser", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : title}
  style={style}
  {...attrs}
>
  <h2>{title}</h2>
  <p>{summary}</p>
  <p class="article-teaser-meta">{minutes} min read</p>
</article>
