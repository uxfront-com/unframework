---
export interface ArticleTeaserProps {
  title: string;
  summary: string;
  author: string;
  minutes?: number;
  featured?: boolean;
  category?: string;
  pinned?: boolean;
  layout?: "row" | "column";
}

interface Props extends ArticleTeaserProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, summary, minutes = 5, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<article
  class:list={["article-teaser", className]}
  aria-label={title}
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <h2>{title}</h2>
  <p>{summary}</p>
  <p class="article-teaser-meta">{minutes} min read</p>
</article>
