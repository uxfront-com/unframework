---
export interface ArticleTeaserProps {
  title: string;
  summary: string;
  author: string;
  minutes?: number;
  featured?: boolean;
  category?: string;
  pinned?: boolean;
  layout?: "row" | "column";
}

interface Props extends ArticleTeaserProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, summary, minutes = 5, class: className, style } = Astro.props;
---

<article class:list={["article-teaser", className]} aria-label={title} style={style}>
  <h2>{title}</h2>
  <p>{summary}</p>
  <p class="article-teaser-meta">{minutes} min read</p>
</article>
