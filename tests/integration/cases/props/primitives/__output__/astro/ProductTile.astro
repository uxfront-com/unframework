---
export interface ProductTileProps {
  name: string;
  price: number;
  stock: number;
  available?: boolean;
}

interface Props extends ProductTileProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { name, price, stock, available = true, class: className, style } = Astro.props;
---

<article class:list={["product-tile", className]} aria-label={name} style={style}>
  <h2>{name}</h2>
  <p>Price: {price} EUR</p>
  <p data-stock={stock}>{stock} in stock</p>
  <p>{available ? "Available to order" : "Currently unavailable"}</p>
  <button type="button" disabled={!available}>Add {name} to basket</button>
</article>
