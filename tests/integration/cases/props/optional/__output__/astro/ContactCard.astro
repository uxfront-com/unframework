---
export interface ContactCardProps {
  name: string;
  jobTitle?: string;
  team?: string;
  pronouns?: string;
  phone?: string | null;
}

interface Props extends ContactCardProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { name, jobTitle, team, pronouns, phone, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<article
  class:list={["contact-card", className]}
  aria-label={name}
  data-team={team}
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <h2 title={pronouns}>{name}</h2>
  <p>{jobTitle}</p>
  <p>Phone: {phone ?? "not listed"}</p>
</article>
