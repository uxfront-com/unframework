---
import type { HTMLAttributes } from "astro/types";

export interface ContactCardProps {
  name: string;
  jobTitle?: string;
  team?: string;
  pronouns?: string;
  phone?: string | null;
}

interface Props
  extends
    ContactCardProps,
    Omit<HTMLAttributes<"article">, "name" | "jobTitle" | "team" | "pronouns" | "phone"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  name,
  jobTitle,
  team,
  pronouns,
  phone,
  class: className,
  style,
  "aria-label": ariaLabel,
  "data-team": dataTeam,
  ...attrs
} = Astro.props;
---

<article
  class:list={["contact-card", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : name}
  data-team={"data-team" in Astro.props ? dataTeam : team}
  style={style}
  {...attrs}
>
  <h2 title={pronouns}>{name}</h2>
  <p>{jobTitle}</p>
  <p>Phone: {phone ?? "not listed"}</p>
</article>
