---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "label"> {
  label: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;
---

<section
  class:list={["card", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : label}
  style={style}
  {...attrs}
>
  {Astro.slots.has("title") ? (
    <header class="title">
      <slot name="title" />
    </header>
  ) : null}
  {Astro.slots.has("default") ? (
    <div class="body">
      <slot />
    </div>
  ) : (
    <p>Empty card</p>
  )}
</section>
