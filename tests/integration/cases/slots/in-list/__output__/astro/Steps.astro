---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"ol">, "steps"> {
  steps: string[];
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { steps, class: className, style, ...attrs } = Astro.props;
---

<ol class:list={["steps", className]} style={style} {...attrs}>
  {steps.map((step) => (
    <li><slot name="marker" />{step}</li>
  ))}
</ol>
