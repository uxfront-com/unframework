---
import Legend from "./Legend.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "series"> {
  series: string[];
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { series, class: className, style, ...attrs } = Astro.props;
---

<div class:list={[className]} style={style} {...attrs}>
  <Legend
    items={series}
    label="Series"
    swatch={({ item }) => <b>{item.slice(0, 1)}</b>}
    caption={({ item }) => <i>{item}</i>}
  />
  <Legend
    items={series}
    label="Captions"
    caption={({ item }) => <span>{item.toUpperCase()}</span>}
  />
</div>
