---
import Legend from "./Legend.astro";

interface Props {
  series: string[];
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { series, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<div class:list={[className]} style={style} {...scopeAttributes(Astro.props)}>
  <Legend
    items={series}
    label="Series"
    swatch={({ item }) => <b>{item.slice(0, 1)}</b>}
    caption={({ item }) => <i>{item}</i>}
  />
  <Legend
    items={series}
    label="Captions"
    caption={({ item }) => <span>{item.toUpperCase()}</span>}
  />
</div>
