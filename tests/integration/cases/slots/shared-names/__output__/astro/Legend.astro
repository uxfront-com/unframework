---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"ul">, "items" | "label" | "swatch" | "caption"> {
  items: string[];
  label: string;
  swatch?: (props: { item: string }) => unknown;
  caption?: (props: { item: string }) => unknown;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  items,
  label,
  swatch,
  caption,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
---

<ul
  aria-label={"aria-label" in Astro.props ? ariaLabel : label}
  class:list={[className]}
  style={style}
  {...attrs}
>
  {items.map((item) => (
    <li>
      <span>{swatch?.({ item })}</span> <span>{caption?.({ item })}</span>
    </li>
  ))}
</ul>
