---
import EachAction from "./EachAction.astro";
import FadeFace from "./FadeFace.astro";
import FramedNote from "./FramedNote.astro";
import OnceAction from "./OnceAction.astro";
import RowList from "./RowList.astro";
import TagList from "./TagList.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, ...attrs } = Astro.props;

const bold = true as boolean;
---

<section class:list={["shelf", className]} style={style} {...attrs}>
  <RowList label="Produce" items={["Apples", "Pears", "Plums"]}>
    <em>fresh</em>
  </RowList>
  <FramedNote title="Release notes">
    <strong>Draft</strong>
  </FramedNote>
  <TagList ordered={true} label="Ranked" items={["gold", "silver"]}>
    <span>Medal</span>
  </TagList>
  <TagList ordered={false} label="Unranked" items={["red", "blue"]}>
    <span>Colour</span>
  </TagList>
  <OnceAction href="#once" label="Once">Open once</OnceAction>
  <OnceAction label="Single">Press once</OnceAction>
  <EachAction href="#each" items={["one", "two"]}>Open each</EachAction>
  <EachAction items={["three", "four"]}>Press each</EachAction>
  <FadeFace bold={bold}>Face</FadeFace>
  <button type="button">Swap face</button>
</section>
