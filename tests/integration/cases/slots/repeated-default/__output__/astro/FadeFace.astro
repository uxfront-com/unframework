---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "bold"> {
  bold: boolean;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { bold, class: className, style, ...attrs } = Astro.props;
---

<div class:list={["fade-face", className]} style={style} {...attrs}>
  {bold ? (
    <b class="face">
      <slot />
    </b>
  ) : (
    <i class="face">
      <slot />
    </i>
  )}
</div>
