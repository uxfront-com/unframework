---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"span">, "label" | "text"> {
  label: string;
  text?: (props: { label: string }) => unknown;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, text, class: className, style, ...attrs } = Astro.props;
---

<span class:list={["once-slot", className]} style={style} {...attrs}>{text?.({ label })}</span>
