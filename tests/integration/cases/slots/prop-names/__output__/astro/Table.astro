---
import type { HTMLAttributes } from "astro/types";

export interface Person {
  id: string;
  name: string;
}

interface Props extends Omit<HTMLAttributes<"ol">, "people" | "row"> {
  people: Person[];
  row?: (props: { name: string; "data-id": string; index: number }) => unknown;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { people, row, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;
---

<ol
  aria-label={"aria-label" in Astro.props ? ariaLabel : "People"}
  class:list={[className]}
  style={style}
  {...attrs}
>
  {people.map((person, index) => (
    <li>{row?.({ name: person.name, "data-id": person.id, index })}</li>
  ))}
</ol>
