---
export interface Person {
  id: string;
  name: string;
}

interface Props {
  people: Person[];
  row?: (props: { name: string; "data-id": string; index: number }) => unknown;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { people, row, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<ol aria-label="People" class:list={[className]} style={style} {...scopeAttributes(Astro.props)}>
  {people.map((person, index) => (
    <li>{row?.({ name: person.name, "data-id": person.id, index })}</li>
  ))}
</ol>
