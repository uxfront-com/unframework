---
import Table from "./Table.astro";
import type { HTMLAttributes } from "astro/types";

export interface Person {
  id: string;
  name: string;
}

interface Props extends Omit<HTMLAttributes<"ol">, "people"> {
  people: Person[];
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { people, class: className, style, ...attrs } = Astro.props;
---

<Table
  people={people}
  class:list={[className]}
  style={style}
  row={({ name, "data-id": id, index }) => <span>{index + 1}: {name} ({id})</span>}
  {...attrs}
/>
