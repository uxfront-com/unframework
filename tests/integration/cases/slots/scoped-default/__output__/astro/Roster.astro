---
import Names from "./Names.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"ul">, "names"> {
  names: string[];
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { names, class: className, style, ...attrs } = Astro.props;
---

<Names
  names={names}
  class:list={[className]}
  style={style}
  default={({ item }) => <b>{item}!</b>}
  {...attrs}
/>
