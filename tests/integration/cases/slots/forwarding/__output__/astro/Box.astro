---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;
---

<div class:list={["box", className]} style={style}>
  <h3>
    <slot name="title">Untitled</slot>
  </h3>
  <slot>
    <p>No content</p>
  </slot>
</div>
