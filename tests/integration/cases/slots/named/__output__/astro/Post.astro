---
import Card from "./Card.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"article">, "author"> {
  author: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { author, class: className, style, ...attrs } = Astro.props;
---

<Card class:list={[className]} style={style} {...attrs}>
  <p>Slots arrive in M3.</p>
  <Fragment slot="header">
    <h2>Release notes</h2>
  </Fragment>
  <Fragment slot="footer">
    <small>By {author}</small>
  </Fragment>
</Card>
