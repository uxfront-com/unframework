---
import Notice from "./Notice.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "build"> {
  build: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { build, class: className, style, ...attrs } = Astro.props;
---

<div class:list={[className]} style={style} {...attrs}>
  <Notice
    label="Build"
  >Build {build} failed.<Fragment slot="action"><a href="#logs">See the logs</a></Fragment></Notice>
  <Notice label="Deploy" />
</div>
