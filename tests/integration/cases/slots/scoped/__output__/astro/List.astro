---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"ul">, "items" | "label" | "item"> {
  items: string[];
  label: string;
  item?: (props: { item: string; index: number }) => unknown;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  items,
  label,
  item: item_1,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
---

<ul
  aria-label={"aria-label" in Astro.props ? ariaLabel : label}
  class:list={[className]}
  style={style}
  {...attrs}
>
  {items.map((item, index) => (
    <li>{item_1?.({ item, index })}</li>
  ))}
</ul>
