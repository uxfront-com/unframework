---
interface Props {
  items: string[];
  label: string;
  item?: (props: { item: string; index: number }) => unknown;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { items, label, item: item_1, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<ul aria-label={label} class:list={[className]} style={style} {...scopeAttributes(Astro.props)}>
  {items.map((item, index) => (
    <li>{item_1?.({ item, index })}</li>
  ))}
</ul>
