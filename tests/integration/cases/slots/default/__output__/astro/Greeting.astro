---
import Panel from "./Panel.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "name" | "title"> {
  name: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { name, class: className, style, ...attrs } = Astro.props;
---

<Panel title="Welcome" class:list={[className]} style={style} {...attrs}>
  <p>Hello, <strong>{name}</strong>!</p>
  <p>Your children render in the panel.</p>
</Panel>
