---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const message = "Thanks, see you soon" as string;
const signature = "Ada" as string;
---

<form aria-label="Reply" class:list={[className]} style={style} {...scopeAttributes(Astro.props)}>
  <textarea aria-label="Message">{message}</textarea>
  <textarea aria-label="Signature">{signature}</textarea>
  <output>[{message}] from {signature}</output>
</form>
