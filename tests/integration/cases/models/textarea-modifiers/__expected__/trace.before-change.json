{
  "version": 1,
  "steps": [
    {
      "action": "fill getByRole('textbox', { name: 'Signature' }) \"Grace\"",
      "dom": [
        "<form aria-label=\"Reply\">",
        "  <textarea aria-label=\"Message\" uf:value=\"Thanks, see you soon\"></textarea>",
        "  <textarea aria-label=\"Signature\" uf:focused=\"\" uf:value=\"Grace\"></textarea>",
        "  <output>",
        "    \"[Thanks, see you soon] from Ada\"",
        "  </output>",
        "</form>"
      ],
      "aria": [
        "- form \"Reply\":",
        "  - textbox \"Message\": Thanks, see you soon",
        "  - textbox \"Signature\": Grace",
        "  - status: \"[Thanks, see you soon] from Ada\""
      ],
      "events": {}
    }
  ]
}
