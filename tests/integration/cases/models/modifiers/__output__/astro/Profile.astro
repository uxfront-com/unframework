---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const name = "" as string;
const city = "Lisbon" as string;
const weight = 0 as number;
---

<form aria-label="Profile" class:list={[className]} style={style} {...scopeAttributes(Astro.props)}>
  <label>Name <input value={name} /></label>
  <label>City <input value={city} /></label>
  <label>Weight <input value={weight} /></label>
  <output>[{name}] from {city}, {weight + 1}</output>
</form>
