---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

const name = "" as string;
const city = "Lisbon" as string;
const weight = 0 as number;
---

<form aria-label="Profile" class:list={[className]} style={style}>
  <label>Name <input value={name} /></label>
  <label>City <input value={city} /></label>
  <label>Weight <input value={weight} /></label>
  <output>[{name}] from {city}, {weight + 1}</output>
</form>
