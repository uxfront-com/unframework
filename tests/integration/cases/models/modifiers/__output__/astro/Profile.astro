---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"form"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const name = "" as string;
const city = "Lisbon" as string;
const weight = 0 as number;
---

<form
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Profile"}
  class:list={[className]}
  style={style}
  {...attrs}
>
  <label>Name <input value={name} /></label>
  <label>City <input value={city} /></label>
  <label>Weight <input value={weight} /></label>
  <output>[{name}] from {city}, {weight + 1}</output>
</form>
