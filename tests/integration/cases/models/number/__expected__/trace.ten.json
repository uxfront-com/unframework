{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Ten' })",
      "dom": [
        "<section aria-label=\"Order\">",
        "  <input aria-label=\"Count\" min=\"0\" type=\"number\" uf:value=\"10\">",
        "  <input aria-label=\"Volume\" max=\"10\" min=\"0\" type=\"range\" uf:value=\"6\">",
        "  <output>",
        "    \"Next: 11, volume 7\"",
        "  </output>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Ten\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Order\":",
        "  - spinbutton \"Count\": \"10\"",
        "  - slider \"Volume\": \"6\"",
        "  - status: \"Next: 11, volume 7\"",
        "  - button \"Ten\""
      ],
      "events": {}
    }
  ]
}
