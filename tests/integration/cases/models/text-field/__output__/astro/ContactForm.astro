---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"form"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const name = "Ada" as string;
const email = "" as string;
---

<form
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Contact"}
  class:list={[className]}
  style={style}
  {...attrs}
>
  <label>Name <input value={name} /></label>
  <label>Email <input type="email" value={email} /></label>
  <output>{name} at {email || "no address"}</output>
  <button type="button">Use Grace</button>
</form>
