---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

const name = "Ada" as string;
const email = "" as string;
---

<form aria-label="Contact" class:list={[className]} style={style}>
  <label>Name <input value={name} /></label>
  <label>Email <input type="email" value={email} /></label>
  <output>{name} at {email || "no address"}</output>
  <button type="button">Use Grace</button>
</form>
