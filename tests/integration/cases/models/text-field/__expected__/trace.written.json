{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Use Grace' })",
      "dom": [
        "<form aria-label=\"Contact\">",
        "  <label>",
        "    \"Name \"",
        "    <input uf:value=\"Grace\">",
        "  </label>",
        "  <label>",
        "    \"Email \"",
        "    <input type=\"email\" uf:value=\"linus@example.com\">",
        "  </label>",
        "  <output>",
        "    \"Grace at linus@example.com\"",
        "  </output>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Use Grace\"",
        "  </button>",
        "</form>"
      ],
      "aria": [
        "- form \"Contact\":",
        "  - text: Name",
        "  - textbox \"Name\": Grace",
        "  - text: Email",
        "  - textbox \"Email\": linus@example.com",
        "  - status: Grace at linus@example.com",
        "  - button \"Use Grace\""
      ],
      "events": {}
    }
  ]
}
