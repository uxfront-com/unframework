---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "label" | "value"> {
  label: string;
  value?: number;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, value = 0, class: className, style, ...attrs } = Astro.props;
---

<div class:list={["stepper", className]} style={style} {...attrs}>
  <button type="button" aria-label={`Fewer ${label}`}>-</button>
  <span>{label}: {value}</span>
  <button type="button" aria-label={`More ${label}`}>+</button>
</div>
