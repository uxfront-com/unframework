---
interface Props {
  label: string;
  value?: number;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, value = 0, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<div class:list={["stepper", className]} style={style} {...scopeAttributes(Astro.props)}>
  <button type="button" aria-label={`Fewer ${label}`}>-</button>
  <span>{label}: {value}</span>
  <button type="button" aria-label={`More ${label}`}>+</button>
</div>
