---
import Stepper from "./Stepper.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const cups = 2 as number;
---

<section
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Order"}
  class:list={[className]}
  style={style}
  {...attrs}
>
  <Stepper label="Cups" value={cups} />
  <output>Ordered: {cups}</output>
  <button type="button">Clear</button>
</section>
