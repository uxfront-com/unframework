---
import type { HTMLAttributes } from "astro/types";

export interface DeliveryProps {
  speeds: string[];
  extras: string[];
}

interface Props extends DeliveryProps, Omit<HTMLAttributes<"section">, "speeds" | "extras"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { speeds, extras, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const speed = "express" as string;
const chosen = ["insurance"] as string[];
---

<section
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Delivery"}
  class:list={[className]}
  style={style}
  {...attrs}
>
  <fieldset>
    <legend>Speed</legend>
    {speeds.map((value) => (
      <label><input type="radio" name="speed" value={value} checked={speed === value} /> {value}</label>
    ))}
  </fieldset>
  <fieldset>
    <legend>Extras</legend>
    {extras.map((extra) => (
      <label><input type="checkbox" value={extra} checked={chosen.includes(extra)} /> {extra}</label>
    ))}
  </fieldset>
  <output>Speed: {speed}, extras: {chosen.join(", ") || "none"}</output>
</section>
