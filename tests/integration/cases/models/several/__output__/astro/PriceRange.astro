---
interface Props {
  label: string;
  min?: number;
  max?: number;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, min = 0, max = 100, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<fieldset class:list={[className]} style={style} {...scopeAttributes(Astro.props)}>
  <legend>{label}</legend>
  <p>From {min} to {max}</p>
  <button type="button">Widen</button>
</fieldset>
