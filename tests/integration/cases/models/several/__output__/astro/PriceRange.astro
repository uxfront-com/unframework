---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"fieldset">, "label" | "min" | "max"> {
  label: string;
  min?: number;
  max?: number;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, min = 0, max = 100, class: className, style, ...attrs } = Astro.props;
---

<fieldset class:list={[className]} style={style} {...attrs}>
  <legend>{label}</legend>
  <p>From {min} to {max}</p>
  <button type="button">Widen</button>
</fieldset>
