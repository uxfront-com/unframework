{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Largest' })",
      "dom": [
        "<section aria-label=\"Size\">",
        "  <label>",
        "    \"Size \"",
        "    <select>",
        "      <option uf:selected=\"false\" value=\"s\">",
        "        \"Small\"",
        "      </option>",
        "      <option uf:selected=\"false\" value=\"m\">",
        "        \"Medium\"",
        "      </option>",
        "      <option uf:selected=\"true\" value=\"l\">",
        "        \"Large\"",
        "      </option>",
        "    </select>",
        "  </label>",
        "  <output>",
        "    \"Chosen: l\"",
        "  </output>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Largest\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Size\":",
        "  - text: Size",
        "  - combobox \"Size\":",
        "    - option \"Small\"",
        "    - option \"Medium\"",
        "    - option \"Large\" [selected]",
        "  - status: \"Chosen: l\"",
        "  - button \"Largest\""
      ],
      "events": {}
    }
  ]
}
