---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const size = "m" as string;
---

<section
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Size"}
  class:list={[className]}
  style={style}
  {...attrs}
>
  <label>Size <select><option value="s" selected={size === "s"}>Small</option><option
    value="m"
    selected={size === "m"}
  >Medium</option><option value="l" selected={size === "l"}>Large</option></select></label>
  <output>Chosen: {size}</output>
  <button type="button">Largest</button>
</section>
