---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const size = "m" as string;
---

<section aria-label="Size" class:list={[className]} style={style} {...scopeAttributes(Astro.props)}>
  <label>Size <select><option value="s" selected={size === "s"}>Small</option><option
    value="m"
    selected={size === "m"}
  >Medium</option><option value="l" selected={size === "l"}>Large</option></select></label>
  <output>Chosen: {size}</output>
  <button type="button">Largest</button>
</section>
