---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const toppings = ["cheese"] as string[];
---

<section
  aria-label="Pizza"
  class:list={[className]}
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <label>Toppings <select
    multiple
  ><option value="cheese" selected={toppings.includes("cheese")}>Cheese</option><option
    value="olives"
    selected={toppings.includes("olives")}
  >Olives</option><option value="basil" selected={toppings.includes("basil")}>Basil</option></select></label>
  <output>On top: {toppings.join(", ") || "nothing"}</output>
  <button type="button">Green</button>
</section>
