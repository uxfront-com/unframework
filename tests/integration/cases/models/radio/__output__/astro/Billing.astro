---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

const plan = "monthly" as string;
---

<fieldset class:list={[className]} style={style}>
  <legend>Billing</legend>
  <label><input type="radio" name="plan" value="monthly" checked={plan === "monthly"} /> Monthly</label>
  <label><input type="radio" name="plan" value="yearly" checked={plan === "yearly"} /> Yearly</label>
  <output>Plan: {plan}</output>
  <button type="button">Reset</button>
</fieldset>
