{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Reset' })",
      "dom": [
        "<fieldset>",
        "  <legend>",
        "    \"Billing\"",
        "  </legend>",
        "  <label>",
        "    <input name=\"plan\" type=\"radio\" uf:checked=\"true\" value=\"monthly\">",
        "    \" Monthly\"",
        "  </label>",
        "  <label>",
        "    <input name=\"plan\" type=\"radio\" uf:checked=\"false\" value=\"yearly\">",
        "    \" Yearly\"",
        "  </label>",
        "  <output>",
        "    \"Plan: monthly\"",
        "  </output>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Reset\"",
        "  </button>",
        "</fieldset>"
      ],
      "aria": [
        "- group \"Billing\":",
        "  - text: Billing",
        "  - radio \"Monthly\" [checked]",
        "  - text: Monthly",
        "  - radio \"Yearly\"",
        "  - text: Yearly",
        "  - status: \"Plan: monthly\"",
        "  - button \"Reset\""
      ],
      "events": {}
    }
  ]
}
