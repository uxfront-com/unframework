---
export interface TagProps {
  label: string;
  colour?: string;
  weight?: number;
  indent?: string;
}

interface Props extends TagProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, colour, weight, indent, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<span
  class:list={["tag", className]}
  style={{ display: "inline-block", padding: "2px 8px", borderStyle: "solid", borderWidth: "1px", borderColor: colour ?? "#5a5a5a", color: colour, fontWeight: weight, marginLeft: indent, ...style }}
  {...scopeAttributes(Astro.props)}
>{label}</span>
