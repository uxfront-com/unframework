---
import type { HTMLAttributes } from "astro/types";

export interface TagProps {
  label: string;
  colour?: string;
  weight?: number;
  indent?: string;
}

interface Props
  extends TagProps, Omit<HTMLAttributes<"span">, "label" | "colour" | "weight" | "indent"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, colour, weight, indent, class: className, style, ...attrs } = Astro.props;
---

<span
  class:list={["tag", className]}
  style={{ display: "inline-block", padding: "2px 8px", borderStyle: "solid", borderWidth: "1px", borderColor: colour ?? "#5a5a5a", color: colour, fontWeight: weight, marginLeft: indent, ...style }}
  {...attrs}
>{label}</span>
