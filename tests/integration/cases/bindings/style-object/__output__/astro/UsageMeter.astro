---
export interface UsageMeterProps {
  label: string;
  percent: number;
  colour: string;
  thickness: number;
}

interface Props extends UsageMeterProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, percent, colour, thickness, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<div class:list={["usage-meter", className]} style={style} {...scopeAttributes(Astro.props)}>
  <p
    style={{ color: colour, fontWeight: 700, lineHeight: 1.5, marginBottom: "4px" }}
  >{label}: {percent}%</p>
  <div
    role="progressbar"
    aria-label={label}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={percent}
    style={{ "--meter-colour": colour, "--meter-value": percent, width: "200px", height: "12px", borderStyle: "solid", borderWidth: `${thickness}px`, borderColor: colour }}
  >
    <div
      style={{ width: `${percent}%`, height: "100%", backgroundColor: "var(--meter-colour)" }}
    ></div>
  </div>
  <p
    class="usage-meter-caption"
    style={{ color: colour, fontFamily: "\"UF Test Sans\", sans-serif" }}
  >{percent} of 100 used</p>
</div>
