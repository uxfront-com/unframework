---
export interface BannerProps {
  message: string;
  tone: string;
  emphasis?: string | null;
}

interface Props extends BannerProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { message, tone, emphasis, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<div
  class:list={["banner", tone, className]}
  role="note"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <p class:list={[emphasis]}>{message}</p>
  <p class:list={[`banner-footer banner-footer-${tone}`]}>Shown to every visitor.</p>
</div>
