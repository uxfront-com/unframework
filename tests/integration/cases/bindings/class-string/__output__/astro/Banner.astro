---
import type { HTMLAttributes } from "astro/types";

export interface BannerProps {
  message: string;
  tone: string;
  emphasis?: string | null;
}

interface Props extends BannerProps, Omit<HTMLAttributes<"div">, "message" | "tone" | "emphasis"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { message, tone, emphasis, class: className, style, role, ...attrs } = Astro.props;
---

<div
  class:list={["banner", tone, className]}
  role={"role" in Astro.props ? role : "note"}
  style={style}
  {...attrs}
>
  <p class:list={[emphasis]}>{message}</p>
  <p class:list={[`banner-footer banner-footer-${tone}`]}>Shown to every visitor.</p>
</div>
