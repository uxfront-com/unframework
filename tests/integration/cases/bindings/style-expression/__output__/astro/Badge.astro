---
import { styleObject } from "./_unframework/styleObject";
import type { HTMLAttributes } from "astro/types";

export interface BadgeProps {
  label: string;
  tone?: string;
}

interface Props extends BadgeProps, Omit<HTMLAttributes<"span">, "label" | "tone"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, tone, class: className, style, ...attrs } = Astro.props;
---

<span
  class:list={["badge", className]}
  style={{ ...styleObject(tone), ...style }}
  {...attrs}
>{label}</span>
