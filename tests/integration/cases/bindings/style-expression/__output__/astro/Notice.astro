---
import Badge from "./Badge.astro";
import Tag from "./Tag.astro";

type NoticeLook = {
  color?: string;
  backgroundColor?: string;
  borderLeft?: string;
  "--notice-accent"?: string;
};

type NoticeVars = { "--notice-gap"?: string };

export interface NoticeProps {
  title: string;
  look?: NoticeLook;
  declarations?: string;
  vars?: NoticeVars;
}

interface Props extends NoticeProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, look, declarations, vars, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

/** A style bound to a value as an object: a declaration list becomes one. */
function styleObject(style: object | string | null | undefined): Record<string, string> {
  if (typeof style !== "string") return { ...style };
  const object: Record<string, string> = {};
  for (const declaration of style.replace(/\/\*[^]*?\*\//g, "").split(/;(?![^(]*\))/g)) {
    const [property, value] = declaration.split(/:([^]+)/);
    const key = property!.trim();
    // Only a CSS identifier is a property: anything else would reach the markup as written.
    if (value === undefined || !/^-?-?[A-Za-z_][\w-]*$/.test(key)) continue;
    const camel = key.replace(/-([a-z])/g, (_, letter: string) => letter.toUpperCase());
    object[key.startsWith("--") ? key : camel] = value.trim();
  }
  return object;
}

const quiet = false as boolean;

const Tag_1 = quiet ? Tag : Badge;
---

<div class:list={["notice", className]} style={style} {...scopeAttributes(Astro.props)}>
  <p style={look}>{title}</p>
  <Badge
    label="Permanent"
    tone="padding: 2px 6px; color: rgb(120, 30, 30); outline: 1px solid"
    style={styleObject(look)}
  />
  <p style={declarations}>Read the details before you continue.</p>
  <Tag_1 label="Optional" tone="font-weight: 700" style={styleObject(declarations)} />
  <p
    style={quiet
      ? { color: "rgb(90, 90, 90)" }
      : { color: "var(--notice-accent, rgb(160, 40, 40))", fontWeight: "700" }}
  >This cannot be undone.</p>
  <button type="button" style={vars}>{quiet ? "Emphasise" : "Quieten"}</button>
</div>
