---
import Badge from "./Badge.astro";
import Tag from "./Tag.astro";
import { styleObject } from "./_unframework/styleObject";
import type { HTMLAttributes } from "astro/types";

type NoticeLook = {
  color?: string;
  backgroundColor?: string;
  borderLeft?: string;
  "--notice-accent"?: string;
};

type NoticeVars = { "--notice-gap"?: string };

export interface NoticeProps {
  title: string;
  look?: NoticeLook;
  declarations?: string;
  vars?: NoticeVars;
}

interface Props
  extends NoticeProps, Omit<HTMLAttributes<"div">, "title" | "look" | "declarations" | "vars"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, look, declarations, vars, class: className, style, ...attrs } = Astro.props;

const quiet = false as boolean;

const Tag_1 = quiet ? Tag : Badge;
---

<div class:list={["notice", className]} style={style} {...attrs}>
  <p style={look}>{title}</p>
  <Badge
    label="Permanent"
    tone="padding: 2px 6px; color: rgb(120, 30, 30); outline: 1px solid"
    style={styleObject(look)}
  />
  <p style={declarations}>Read the details before you continue.</p>
  <Tag_1 label="Optional" tone="font-weight: 700" style={styleObject(declarations)} />
  <p
    style={quiet
      ? { color: "rgb(90, 90, 90)" }
      : { color: "var(--notice-accent, rgb(160, 40, 40))", fontWeight: "700" }}
  >This cannot be undone.</p>
  <button type="button" style={vars}>{quiet ? "Emphasise" : "Quieten"}</button>
</div>
