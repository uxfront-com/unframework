---
import type { HTMLAttributes } from "astro/types";

export interface TagProps {
  label: string;
  tone?: string;
}

interface Props extends TagProps, Omit<HTMLAttributes<"em">, "label" | "tone"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, tone: _tone, class: className, style, ...attrs } = Astro.props;
---

<em
  class:list={["tag", className]}
  style={{ color: "rgb(120, 30, 30)", padding: "1px 4px", ...style }}
  {...attrs}
>{label}</em>
