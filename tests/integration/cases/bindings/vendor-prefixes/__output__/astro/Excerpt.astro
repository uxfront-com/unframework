---
import type { HTMLAttributes } from "astro/types";

export interface ExcerptProps {
  title: string;
  text: string;
  fill: string;
  stroke: string;
}

interface Props
  extends ExcerptProps, Omit<HTMLAttributes<"article">, "title" | "text" | "fill" | "stroke"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, text, fill, stroke, class: className, style, ...attrs } = Astro.props;
---

<article class:list={["excerpt", className]} style={style} {...attrs}>
  <h2
    style={{ WebkitTextFillColor: fill, WebkitTextStrokeColor: stroke, WebkitTextStrokeWidth: "1px", color: "rgb(0, 0, 0)" }}
  >{title}</h2>
  <p
    style="display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; width: 240px"
  >{text}</p>
</article>
