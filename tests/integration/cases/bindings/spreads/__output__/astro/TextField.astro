---
interface FieldAttributes {
  name: string;
  placeholder?: string;
  autocomplete?: "email" | "username";
  maxlength?: number;
  required?: boolean;
  title?: string;
}

interface HintAttributes {
  id: string;
  title?: string;
}

export interface TextFieldProps {
  label: string;
  inputId: string;
  hintText: string;
  field: FieldAttributes;
  hint?: HintAttributes;
}

interface Props extends TextFieldProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, inputId, hintText, field, hint, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<div class:list={["text-field", className]} style={style} {...scopeAttributes(Astro.props)}>
  <label for={inputId}>{label}</label>
  <input
    id={inputId}
    type="text"
    name={field.name}
    placeholder={field.placeholder}
    autocomplete={field.autocomplete}
    maxlength={field.maxlength}
    required={field.required}
    title={field.title}
  />
  <p class="text-field-hint" id={hint?.id} title={hint?.title}>{hintText}</p>
</div>
