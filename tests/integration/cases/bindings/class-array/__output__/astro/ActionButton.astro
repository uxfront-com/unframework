---
import type { HTMLAttributes } from "astro/types";

export interface ActionButtonProps {
  label: string;
  size: "small" | "medium" | "large";
  primary: boolean;
  busy?: boolean;
  badge: number;
}

interface Props
  extends
    ActionButtonProps,
    Omit<HTMLAttributes<"button">, "label" | "size" | "primary" | "busy" | "badge"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  label,
  size,
  primary,
  busy = false,
  badge,
  class: className,
  style,
  type,
  ...attrs
} = Astro.props;
---

<button
  type={"type" in Astro.props ? type : "button"}
  class:list={["button", `button-${size}`, { "button-primary": primary, "is-busy": busy, "button-waiting": busy, "has-badge": badge }, primary ? "solid" : "outline", className]}
  style={style}
  {...attrs}
>{label}</button>
