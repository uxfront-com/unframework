---
import { styleObject } from "./_unframework/styleObject";
import type { HTMLAttributes } from "astro/types";

interface HintAttributes {
  id: string;
  style?: string;
}

export interface HintProps {
  text: string;
  attrs: HintAttributes;
}

interface Props extends HintProps, Omit<HTMLAttributes<"small">, "text" | "attrs"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { text, attrs, class: className, style, ...attrs_1 } = Astro.props;
---

<small
  id={attrs.id}
  class:list={[className]}
  style={{ ...styleObject(attrs.style), ...style }}
  {...attrs_1}
>{text}</small>
