---
import Hint from "./Hint.astro";

type PanelLook = {
  borderColor?: string;
  borderStyle?: string;
  borderWidth?: string;
  "--panel-gap"?: string;
};

interface PanelAttributes {
  id: string;
  title?: string;
  style?: PanelLook;
}

interface NoteAttributes {
  title: string;
  style?: string;
}

export interface PanelProps {
  heading: string;
  panel: PanelAttributes;
  note?: NoteAttributes;
}

interface Props extends PanelProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { heading, panel, note, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<div class:list={["panels", className]} style={style} {...scopeAttributes(Astro.props)}>
  <section id={panel.id} title={panel.title} style={panel.style} class="panel">
    <h2 style="margin-bottom: var(--panel-gap, 4px)">{heading}</h2>
    <p title={note?.title} style={note?.style}>Changes save as you type.</p>
    <Hint
      text="Saved a moment ago"
      attrs={{ id: "saved-hint", style: "font-style: italic; color: rgb(90, 90, 90)" }}
      style={{ color: "rgb(30, 90, 60)" }}
    />
  </section>
</div>
