---
export interface CalloutProps {
  heading: string;
  body: string;
}

interface Props extends CalloutProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { heading, body, class: className, style } = Astro.props;
---

<aside
  class:list={["callout", className]}
  aria-label={heading}
  style={{ "--callout-accent": "#1f4d7a", borderLeft: "4px solid var(--callout-accent)", padding: "8px 12px", color: "#1a1a1a", ...style }}
>
  <p style="margin: 0; font-weight: 700">{heading}</p>
  <p style="margin: 4px 0 0">{body}</p>
</aside>
