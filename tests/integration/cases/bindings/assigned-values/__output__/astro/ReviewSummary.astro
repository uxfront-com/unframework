---
import type { HTMLAttributes } from "astro/types";

export interface ReviewSummaryProps {
  steps: string[];
  score: number;
  sku: string;
  product: string;
}

interface Props
  extends
    ReviewSummaryProps,
    Omit<HTMLAttributes<"section">, "steps" | "score" | "sku" | "product"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  steps,
  score,
  sku,
  product,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
---

<section
  class:list={["review-summary", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Review"}
  style={style}
  {...attrs}
>
  <ol>
    {steps.map((step, index) => (
      <li value={index}>{step}</li>
    ))}
  </ol>
  <meter min="0" max="10" value={score} aria-label="Score">{score} out of 10</meter>
  <p>Product: <data value={sku}>{product}</data></p>
</section>
