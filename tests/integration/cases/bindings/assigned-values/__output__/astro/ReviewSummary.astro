---
export interface ReviewSummaryProps {
  steps: string[];
  score: number;
  sku: string;
  product: string;
}

interface Props extends ReviewSummaryProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { steps, score, sku, product, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<section
  class:list={["review-summary", className]}
  aria-label="Review"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <ol>
    {steps.map((step, index) => (
      <li value={index}>{step}</li>
    ))}
  </ol>
  <meter min="0" max="10" value={score} aria-label="Score">{score} out of 10</meter>
  <p>Product: <data value={sku}>{product}</data></p>
</section>
