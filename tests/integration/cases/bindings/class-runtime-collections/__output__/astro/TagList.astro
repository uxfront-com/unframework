---
import type { HTMLAttributes } from "astro/types";

type TagStates = { selected?: boolean; muted?: boolean };

export interface TagListProps {
  label: string;
  tags: string[];
  states: TagStates;
  extra?: string[];
}

interface Props
  extends TagListProps, Omit<HTMLAttributes<"div">, "label" | "tags" | "states" | "extra"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, tags, states, extra, class: className, style, ...attrs } = Astro.props;

const expanded = false as boolean;
---

<div class:list={["tag-list", className]} style={style} {...attrs}>
  <span class:list={["tag", tags, states, { "tag-open": expanded }]}>{label}</span>
  <span class:list={[tags]}>Plain</span>
  <span class:list={[extra, expanded ? ["tag-wide", "tag-tall"] : []]}>Extra</span>
  <button type="button">Expand</button>
</div>
