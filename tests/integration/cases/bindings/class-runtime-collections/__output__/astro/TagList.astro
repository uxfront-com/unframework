---
type TagStates = { selected?: boolean; muted?: boolean };

export interface TagListProps {
  label: string;
  tags: string[];
  states: TagStates;
  extra?: string[];
}

interface Props extends TagListProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, tags, states, extra, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const expanded = false as boolean;
---

<div class:list={["tag-list", className]} style={style} {...scopeAttributes(Astro.props)}>
  <span class:list={["tag", tags, states, { "tag-open": expanded }]}>{label}</span>
  <span class:list={[tags]}>Plain</span>
  <span class:list={[extra, expanded ? ["tag-wide", "tag-tall"] : []]}>Extra</span>
  <button type="button">Expand</button>
</div>
