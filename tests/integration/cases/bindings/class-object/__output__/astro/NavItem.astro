---
export interface NavItemProps {
  label: string;
  href: string;
  active: boolean;
  muted: boolean;
  danger?: boolean;
}

interface Props extends NavItemProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, href, active, muted, danger = false, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<a
  href={href}
  class:list={[{ active, "nav-item-muted": muted, "nav-item-danger": danger, "text-danger": danger }, className]}
  aria-current={active ? "page" : undefined}
  style={style}
  {...scopeAttributes(Astro.props)}
>{label}</a>
