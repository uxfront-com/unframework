---
import type { HTMLAttributes } from "astro/types";

export interface NavItemProps {
  label: string;
  href: string;
  active: boolean;
  muted: boolean;
  danger?: boolean;
}

interface Props
  extends
    NavItemProps,
    Omit<HTMLAttributes<"a">, "label" | "href" | "active" | "muted" | "danger"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  label,
  href,
  active,
  muted,
  danger = false,
  class: className,
  style,
  "aria-current": ariaCurrent,
  ...attrs
} = Astro.props;
---

<a
  href={href}
  class:list={[{ active, "nav-item-muted": muted, "nav-item-danger": danger, "text-danger": danger }, className]}
  aria-current={"aria-current" in Astro.props ? ariaCurrent : active ? "page" : undefined}
  style={style}
  {...attrs}
>{label}</a>
