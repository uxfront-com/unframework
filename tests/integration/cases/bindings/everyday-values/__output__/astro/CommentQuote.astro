---
import type { HTMLAttributes } from "astro/types";

export interface CommentQuoteProps {
  author: string;
  comment: string;
}

interface Props extends CommentQuoteProps, Omit<HTMLAttributes<"figure">, "author" | "comment"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { author, comment, class: className, style, ...attrs } = Astro.props;
---

<figure class:list={["comment-quote", className]} style={style} {...attrs}>
  <blockquote style="margin: 0; padding: 0">
    <p dir="auto">{comment}</p>
  </blockquote>
  <figcaption>{author}</figcaption>
</figure>
