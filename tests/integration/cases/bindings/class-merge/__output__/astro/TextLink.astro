---
interface LinkAttributes {
  class?: string;
  title?: string;
  rel?: string;
}

interface RowAttributes {
  class: string;
  id?: string;
}

export interface TextLinkProps {
  href: string;
  label: string;
  strong: boolean;
  link: LinkAttributes;
  row: RowAttributes;
}

interface Props extends TextLinkProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { href, label, strong, link, row, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<p
  class:list={[row.class, "link-row", { "link-row-strong": strong }, className]}
  id={row.id}
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <a
    href={href}
    class:list={["text-link", link.class]}
    title={link.title}
    rel={link.rel}
  >{label}</a>
</p>
