---
import type { HTMLAttributes } from "astro/types";

export interface SummaryProps {
  name: string;
  plan: string;
  seats: number;
}

interface Props extends SummaryProps, Omit<HTMLAttributes<"div">, "name" | "plan" | "seats"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { name, plan, seats, class: className, style, ...attrs } = Astro.props;
---

<div
  class:list={["summary", className]}
  style={{ display: "table", borderSpacing: "8px 4px", ...style }}
  {...attrs}
>
  <div style="display: table-caption; font-weight: 700">Account</div>
  <div style="display: table-row">
    <span style="display: table-cell">Name</span>
    <span style="display: table-cell">{name}</span>
  </div>
  <div style="display: table-row">
    <span style="display: table-cell">Plan</span>
    <span style="display: table-cell">{plan} for {seats} seats</span>
  </div>
  <p>Billed to <span style="display: table-cell; padding: 0 4px">{name}</span> monthly.</p>
</div>
