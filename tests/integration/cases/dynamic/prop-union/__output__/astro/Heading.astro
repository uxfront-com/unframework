---
import { scopeAttributes } from "./_unframework/scopeAttributes";

interface Props {
  tag: "h1" | "h2" | "h3";
  text: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { tag, text, class: className, style } = Astro.props;

const Tag = tag;
---

<Tag
  class:list={["heading", className]}
  style={style}
  {...scopeAttributes(Astro.props)}
>{text}</Tag>
