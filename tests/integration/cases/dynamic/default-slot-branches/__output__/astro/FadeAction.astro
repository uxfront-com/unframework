---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"a"> & HTMLAttributes<"button">, "href" | "label"> {
  href?: string;
  label: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { href, label, class: className, style, ...attrs } = Astro.props;

const Tag = href ? "a" : "button";
---

<Tag href={Tag === "a" ? href : undefined} class:list={[className]} style={style} {...attrs}>
  <span>
    <slot>{label}</slot>
  </span>
</Tag>
