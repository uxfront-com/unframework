{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Show tips' })",
      "dom": [
        "<section class=\"page\">",
        "  <a href=\"#docs\">",
        "    <span>",
        "      \"Read the docs\"",
        "    </span>",
        "  </a>",
        "  <button>",
        "    <span>",
        "      \"Save the draft\"",
        "    </span>",
        "  </button>",
        "  <a href=\"#home\">",
        "    <span>",
        "      \"Home\"",
        "    </span>",
        "  </a>",
        "  <button>",
        "    <span>",
        "      \"Close\"",
        "    </span>",
        "  </button>",
        "  <a href=\"#guide\">",
        "    <span>",
        "      \"Read the guide\"",
        "    </span>",
        "  </a>",
        "  <button>",
        "    <span>",
        "      \"Send the draft\"",
        "    </span>",
        "  </button>",
        "  <a href=\"#blog\">",
        "    <span>",
        "      \"Blog\"",
        "    </span>",
        "  </a>",
        "  <button>",
        "    <span>",
        "      \"Undo\"",
        "    </span>",
        "  </button>",
        "  <a href=\"#faq\">",
        "    <span>",
        "      \"Read the FAQ\"",
        "    </span>",
        "  </a>",
        "  <button>",
        "    <span>",
        "      \"Print the draft\"",
        "    </span>",
        "  </button>",
        "  <a href=\"#news\">",
        "    <span>",
        "      \"News\"",
        "    </span>",
        "  </a>",
        "  <button>",
        "    <span>",
        "      \"Reset\"",
        "    </span>",
        "  </button>",
        "  <a href=\"#more\">",
        "    <b>",
        "      \"Learn more\"",
        "    </b>",
        "  </a>",
        "  <p class=\"emphasis\">",
        "    <b>",
        "      \"Mind the gap\"",
        "    </b>",
        "  </p>",
        "  <p class=\"greeting\">",
        "    <b>",
        "      \"Welcome back\"",
        "    </b>",
        "  </p>",
        "  <p class=\"greeting\">",
        "    <b>",
        "      \"Grace\"",
        "    </b>",
        "  </p>",
        "  <p class=\"greeting\">",
        "    <i>",
        "      \"Guest\"",
        "    </i>",
        "  </p>",
        "  <div class=\"tips\">",
        "    <a href=\"#tips\">",
        "      \"Tips\"",
        "    </a>",
        "    <button>",
        "      \"Help\"",
        "    </button>",
        "    <a href=\"#about\">",
        "      \"About\"",
        "    </a>",
        "    <button>",
        "      \"Hint\"",
        "    </button>",
        "  </div>",
        "  <button type=\"button\">",
        "    \"Toggle link\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Toggle emphasis\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Toggle user\"",
        "  </button>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Show tips\"",
        "  </button>",
        "</section>",
        "<uf:teleported>",
        "  <p class=\"tip\" data-teleported=\"true\" role=\"note\">",
        "    \"Linked tip\"",
        "  </p>",
        "</uf:teleported>",
        "<uf:teleported>",
        "  <p class=\"tip\" data-teleported=\"true\" role=\"note\">",
        "    \"Button tip\"",
        "  </p>",
        "</uf:teleported>",
        "<uf:teleported>",
        "  <p class=\"tip\" data-teleported=\"true\" role=\"note\">",
        "    \"About\"",
        "  </p>",
        "</uf:teleported>",
        "<uf:teleported>",
        "  <p class=\"tip\" data-teleported=\"true\" role=\"note\">",
        "    \"Hint\"",
        "  </p>",
        "</uf:teleported>"
      ],
      "aria": [
        "- link \"Read the docs\":",
        "  - /url: \"#docs\"",
        "- button \"Save the draft\"",
        "- link \"Home\":",
        "  - /url: \"#home\"",
        "- button \"Close\"",
        "- link \"Read the guide\":",
        "  - /url: \"#guide\"",
        "- button \"Send the draft\"",
        "- link \"Blog\":",
        "  - /url: \"#blog\"",
        "- button \"Undo\"",
        "- link \"Read the FAQ\":",
        "  - /url: \"#faq\"",
        "- button \"Print the draft\"",
        "- link \"News\":",
        "  - /url: \"#news\"",
        "- button \"Reset\"",
        "- link \"Learn more\":",
        "  - /url: \"#more\"",
        "- paragraph: Mind the gap",
        "- paragraph: Welcome back",
        "- paragraph: Grace",
        "- paragraph: Guest",
        "- link \"Tips\":",
        "  - /url: \"#tips\"",
        "- button \"Help\"",
        "- link \"About\":",
        "  - /url: \"#about\"",
        "- button \"Hint\"",
        "- button \"Toggle link\"",
        "- button \"Toggle emphasis\"",
        "- button \"Toggle user\"",
        "- button \"Show tips\"",
        "- note: Linked tip",
        "- note: Button tip",
        "- note: About",
        "- note: Hint"
      ],
      "events": {}
    }
  ]
}
