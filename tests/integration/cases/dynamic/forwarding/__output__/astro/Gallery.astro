---
import Frame from "./Frame.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, ...attrs } = Astro.props;
---

<div class:list={[className]} style={style} {...attrs}>
  <Frame label="Card" wide={false}>
    <Fragment slot="title">Sunset</Fragment>
  </Frame>
  <Frame label="Panel" wide={true}>
    <Fragment slot="title">Dawn</Fragment>
  </Frame>
  <Frame label="Empty" wide={true} />
</div>
