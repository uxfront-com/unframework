---
import Card from "./Card.astro";
import Panel from "./Panel.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "label" | "wide"> {
  label: string;
  wide: boolean;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, wide, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const Tag = wide ? Panel : Card;
---

<section
  class:list={["frame", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : label}
  style={style}
  {...attrs}
>
  {Astro.slots.has("title") ? (
    <>
      <Tag>
        <slot name="title" slot="title" />
      </Tag>
    </>
  ) : (
    <>
      <Tag />
    </>
  )}
</section>
