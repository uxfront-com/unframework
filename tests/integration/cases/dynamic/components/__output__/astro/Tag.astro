---
import Card from "./Card.astro";
import Chip from "./Chip.astro";

interface Props {
  label: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const compact = true as boolean;

const Tag_1 = compact ? Chip : Card;
---

<section aria-label="Tag" class:list={[className]} style={style} {...scopeAttributes(Astro.props)}>
  <Tag_1 label={label} />
  <button type="button">{compact ? "Expand" : "Compact"}</button>
</section>
