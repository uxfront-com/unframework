---
import Card from "./Card.astro";
import Chip from "./Chip.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "label"> {
  label: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const compact = true as boolean;

const Tag_1 = compact ? Chip : Card;
---

<section
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Tag"}
  class:list={[className]}
  style={style}
  {...attrs}
>
  <Tag_1 label={label} />
  <button type="button">{compact ? "Expand" : "Compact"}</button>
</section>
