---
import Card from "./Card.astro";
import Chip from "./Chip.astro";

interface Props {
  label: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, class: className, style } = Astro.props;

const compact = true as boolean;

const Tag_1 = compact ? Chip : Card;
---

<section aria-label="Tag" class:list={[className]} style={style}>
  <Tag_1 label={label} />
  <button type="button">{compact ? "Expand" : "Compact"}</button>
</section>
