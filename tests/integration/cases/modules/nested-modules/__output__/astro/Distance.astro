---
import { formatDistance } from "./format";
import type { Unit } from "./units";

interface Props {
  value: number;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { value, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const unit = "km" as Unit;
---

<section
  class:list={["distance", className]}
  aria-label="Distance"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <p role="status">{formatDistance(value, unit)}</p>
  <button type="button">Switch units</button>
</section>
