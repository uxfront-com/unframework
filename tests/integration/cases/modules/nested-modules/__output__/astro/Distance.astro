---
import { formatDistance } from "./format";
import type { Unit } from "./units";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "value"> {
  value: number;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { value, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const unit = "km" as Unit;
---

<section
  class:list={["distance", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Distance"}
  style={style}
  {...attrs}
>
  <p role="status">{formatDistance(value, unit)}</p>
  <button type="button">Switch units</button>
</section>
