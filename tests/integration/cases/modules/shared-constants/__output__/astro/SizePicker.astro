---
import { DEFAULT_SIZE, SIZES, SIZE_ORDER, type Size } from "./tokens";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"fieldset"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, ...attrs } = Astro.props;

const size = DEFAULT_SIZE as Size;
---

<fieldset class:list={["size-picker", className]} style={style} {...attrs}>
  <legend>Size</legend>
  <p role="status">Picked: {SIZES[size]}</p>
  <ul>
    {SIZE_ORDER.map((each) => (
      <li>
        <button type="button" aria-pressed={size === each}>{SIZES[each]}</button>
      </li>
    ))}
  </ul>
</fieldset>
