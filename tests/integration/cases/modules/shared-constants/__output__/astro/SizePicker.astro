---
import { DEFAULT_SIZE, SIZES, SIZE_ORDER, type Size } from "./tokens";

interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const size = DEFAULT_SIZE as Size;
---

<fieldset class:list={["size-picker", className]} style={style} {...scopeAttributes(Astro.props)}>
  <legend>Size</legend>
  <p role="status">Picked: {SIZES[size]}</p>
  <ul>
    {SIZE_ORDER.map((each) => (
      <li>
        <button type="button" aria-pressed={size === each}>{SIZES[each]}</button>
      </li>
    ))}
  </ul>
</fieldset>
