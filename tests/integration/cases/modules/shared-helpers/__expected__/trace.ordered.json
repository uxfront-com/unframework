{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'One more' })",
      "dom": [
        "<section aria-label=\"Price\" class=\"price-tag\">",
        "  <p>",
        "    \"Each: €2.50\"",
        "  </p>",
        "  <p role=\"status\">",
        "    \"2 items: €5.00\"",
        "  </p>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"One more\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Order\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Price\":",
        "  - paragraph: \"Each: €2.50\"",
        "  - status: \"2 items: €5.00\"",
        "  - button \"One more\"",
        "  - button \"Order\""
      ],
      "events": {}
    },
    {
      "action": "click getByRole('button', { name: 'Order' })",
      "dom": [
        "<section aria-label=\"Price\" class=\"price-tag\">",
        "  <p>",
        "    \"Each: €2.50\"",
        "  </p>",
        "  <p role=\"status\">",
        "    \"2 items: €5.00\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"One more\"",
        "  </button>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Order\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Price\":",
        "  - paragraph: \"Each: €2.50\"",
        "  - status: \"2 items: €5.00\"",
        "  - button \"One more\"",
        "  - button \"Order\""
      ],
      "events": {
        "order": [
          [
            "2 items for €5.00"
          ]
        ]
      }
    }
  ]
}
