{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Add 5' })",
      "dom": [
        "<section aria-label=\"Stepper\" class=\"stepper\">",
        "  <p role=\"status\">",
        "    \"7 of 20\"",
        "  </p>",
        "  <ul>",
        "    <li>",
        "      <button type=\"button\">",
        "        \"Add 1\"",
        "      </button>",
        "    </li>",
        "    <li>",
        "      <button type=\"button\" uf:focused=\"\">",
        "        \"Add 5\"",
        "      </button>",
        "    </li>",
        "    <li>",
        "      <button type=\"button\">",
        "        \"Add 10\"",
        "      </button>",
        "    </li>",
        "  </ul>",
        "</section>"
      ],
      "aria": [
        "- region \"Stepper\":",
        "  - status: 7 of 20",
        "  - list:",
        "    - listitem:",
        "      - button \"Add 1\"",
        "    - listitem:",
        "      - button \"Add 5\"",
        "    - listitem:",
        "      - button \"Add 10\""
      ],
      "events": {}
    }
  ]
}
