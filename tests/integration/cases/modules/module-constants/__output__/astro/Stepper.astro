---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const STEPS = [1, 5, 10] as const;
const LIMITS = Object.freeze({ min: 0, max: 20 });
const caption = (value: number): string => `${value} of ${LIMITS.max}`;
const START = LIMITS.min + 2;

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const value = START;
---

<section
  class:list={["stepper", className]}
  aria-label="Stepper"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <p role="status">{caption(value)}</p>
  <ul>
    {STEPS.map((step) => (
      <li>
        <button type="button">Add {step}</button>
      </li>
    ))}
  </ul>
</section>
