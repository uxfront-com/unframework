---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const STEPS = [1, 5, 10] as const;
const LIMITS = Object.freeze({ min: 0, max: 20 });
const caption = (value: number): string => `${value} of ${LIMITS.max}`;
const START = LIMITS.min + 2;

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const value = START;
---

<section
  class:list={["stepper", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Stepper"}
  style={style}
  {...attrs}
>
  <p role="status">{caption(value)}</p>
  <ul>
    {STEPS.map((step) => (
      <li>
        <button type="button">Add {step}</button>
      </li>
    ))}
  </ul>
</section>
