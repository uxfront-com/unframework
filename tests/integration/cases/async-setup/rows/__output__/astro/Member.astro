---
import { loadUser } from "./api";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"li">, "id"> {
  id: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { id, class: className, style, ...attrs } = Astro.props;

const user = await loadUser(id);
---

<li class:list={["member", className]} style={style} {...attrs}>{user.name}</li>
