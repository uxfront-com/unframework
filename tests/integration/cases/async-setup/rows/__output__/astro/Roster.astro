---
import Member from "./Member.astro";

interface Props {
  ids: string[];
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { ids, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const lead = true as boolean;
const guest = false as boolean;
---

<section
  class:list={["roster", className]}
  aria-label="Roster"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <button type="button">Switch lead</button>
  <button type="button">Toggle guest</button>
  <ul>
    {ids.map((id) => (
      <Member id={id} />
    ))}
    {lead ? (
      <Member id="ada" />
    ) : (
      <Member id="linus" />
    )}
    {guest ? (
      <Member id="hopper" />
    ) : null}
  </ul>
</section>
