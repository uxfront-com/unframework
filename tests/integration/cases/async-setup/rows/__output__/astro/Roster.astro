---
import Member from "./Member.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "ids"> {
  ids: string[];
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { ids, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const lead = true as boolean;
const guest = false as boolean;
---

<section
  class:list={["roster", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Roster"}
  style={style}
  {...attrs}
>
  <button type="button">Switch lead</button>
  <button type="button">Toggle guest</button>
  <ul>
    {ids.map((id) => (
      <Member id={id} />
    ))}
    {lead ? (
      <Member id="ada" />
    ) : (
      <Member id="linus" />
    )}
    {guest ? (
      <Member id="hopper" />
    ) : null}
  </ul>
</section>
