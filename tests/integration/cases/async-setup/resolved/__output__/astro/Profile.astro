---
import { loadUser } from "./api";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"p">, "id"> {
  id: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { id, class: className, style, ...attrs } = Astro.props;

const user = await loadUser(id);
const visits = user.visits;
---

<p
  class:list={["profile", className]}
  style={style}
  {...attrs}
>{user.name} <button type="button">Visits: {visits}</button></p>
