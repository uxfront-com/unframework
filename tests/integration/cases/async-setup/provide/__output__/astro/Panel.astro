---
import Badge from "./Badge.astro";
import { loadUser } from "./api";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "id"> {
  id: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { id, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const user = await loadUser(id);
---

<section
  class:list={["panel", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : user.name}
  style={style}
  {...attrs}
>
  <Badge />
  <slot />
</section>
