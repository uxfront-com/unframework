{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'User ada visits: 3' })",
      "dom": [
        "<section aria-label=\"Team\" class=\"team\">",
        "  <h2>",
        "    \"Team\"",
        "  </h2>",
        "  <button type=\"button\">",
        "    \"Reset\"",
        "  </button>",
        "  <article class=\"member\">",
        "    <h3>",
        "      \"User ada\"",
        "    </h3>",
        "    <button type=\"button\" uf:focused=\"\">",
        "      \"User ada visits: 4\"",
        "    </button>",
        "  </article>",
        "  <ul>",
        "    <li>",
        "      <article class=\"member\">",
        "        <h3>",
        "          \"User grace\"",
        "        </h3>",
        "        <button type=\"button\">",
        "          \"User grace visits: 5\"",
        "        </button>",
        "      </article>",
        "    </li>",
        "    <li>",
        "      <article class=\"member\">",
        "        <h3>",
        "          \"User linus\"",
        "        </h3>",
        "        <button type=\"button\">",
        "          \"User linus visits: 5\"",
        "        </button>",
        "      </article>",
        "    </li>",
        "  </ul>",
        "  <article class=\"lead member\">",
        "    <h3>",
        "      \"User hopper\"",
        "    </h3>",
        "    <button type=\"button\">",
        "      \"User hopper visits: 6\"",
        "    </button>",
        "  </article>",
        "</section>"
      ],
      "aria": [
        "- region \"Team\":",
        "  - heading \"Team\" [level=2]",
        "  - button \"Reset\"",
        "  - article:",
        "    - heading \"User ada\" [level=3]",
        "    - 'button \"User ada visits: 4\"'",
        "  - list:",
        "    - listitem:",
        "      - article:",
        "        - heading \"User grace\" [level=3]",
        "        - 'button \"User grace visits: 5\"'",
        "    - listitem:",
        "      - article:",
        "        - heading \"User linus\" [level=3]",
        "        - 'button \"User linus visits: 5\"'",
        "  - article:",
        "    - heading \"User hopper\" [level=3]",
        "    - 'button \"User hopper visits: 6\"'"
      ],
      "events": {}
    }
  ]
}
