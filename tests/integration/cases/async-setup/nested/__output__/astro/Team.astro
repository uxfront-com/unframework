---
import Lead from "./Lead.astro";
import Member from "./Member.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "ids"> {
  ids: string[];
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { ids, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;
---

<section
  class:list={["team", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Team"}
  style={style}
  {...attrs}
>
  <h2>Team</h2>
  <button type="button">Reset</button>
  <Member id="ada" />
  <ul>
    {ids.map((id) => (
      <li>
        <Member id={id} />
      </li>
    ))}
  </ul>
  <Lead class="lead" id="hopper" />
</section>
