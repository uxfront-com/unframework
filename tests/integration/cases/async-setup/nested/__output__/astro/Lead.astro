---
import Member from "./Member.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"article">, "id"> {
  id: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { id, class: className, style, ...attrs } = Astro.props;
---

<Member id={id} class:list={[className]} style={style} {...attrs} />
