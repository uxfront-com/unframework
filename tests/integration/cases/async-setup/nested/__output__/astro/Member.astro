---
import { loadUser } from "./api";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"article">, "id"> {
  id: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { id, class: className, style, ...attrs } = Astro.props;

const user = await loadUser(id);
const visits = user.visits;
---

<article class:list={["member", className]} style={style} {...attrs}>
  <h3>{user.name}</h3>
  <button type="button">{user.name} visits: {visits}</button>
</article>
