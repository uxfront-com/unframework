---
import { loadUser } from "./api";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"form">, "id"> {
  id: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { id, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const user = await loadUser(id);
---

<form
  class:list={["note", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Note"}
  style={style}
  {...attrs}
>
  <label>Note for {user.name} <input type="text" /></label>
</form>
