---
export interface CounterProps {
  initial?: number;
  step?: number;
}

type Props = CounterProps;

const { initial = 0, step = 1 } = Astro.props;

const count = initial;
const doubled = count * 2;
---

<div class="counter">
  <output>{count}</output>
  {doubled > 10 ? (
    <span>Big</span>
  ) : null}
  <button type="button">+{step}</button>
</div>
