---
export interface CounterProps {
  initial?: number;
  step?: number;
}

interface Props extends CounterProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { initial = 0, step = 1, class: className, style } = Astro.props;

const count = initial;
const doubled = count * 2;
---

<div class:list={["counter", className]} style={style}>
  <output>{count}</output>
  {doubled > 10 ? (
    <span>Big</span>
  ) : null}
  <button type="button">+{step}</button>
</div>
