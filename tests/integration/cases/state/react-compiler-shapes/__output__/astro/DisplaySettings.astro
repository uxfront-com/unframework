---
export interface Settings {
  theme: string;
  size: number;
}

interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const settings = { theme: "light", size: 14 } as Settings;
const saving = false as boolean;
const label = "Never saved" as string;
const failure = "" as string;
---

<section
  class:list={["display-settings", className]}
  aria-label="Display"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <p role="status">Theme {settings.theme}, size {settings.size}</p>
  <button type="button">Dark</button>
  <button type="button">Larger</button>
  <button type="button">Allow up to 30</button>
  <button type="button">Save</button>
  <p>{saving ? "Saving" : failure === "" ? label : `Failed: ${failure}`}</p>
  <div role="group" aria-label="Server">
    <button type="button">Reply with an id</button>
    <button type="button">Reply as a draft</button>
    <button type="button">Reply with an error</button>
  </div>
</section>
