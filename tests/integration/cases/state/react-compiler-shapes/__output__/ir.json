            "body": {
              "code": "{\n    saving.value = true;\n    failure.value = \"\";\n    try {\n      const reply = await new Promise<SaveReply>((resolve) => {\n        finish = resolve;\n      });\n      if (reply.error) throw new Error(reply.error);\n      const id = reply.id ?? 0;\n      label.value = id === 0 ? \"Saved as a draft\" : `Saved as #${id}`;\n      emit(\"saved\", id);\n    } catch (error) {\n      failure.value = error instanceof Error ? error.message : \"Saving failed\";\n    } finally {\n      saving.value = false;\n    }\n  }",
