---
import type { HTMLAttributes } from "astro/types";

export interface Fruit {
  name: string;
  colour: string;
}

export interface FruitPickerProps {
  fruits: Fruit[];
}

interface Props extends FruitPickerProps, Omit<HTMLAttributes<"section">, "fruits"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { fruits, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const selected = null as Fruit | null;
const basket = [] as Fruit[];
---

<section
  class:list={["fruit-picker", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Fruit"}
  style={style}
  {...attrs}
>
  <ul aria-label="Fruits">
    {fruits.map((fruit) => (
      <li>
        <button type="button" aria-pressed={fruit === selected}>{fruit.name}</button>
      </li>
    ))}
  </ul>
  <button type="button">Keep a copy</button>
  <ol aria-label="Basket">
    {basket.map((fruit) => (
      <li>{`${fruit.name} (${fruit.colour})`}</li>
    ))}
  </ol>
</section>
