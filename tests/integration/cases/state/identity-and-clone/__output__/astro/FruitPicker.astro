---
export interface Fruit {
  name: string;
  colour: string;
}

export interface FruitPickerProps {
  fruits: Fruit[];
}

interface Props extends FruitPickerProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { fruits, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const selected = null as Fruit | null;
const basket = [] as Fruit[];
---

<section
  class:list={["fruit-picker", className]}
  aria-label="Fruit"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <ul aria-label="Fruits">
    {fruits.map((fruit) => (
      <li>
        <button type="button" aria-pressed={fruit === selected}>{fruit.name}</button>
      </li>
    ))}
  </ul>
  <button type="button">Keep a copy</button>
  <ol aria-label="Basket">
    {basket.map((fruit) => (
      <li>{`${fruit.name} (${fruit.colour})`}</li>
    ))}
  </ol>
</section>
