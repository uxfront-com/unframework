{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Pear' })",
      "dom": [
        "<section aria-label=\"Fruit\" class=\"fruit-picker\">",
        "  <ul aria-label=\"Fruits\">",
        "    <li>",
        "      <button aria-pressed=\"false\" type=\"button\">",
        "        \"Apple\"",
        "      </button>",
        "    </li>",
        "    <li>",
        "      <button aria-pressed=\"true\" type=\"button\" uf:focused=\"\">",
        "        \"Pear\"",
        "      </button>",
        "    </li>",
        "  </ul>",
        "  <button type=\"button\">",
        "    \"Keep a copy\"",
        "  </button>",
        "  <ol aria-label=\"Basket\"></ol>",
        "</section>"
      ],
      "aria": [
        "- region \"Fruit\":",
        "  - list \"Fruits\":",
        "    - listitem:",
        "      - button \"Apple\"",
        "    - listitem:",
        "      - button \"Pear\" [pressed]",
        "  - button \"Keep a copy\"",
        "  - list \"Basket\""
      ],
      "events": {}
    }
  ]
}
