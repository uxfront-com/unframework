---
export interface PriceTagProps {
  /** The unit price, in cents. */
  price: number;
}

interface Props extends PriceTagProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { price, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const quantity = 1 as number;
const unit = formatCents(price);
const summary = describe();
const total = formatCents(price * quantity);
const last = "none" as string;

function formatCents(cents: number): string {
  return `EUR ${(cents / 100).toFixed(2)}`;
}

function describe(): string {
  return `${quantity} at ${formatCents(price)}`;
}
---

<section
  class:list={["price-tag", className]}
  aria-label="Price"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <p>Unit: {unit}</p>
  <p role="status">{summary}</p>
  <p>Total: {total}</p>
  <p>Last change: {last}</p>
  <button type="button">Add one</button>
  <button type="button">Price two</button>
</section>
