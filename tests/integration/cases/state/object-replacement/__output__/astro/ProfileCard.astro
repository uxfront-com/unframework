---
export interface Profile {
  name: string;
  title: string;
  available: boolean;
}

export interface ProfileCardProps {
  initial: Profile;
}

interface Props extends ProfileCardProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { initial, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const profile = initial;
---

<article
  class:list={["profile-card", className]}
  aria-label="Profile"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <h2>{profile.name}</h2>
  <p>{profile.title}</p>
  <p role="status">{profile.available ? "Available" : "Away"}</p>
  <button type="button">Use married name</button>
  <button type="button" aria-pressed={profile.available}>Available</button>
</article>
