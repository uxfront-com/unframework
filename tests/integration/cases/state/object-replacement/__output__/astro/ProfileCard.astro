---
import type { HTMLAttributes } from "astro/types";

export interface Profile {
  name: string;
  title: string;
  available: boolean;
}

export interface ProfileCardProps {
  initial: Profile;
}

interface Props extends ProfileCardProps, Omit<HTMLAttributes<"article">, "initial"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { initial, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const profile = initial;
---

<article
  class:list={["profile-card", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Profile"}
  style={style}
  {...attrs}
>
  <h2>{profile.name}</h2>
  <p>{profile.title}</p>
  <p role="status">{profile.available ? "Available" : "Away"}</p>
  <button type="button">Use married name</button>
  <button type="button" aria-pressed={profile.available}>Available</button>
</article>
