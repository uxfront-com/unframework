---
export type ShippingMethod = "standard" | "express";

export interface CheckoutTotalProps {
  /** The order's subtotal, in cents. */
  subtotal: number;
}

type Props = CheckoutTotalProps;

const { subtotal } = Astro.props;

const rates = { standard: 0, express: 1200 };

function formatCents(cents: number): string {
  return `EUR ${(cents / 100).toFixed(2)}`;
}

const method = "standard" as ShippingMethod;
const shipping = rates[method];
const total = formatCents(subtotal + shipping);
---

<section class="checkout-total" aria-label="Order total">
  <p>Subtotal: {formatCents(subtotal)}</p>
  <p>Shipping: {formatCents(shipping)}</p>
  <p role="status">Total: {total}</p>
  <button type="button" aria-pressed={method === "standard"}>Standard shipping</button>
  <button type="button" aria-pressed={method === "express"}>Express shipping</button>
</section>
