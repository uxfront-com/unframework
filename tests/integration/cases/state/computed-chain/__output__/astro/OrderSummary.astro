---
export interface OrderSummaryProps {
  /** The unit price, in cents. */
  price: number;
  taxRate: number;
}

interface Props extends OrderSummaryProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { price, taxRate, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const quantity = 1 as number;
const subtotal = quantity * price;
const tax = Math.round(subtotal * taxRate);
const total = subtotal + tax;

function getTier() {
  if (total >= 10000) return "bulk";
  return "standard";
}

const tier = getTier();
---

<section
  class:list={["order-summary", className]}
  aria-label="Order summary"
  data-tier={tier}
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <p role="status">Quantity: {quantity}</p>
  <button type="button" disabled={quantity === 1}>Remove one</button>
  <button type="button">Add one</button>
  <p>Subtotal: {(subtotal / 100).toFixed(2)}</p>
  <p>Tax: {(tax / 100).toFixed(2)}</p>
  <p>Total: {(total / 100).toFixed(2)}</p>
</section>
