---
import type { HTMLAttributes } from "astro/types";

export interface OrderSummaryProps {
  /** The unit price, in cents. */
  price: number;
  taxRate: number;
}

interface Props extends OrderSummaryProps, Omit<HTMLAttributes<"section">, "price" | "taxRate"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  price,
  taxRate,
  class: className,
  style,
  "aria-label": ariaLabel,
  "data-tier": dataTier,
  ...attrs
} = Astro.props;

const quantity = 1 as number;
const subtotal = quantity * price;
const tax = Math.round(subtotal * taxRate);
const total = subtotal + tax;

function getTier() {
  if (total >= 10000) return "bulk";
  return "standard";
}

const tier = getTier();
---

<section
  class:list={["order-summary", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Order summary"}
  data-tier={"data-tier" in Astro.props ? dataTier : tier}
  style={style}
  {...attrs}
>
  <p role="status">Quantity: {quantity}</p>
  <button type="button" disabled={quantity === 1}>Remove one</button>
  <button type="button">Add one</button>
  <p>Subtotal: {(subtotal / 100).toFixed(2)}</p>
  <p>Tax: {(tax / 100).toFixed(2)}</p>
  <p>Total: {(total / 100).toFixed(2)}</p>
</section>
