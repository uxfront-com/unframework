{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Grace' })",
      "dom": [
        "<section aria-label=\"Invite\" class=\"team-invite\">",
        "  <h2>",
        "    \"Invite as Ada\"",
        "  </h2>",
        "  <ul aria-label=\"Members\">",
        "    <li>",
        "      <button aria-pressed=\"true\" type=\"button\" uf:focused=\"\">",
        "        \"Grace\"",
        "      </button>",
        "    </li>",
        "    <li>",
        "      <button aria-pressed=\"false\" type=\"button\">",
        "        \"Alan\"",
        "      </button>",
        "    </li>",
        "  </ul>",
        "  <div aria-label=\"Pages\" class=\"pager\" role=\"group\">",
        "    <span>",
        "      \"Page 1 of 2\"",
        "    </span>",
        "    <button type=\"button\">",
        "      \"Next\"",
        "    </button>",
        "  </div>",
        "  <p role=\"status\">",
        "    \"Selected: Grace\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Invite\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Remove\"",
        "  </button>",
        "  <form aria-label=\"Email invite\">",
        "    <label>",
        "      \"Email\"",
        "      <input name=\"email\" type=\"email\" uf:value=\"\">",
        "    </label>",
        "    <button type=\"submit\">",
        "      \"Send\"",
        "    </button>",
        "  </form>",
        "  <button type=\"button\">",
        "    \"Tag as team\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Use a link\"",
        "  </button>",
        "  <div class=\"field\">",
        "    <input aria-label=\"Password\" type=\"password\" uf:value=\"\">",
        "  </div>",
        "  <button type=\"button\">",
        "    \"Start the clock\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Stop the clock\"",
        "  </button>",
        "  <p>",
        "    \"Seconds: 0\"",
        "  </p>",
        "</section>"
      ],
      "aria": [
        "- region \"Invite\":",
        "  - heading \"Invite as Ada\" [level=2]",
        "  - list \"Members\":",
        "    - listitem:",
        "      - button \"Grace\" [pressed]",
        "    - listitem:",
        "      - button \"Alan\"",
        "  - group \"Pages\":",
        "    - text: Page 1 of 2",
        "    - button \"Next\"",
        "  - status: \"Selected: Grace\"",
        "  - button \"Invite\"",
        "  - button \"Remove\"",
        "  - form \"Email invite\":",
        "    - text: Email",
        "    - textbox \"Email\"",
        "    - button \"Send\"",
        "  - button \"Tag as team\"",
        "  - button \"Use a link\"",
        "  - textbox \"Password\"",
        "  - button \"Start the clock\"",
        "  - button \"Stop the clock\"",
        "  - paragraph: \"Seconds: 0\""
      ],
      "events": {}
    },
