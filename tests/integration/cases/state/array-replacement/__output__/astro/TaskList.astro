---
export interface Task {
  id: string;
  label: string;
}

export interface TaskListProps {
  initial: Task[];
}

interface Props extends TaskListProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { initial, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const tasks = initial;
const selected = undefined as string | undefined;
---

<section
  class:list={["task-list", className]}
  aria-label="Tasks"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  {tasks.length === 0 ? (
    <p>No tasks yet.</p>
  ) : (
    <ul>
      {tasks.map((task) => (
        <li>
          <button type="button" aria-pressed={selected === task.id}>{task.label}</button>
          <button type="button" aria-label={`Remove ${task.label}`}>Remove</button>
        </li>
      ))}
    </ul>
  )}
  <button type="button">Add task</button>
  <button type="button">Move up</button>
</section>
