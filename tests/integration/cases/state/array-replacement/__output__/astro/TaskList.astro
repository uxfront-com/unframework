---
import type { HTMLAttributes } from "astro/types";

export interface Task {
  id: string;
  label: string;
}

export interface TaskListProps {
  initial: Task[];
}

interface Props extends TaskListProps, Omit<HTMLAttributes<"section">, "initial"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { initial, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const tasks = initial;
const selected = undefined as string | undefined;
---

<section
  class:list={["task-list", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Tasks"}
  style={style}
  {...attrs}
>
  {tasks.length === 0 ? (
    <p>No tasks yet.</p>
  ) : (
    <ul>
      {tasks.map((task) => (
        <li>
          <button type="button" aria-pressed={selected === task.id}>{task.label}</button>
          <button type="button" aria-label={`Remove ${task.label}`}>Remove</button>
        </li>
      ))}
    </ul>
  )}
  <button type="button">Add task</button>
  <button type="button">Move up</button>
</section>
