{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Clear Red' })",
      "dom": [
        "<section aria-label=\"Filters\" class=\"filter-panel\">",
        "  <button aria-expanded=\"true\" type=\"button\">",
        "    \"Hide colours\"",
        "  </button>",
        "  <div class=\"colours\">",
        "    <button type=\"button\">",
        "      \"Red\"",
        "    </button>",
        "    <button type=\"button\">",
        "      \"Blue\"",
        "    </button>",
        "    <button type=\"button\">",
        "      \"Reset\"",
        "    </button>",
        "  </div>",
        "  <p>",
        "    \"No colour\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Add a note\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Filters\":",
        "  - button \"Hide colours\" [expanded]",
        "  - button \"Red\"",
        "  - button \"Blue\"",
        "  - button \"Reset\"",
        "  - paragraph: No colour",
        "  - button \"Add a note\""
      ],
      "events": {}
    }
  ]
}
