{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Blue' })",
      "dom": [
        "<section aria-label=\"Filters\" class=\"filter-panel\">",
        "  <button aria-expanded=\"true\" type=\"button\">",
        "    \"Hide colours\"",
        "  </button>",
        "  <div class=\"colours\">",
        "    <button type=\"button\">",
        "      \"Red\"",
        "    </button>",
        "    <button type=\"button\" uf:focused=\"\">",
        "      \"Blue\"",
        "    </button>",
        "    <button type=\"button\">",
        "      \"Reset\"",
        "    </button>",
        "  </div>",
        "  <div class=\"selection\">",
        "    <p>",
        "      \"Colour: Blue\"",
        "    </p>",
        "    <button type=\"button\">",
        "      \"Clear Blue\"",
        "    </button>",
        "  </div>",
        "  <button type=\"button\">",
        "    \"Add a note\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Filters\":",
        "  - button \"Hide colours\" [expanded]",
        "  - button \"Red\"",
        "  - button \"Blue\"",
        "  - button \"Reset\"",
        "  - paragraph: \"Colour: Blue\"",
        "  - button \"Clear Blue\"",
        "  - button \"Add a note\""
      ],
      "events": {}
    }
  ]
}
