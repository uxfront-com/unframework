---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const open = false as boolean;
const colour = null as string | null;
const note = null as string | null;
---

<section
  class:list={["filter-panel", className]}
  aria-label="Filters"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  {open ? (
    <button type="button" aria-expanded="true">Hide colours</button>
  ) : (
    <button type="button" aria-expanded="false">Show colours</button>
  )}
  {open ? (
    <div class="colours">
      <button type="button">Red</button>
      <button type="button">Blue</button>
      <button type="button">Reset</button>
    </div>
  ) : null}
  {colour ? (
    <div class="selection">
      <p>{`Colour: ${colour}`}</p>
      <button type="button">{`Clear ${colour}`}</button>
    </div>
  ) : (
    <p>No colour</p>
  )}
  {note === null ? (
    <button type="button">Add a note</button>
  ) : (
    <div class="note">
      <label>Note<input /></label>
      <p>{`Draft: "${note}"`}</p>
    </div>
  )}
</section>
