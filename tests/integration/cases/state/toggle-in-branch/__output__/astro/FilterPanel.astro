---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

const open = false as boolean;
const colour = null as string | null;
const note = null as string | null;
---

<section class:list={["filter-panel", className]} aria-label="Filters" style={style}>
  {open ? (
    <button type="button" aria-expanded="true">Hide colours</button>
  ) : (
    <button type="button" aria-expanded="false">Show colours</button>
  )}
  {open ? (
    <div class="colours">
      <button type="button">Red</button>
      <button type="button">Blue</button>
      <button type="button">Reset</button>
    </div>
  ) : null}
  {colour ? (
    <div class="selection">
      <p>{`Colour: ${colour}`}</p>
      <button type="button">{`Clear ${colour}`}</button>
    </div>
  ) : (
    <p>No colour</p>
  )}
  {note === null ? (
    <button type="button">Add a note</button>
  ) : (
    <div class="note">
      <label>Note<input /></label>
      <p>{`Draft: "${note}"`}</p>
    </div>
  )}
</section>
