---
export interface Task {
  id: number;
  title: string;
  kind: string;
  rank: number;
  done: boolean;
}

export interface Filters {
  query: string;
  tags: string[];
}

export interface TaskBoardProps {
  initial: Task[];
}

type Props = TaskBoardProps;

const { initial } = Astro.props;

const tasks = initial;
const filters = { query: "", tags: [] } as Filters;
const open = tasks.filter((task) => !task.done).sort((a, b) => a.rank - b.rank);
const alphabetical = tasks
  .slice()
  .sort((a, b) => (a.title < b.title ? -1 : a.title > b.title ? 1 : 0));
const newestFirst = tasks.map((task) => task.title).reverse();

function getKinds() {
  const byKind: Record<string, Task[]> = {};
  for (const task of tasks) {
    if (!byKind[task.kind]) byKind[task.kind] = [];
    byKind[task.kind]!.push(task);
  }
  return Object.keys(byKind).map((kind) => `${kind}: ${byKind[kind]!.length}`);
}

const kinds = getKinds();

const byId = tasks.reduce<Record<number, Task>>((acc, task) => {
  acc[task.id] = task;
  return acc;
}, {});

const titlesByKind = tasks.reduce<Record<string, string[]>>((acc, task) => {
  (acc[task.kind] ||= []).push(task.title);
  return acc;
}, {});

const finishedByKind = tasks.reduce((acc, task) => {
  if (task.done) acc.set(task.kind, (acc.get(task.kind) ?? 0) + 1);
  return acc;
}, new Map<string, number>());

function getByState() {
  const groups: Record<string, string[]> = {};
  for (const task of tasks) {
    const state = task.done ? "done" : "open";
    groups[state] ??= [];
    groups[state]!.push(task.title);
  }
  return groups;
}

const byState = getByState();
const progress = Math.round((tasks.filter((task) => task.done).length / tasks.length) * 100);
---

<section class="task-board" aria-label="Tasks">
  <ol aria-label="Open">
    {open.map((task) => (
      <li
        class:list={[{ first: task.rank === 1 }]}
      >{task.title}<button type="button">{`Finish ${task.title}`}</button></li>
    ))}
  </ol>
  <div class="meter" role="presentation">
    <div class="fill" style={{ width: `${progress}%` }}></div>
  </div>
  <p>Alphabetical: {alphabetical.map((task) => task.title).join(", ")}</p>
  <p>Newest first: {newestFirst.join(", ")}</p>
  <ul aria-label="Kinds">
    {kinds.map((line) => (
      <li>{line}</li>
    ))}
  </ul>
  <p>Task 2: {byId[2]?.title}</p>
  <p>Code tasks: {titlesByKind["code"]?.join(", ")}</p>
  <p>Finished code tasks: {finishedByKind.get("code") ?? 0}</p>
  <p>Done: {byState["done"]?.join(", ") ?? "nothing"}</p>
  <button type="button">Tag urgent</button>
  <button type="button">Tag later</button>
  <p>Tags: {filters.tags.join(", ")}</p>
  <label>Notes<textarea name="notes" class="notes"></textarea></label>
  <label>Summary<textarea name="summary" class="summary"></textarea></label>
</section>
