{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Tag urgent' })",
      "dom": [
        "<section aria-label=\"Tasks\" class=\"task-board\">",
        "  <ol aria-label=\"Open\">",
        "    <li class=\"first\">",
        "      \"Write docs\"",
        "      <button type=\"button\">",
        "        \"Finish Write docs\"",
        "      </button>",
        "    </li>",
        "    <li>",
        "      \"Fix login\"",
        "      <button type=\"button\">",
        "        \"Finish Fix login\"",
        "      </button>",
        "    </li>",
        "    <li>",
        "      \"Plan release\"",
        "      <button type=\"button\">",
        "        \"Finish Plan release\"",
        "      </button>",
        "    </li>",
        "  </ol>",
        "  <div class=\"meter\" role=\"presentation\">",
        "    <div class=\"fill\" style=\"width: 0%;\"></div>",
        "  </div>",
        "  <p>",
        "    \"Alphabetical: Fix login, Plan release, Write docs\"",
        "  </p>",
        "  <p>",
        "    \"Newest first: Fix login, Write docs, Plan release\"",
        "  </p>",
        "  <ul aria-label=\"Kinds\">",
        "    <li>",
        "      \"code: 2\"",
        "    </li>",
        "    <li>",
        "      \"docs: 1\"",
        "    </li>",
        "  </ul>",
        "  <p>",
        "    \"Task 2: Write docs\"",
        "  </p>",
        "  <p>",
        "    \"Code tasks: Plan release, Fix login\"",
        "  </p>",
        "  <p>",
        "    \"Finished code tasks: 0\"",
        "  </p>",
        "  <p>",
        "    \"Done: nothing\"",
        "  </p>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Tag urgent\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Tag later\"",
        "  </button>",
        "  <p>",
        "    \"Tags: urgent\"",
        "  </p>",
        "  <label>",
        "    \"Notes\"",
        "    <textarea class=\"notes tall\" name=\"notes\" style=\"height: 6em;\" uf:value=\"a\\nb\\nc\\nd\"></textarea>",
        "  </label>",
        "  <label>",
        "    \"Summary\"",
        "    <textarea class=\"summary\" name=\"summary\" uf:value=\"\"></textarea>",
        "  </label>",
        "</section>"
      ],
      "aria": [
        "- region \"Tasks\":",
        "  - list \"Open\":",
        "    - listitem:",
        "      - text: Write docs",
        "      - button \"Finish Write docs\"",
        "    - listitem:",
        "      - text: Fix login",
        "      - button \"Finish Fix login\"",
        "    - listitem:",
        "      - text: Plan release",
        "      - button \"Finish Plan release\"",
        "  - paragraph: \"Alphabetical: Fix login, Plan release, Write docs\"",
        "  - paragraph: \"Newest first: Fix login, Write docs, Plan release\"",
        "  - list \"Kinds\":",
        "    - listitem: \"code: 2\"",
        "    - listitem: \"docs: 1\"",
        "  - paragraph: \"Task 2: Write docs\"",
        "  - paragraph: \"Code tasks: Plan release, Fix login\"",
        "  - paragraph: \"Finished code tasks: 0\"",
        "  - paragraph: \"Done: nothing\"",
        "  - button \"Tag urgent\"",
        "  - button \"Tag later\"",
        "  - paragraph: \"Tags: urgent\"",
        "  - text: Notes",
        "  - textbox \"Notes\": a b c d",
        "  - text: Summary",
        "  - textbox \"Summary\""
      ],
      "events": {}
    }
  ]
}
