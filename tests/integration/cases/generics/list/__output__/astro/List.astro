---
import type { HTMLAttributes } from "astro/types";

export interface ListProps<T> {
  label: string;
  items: T[];
  selected?: T;
}

interface Props<T>
  extends ListProps<T>, Omit<HTMLAttributes<"ul">, "label" | "items" | "selected"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  label,
  items,
  selected,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
---

<ul
  aria-label={"aria-label" in Astro.props ? ariaLabel : label}
  class:list={[className]}
  style={style}
  {...attrs}
>
  {items.map((item) => (
    <li aria-current={item === selected ? "true" : undefined}>{String(item)}</li>
  ))}
</ul>
