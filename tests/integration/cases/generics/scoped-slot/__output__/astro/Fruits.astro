---
import Picker from "./Picker.astro";
import type { HTMLAttributes } from "astro/types";

interface Fruit {
  name: string;
  count: number;
}

interface Props extends Omit<HTMLAttributes<"ul">, "fruits" | "items"> {
  fruits: Fruit[];
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { fruits, class: className, style, ...attrs } = Astro.props;
---

<Picker
  items={fruits}
  class:list={[className]}
  style={style}
  item={({ item }) => <span>{item.name} × {item.count}</span>}
  {...attrs}
/>
