---
import type { HTMLAttributes } from "astro/types";

export interface PickerProps<T> {
  items: T[];
}

interface Props<T> extends PickerProps<T>, Omit<HTMLAttributes<"ul">, "items" | "item"> {
  item?: (props: { item: T }) => unknown;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { items, item: item_1, class: className, style, ...attrs } = Astro.props;
---

<ul class:list={[className]} style={style} {...attrs}>
  {items.map((item) => (
    <li>{item_1?.({ item })}</li>
  ))}
</ul>
