---
import type { HTMLAttributes } from "astro/types";

export interface SelectProps<T extends string> {
  label: string;
  options: readonly T[];
}

interface Props<T extends string>
  extends SelectProps<T>, Omit<HTMLAttributes<"label">, "label" | "options" | "value"> {
  value: T;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, options, value, class: className, style, ...attrs } = Astro.props;
---

<label
  class:list={[className]}
  style={style}
  {...attrs}
>{label} <select>{options.map((option) => <option
  value={option}
  selected={value === option}
>{option}</option>)}</select></label>
