---
import type { HTMLAttributes } from "astro/types";

export interface TableProps<T extends { id: string; label: string }> {
  caption: string;
  rows: T[];
}

interface Props<T extends { id: string; label: string }>
  extends TableProps<T>, Omit<HTMLAttributes<"table">, "caption" | "rows"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { caption, rows, class: className, style, ...attrs } = Astro.props;
---

<table class:list={[className]} style={style} {...attrs}>
  <caption>{caption}</caption>
  <tbody>
    {rows.map((row) => (
      <tr>
        <th scope="row">{row.id}</th>
        <td>{row.label}</td>
      </tr>
    ))}
  </tbody>
</table>
