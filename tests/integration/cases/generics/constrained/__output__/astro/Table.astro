---
export interface TableProps<T extends { id: string; label: string }> {
  caption: string;
  rows: T[];
}

interface Props<T extends { id: string; label: string }> extends TableProps<T> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { caption, rows, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<table class:list={[className]} style={style} {...scopeAttributes(Astro.props)}>
  <caption>{caption}</caption>
  <tbody>
    {rows.map((row) => (
      <tr>
        <th scope="row">{row.id}</th>
        <td>{row.label}</td>
      </tr>
    ))}
  </tbody>
</table>
