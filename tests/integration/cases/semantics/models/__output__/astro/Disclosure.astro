---
interface Props {
  title: string;
  open?: boolean;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, open = false, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<div class:list={["disclosure", className]} style={style} {...scopeAttributes(Astro.props)}>
  <button type="button" aria-expanded={open}>{title}</button>
  {open ? (
    <p>Details of {title}</p>
  ) : null}
</div>
