---
import Disclosure from "./Disclosure.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const shipping = true as boolean;
---

<section
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Panels"}
  class:list={[className]}
  style={style}
  {...attrs}
>
  <Disclosure title="Shipping" open={shipping} />
  <Disclosure title="Returns" />
  <output>Shipping is {shipping ? "open" : "closed"}</output>
  <button type="button">Toggle shipping</button>
</section>
