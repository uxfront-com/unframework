    {
      "action": "click getByRole('button', { name: 'Greet Grace' })",
      "dom": [
        "<section aria-label=\"Account\" class=\"account-menu\">",
        "  <button type=\"button\">",
        "    \"Start\"",
        "  </button>",
        "  <p>",
        "    \"Nobody signed in\"",
        "  </p>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Greet Grace\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Account\":",
        "  - button \"Start\"",
        "  - paragraph: Nobody signed in",
        "  - button \"Greet Grace\""
      ],
      "events": {
        "greeted": [
          [
            "Grace"
          ]
        ]
      }
    },
