        "<section aria-label=\"Account\" class=\"account-menu\">",
        "  <button type=\"button\">",
        "    \"Sign in\"",
        "  </button>",
        "  <p>",
        "    \"Nobody signed in\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Greet Grace\"",
