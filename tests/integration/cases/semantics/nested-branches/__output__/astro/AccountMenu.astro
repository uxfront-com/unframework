---
interface User {
  name: string;
}

export interface AccountMenuProps {
  owner?: User;
}

interface Props extends AccountMenuProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { owner, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const step = "intro" as string;
const user = null as User | null;
---

<section
  class:list={["account-menu", className]}
  aria-label="Account"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  {step === "intro" ? (
    <button type="button">Start</button>
  ) : (
    <>
      {user === null ? (
        <button type="button">Sign in</button>
      ) : (
        <button type="button">Sign out</button>
      )}
    </>
  )}
  {user !== null ? (
    <p>Signed in as {user.name}</p>
  ) : (
    <p>Nobody signed in</p>
  )}
  {owner ? (
    <button type="button">{`Greet ${owner.name}`}</button>
  ) : (
    <p>No owner</p>
  )}
</section>
