---
import type { HTMLAttributes } from "astro/types";

interface User {
  name: string;
}

export interface AccountMenuProps {
  owner?: User;
}

interface Props extends AccountMenuProps, Omit<HTMLAttributes<"section">, "owner"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { owner, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const step = "intro" as string;
const user = null as User | null;
---

<section
  class:list={["account-menu", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Account"}
  style={style}
  {...attrs}
>
  {step === "intro" ? (
    <button type="button">Start</button>
  ) : (
    <>
      {user === null ? (
        <button type="button">Sign in</button>
      ) : (
        <button type="button">Sign out</button>
      )}
    </>
  )}
  {user !== null ? (
    <p>Signed in as {user.name}</p>
  ) : (
    <p>Nobody signed in</p>
  )}
  {owner ? (
    <button type="button">{`Greet ${owner.name}`}</button>
  ) : (
    <p>No owner</p>
  )}
</section>
