---
export interface PageCountProps {
  page?: number;
  total: number;
}

interface Props extends PageCountProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { page = 1, total, class: className, style } = Astro.props;

const label = `Page ${page} of ${total}`;
---

<nav class:list={["page-count", className]} aria-label="Pages" style={style}>
  <p role="status">{label}</p>
  <p>Direct: {page}</p>
</nav>
