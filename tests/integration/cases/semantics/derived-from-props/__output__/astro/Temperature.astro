---
export interface TemperatureProps {
  celsius: number;
}

interface Props extends TemperatureProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { celsius, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const fahrenheit = Math.round((celsius * 9) / 5 + 32);
const level = celsius >= 30 ? "hot" : celsius <= 5 ? "cold" : "mild";
---

<figure
  class:list={["temperature", className]}
  data-level={level}
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <p>{celsius} °C</p>
  <p>{fahrenheit} °F</p>
  <figcaption>Feels {level}</figcaption>
</figure>
