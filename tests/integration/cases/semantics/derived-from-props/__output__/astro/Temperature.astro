---
import type { HTMLAttributes } from "astro/types";

export interface TemperatureProps {
  celsius: number;
}

interface Props extends TemperatureProps, Omit<HTMLAttributes<"figure">, "celsius"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { celsius, class: className, style, "data-level": dataLevel, ...attrs } = Astro.props;

const fahrenheit = Math.round((celsius * 9) / 5 + 32);
const level = celsius >= 30 ? "hot" : celsius <= 5 ? "cold" : "mild";
---

<figure
  class:list={["temperature", className]}
  data-level={"data-level" in Astro.props ? dataLevel : level}
  style={style}
  {...attrs}
>
  <p>{celsius} °C</p>
  <p>{fahrenheit} °F</p>
  <figcaption>Feels {level}</figcaption>
</figure>
