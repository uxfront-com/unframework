---
import type { HTMLAttributes } from "astro/types";

export interface BallotProps {
  limit: number;
  label?: string;
  choices: string[];
}

interface Props
  extends BallotProps, Omit<HTMLAttributes<"section">, "limit" | "label" | "choices"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  limit,
  label = "Vote",
  choices,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;

const votes = limit;
const picked = "none" as string;
---

<section
  class:list={["ballot", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : label}
  style={style}
  {...attrs}
>
  <p role="status">{votes} votes left</p>
  <p>Picked: {picked}</p>
  <ul aria-label="Choices">
    {choices.map((choice) => (
      <li>
        <button type="button">{choice}</button>
      </li>
    ))}
  </ul>
  <button type="button">Count the answers</button>
</section>
