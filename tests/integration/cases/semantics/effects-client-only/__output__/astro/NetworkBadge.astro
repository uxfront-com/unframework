---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

const online = undefined as boolean | undefined;
const label = "Checking the connection" as string;
---

<p
  class:list={["network-badge", className]}
  role="status"
  data-checked={online === undefined ? "no" : "yes"}
  style={style}
>{label}</p>
