---
export interface UploadStep {
  id: string;
  label: string;
}

export interface UploadStatusProps {
  fileName: string;
  state: "queued" | "uploading" | "failed";
  percent: number;
  steps: UploadStep[];
  error?: string;
}

interface Props extends UploadStatusProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { fileName, state, percent, steps, error, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}
---

<section
  class:list={["upload", `upload-${state}`, className]}
  aria-label={`Upload of ${fileName}`}
  style={{ color: state === "failed" ? "#8a1c1c" : "#1f3d5c", "--upload-percent": percent, ...style }}
  {...scopeAttributes(Astro.props)}
>
  <h2>{fileName}</h2>
  <div
    role="progressbar"
    aria-label="Upload progress"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={percent}
  >{percent}%</div>
  {state === "failed" ? (
    <p class="upload-error">{error ?? "The upload failed."}</p>
  ) : (
    <p>{state === "queued" ? "Waiting to start" : "Uploading"}</p>
  )}
  <ol>
    {steps.map((step) => (
      <li>{step.label}</li>
    ))}
  </ol>
</section>
