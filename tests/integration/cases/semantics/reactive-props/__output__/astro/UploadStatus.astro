---
import type { HTMLAttributes } from "astro/types";

export interface UploadStep {
  id: string;
  label: string;
}

export interface UploadStatusProps {
  fileName: string;
  state: "queued" | "uploading" | "failed";
  percent: number;
  steps: UploadStep[];
  error?: string;
}

interface Props
  extends
    UploadStatusProps,
    Omit<HTMLAttributes<"section">, "fileName" | "state" | "percent" | "steps" | "error"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  fileName,
  state,
  percent,
  steps,
  error,
  class: className,
  style,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
---

<section
  class:list={["upload", `upload-${state}`, className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : `Upload of ${fileName}`}
  style={{ color: state === "failed" ? "#8a1c1c" : "#1f3d5c", "--upload-percent": percent, ...style }}
  {...attrs}
>
  <h2>{fileName}</h2>
  <div
    role="progressbar"
    aria-label="Upload progress"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={percent}
  >{percent}%</div>
  {state === "failed" ? (
    <p class="upload-error">{error ?? "The upload failed."}</p>
  ) : (
    <p>{state === "queued" ? "Waiting to start" : "Uploading"}</p>
  )}
  <ol>
    {steps.map((step) => (
      <li>{step.label}</li>
    ))}
  </ol>
</section>
