---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const count = 0 as number;
const trail = [] as string[];
---

<section
  class:list={["tally", className]}
  aria-label="Tally"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <p role="status">Count: {count}</p>
  <button type="button">Add two</button>
  <button type="button">Add five</button>
  <button type="button">Count up three</button>
  <button type="button">Add ten</button>
  <button type="button">Log the phases</button>
  <p>Phases: {trail.join(" then ")}</p>
</section>
