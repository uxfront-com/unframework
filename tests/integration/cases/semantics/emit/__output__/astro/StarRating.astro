---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, role, "aria-label": ariaLabel, ...attrs } = Astro.props;

const choices = [1, 2, 3, 4, 5];
const stars = 0 as number;
---

<div
  class:list={["star-rating", className]}
  role={"role" in Astro.props ? role : "group"}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Rating"}
  style={style}
  {...attrs}
>
  <ul>
    {choices.map((choice) => (
      <li>
        <button
          type="button"
          aria-pressed={stars >= choice}
        >{choice} {choice === 1 ? "star" : "stars"}</button>
      </li>
    ))}
  </ul>
  <p role="status">{stars} of 5</p>
  <button type="button">Clear</button>
</div>
