---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const query = "" as string;
const page = 1 as number;
---

<section
  class:list={["search-pager", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Search"}
  style={style}
  {...attrs}
>
  <p role="status">{query === "" ? "All results" : `Results for ${query}`}, page {page}</p>
  <button type="button">Search boots</button>
  <button type="button">Search sandals</button>
  <button type="button">Next page</button>
  <button type="button">Skip two pages</button>
</section>
