---
export interface SeatPickerProps {
  pricePerSeat: number;
}

interface Props extends SeatPickerProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { pricePerSeat, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const seats = 1 as number;
const total = seats * pricePerSeat;
const summary = seats === 1 ? `1 seat for ${total}` : `${seats} seats for ${total}`;
---

<section
  class:list={["seat-picker", className]}
  aria-label="Seats"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <p role="status">{summary}</p>
  <button type="button">Add a seat</button>
  <button type="button">Add a group and a guide</button>
</section>
