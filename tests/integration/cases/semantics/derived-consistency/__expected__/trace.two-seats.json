{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Add a seat' })",
      "dom": [
        "<section aria-label=\"Seats\" class=\"seat-picker\">",
        "  <p role=\"status\">",
        "    \"2 seats for 80\"",
        "  </p>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Add a seat\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Add a group and a guide\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Seats\":",
        "  - status: 2 seats for 80",
        "  - button \"Add a seat\"",
        "  - button \"Add a group and a guide\""
      ],
      "events": {
        "quote": [
          [
            2,
            80,
            "2 seats for 80"
          ]
        ]
      }
    }
  ]
}
