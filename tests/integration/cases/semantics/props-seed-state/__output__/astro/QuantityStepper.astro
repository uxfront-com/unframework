---
import type { HTMLAttributes } from "astro/types";

export interface QuantityStepperProps {
  initial: number;
  label: string;
}

interface Props extends QuantityStepperProps, Omit<HTMLAttributes<"div">, "initial" | "label"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  initial,
  label,
  class: className,
  style,
  role,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;

const quantity = initial;
---

<div
  class:list={["quantity-stepper", className]}
  role={"role" in Astro.props ? role : "group"}
  aria-label={"aria-label" in Astro.props ? ariaLabel : label}
  style={style}
  {...attrs}
>
  <output>{quantity}</output>
  <button type="button" aria-label={`Increase ${label}`}>+</button>
</div>
