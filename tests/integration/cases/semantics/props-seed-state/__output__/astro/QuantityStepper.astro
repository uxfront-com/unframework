---
export interface QuantityStepperProps {
  initial: number;
  label: string;
}

interface Props extends QuantityStepperProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { initial, label, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const quantity = initial;
---

<div
  class:list={["quantity-stepper", className]}
  role="group"
  aria-label={label}
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <output>{quantity}</output>
  <button type="button" aria-label={`Increase ${label}`}>+</button>
</div>
