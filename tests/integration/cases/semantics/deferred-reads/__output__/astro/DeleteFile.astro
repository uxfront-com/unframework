---
export interface DeleteFileProps {
  fileName: string;
}

interface Props extends DeleteFileProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { fileName, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const copies = 1 as number;
const confirming = false as boolean;
---

<section
  class:list={["delete-file", className]}
  aria-label="File"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <p>{fileName}, {copies} {copies === 1 ? "copy" : "copies"}</p>
  <button type="button">Add a copy</button>
  {confirming ? (
    <button type="button">Confirm the deletion</button>
  ) : (
    <button type="button">Delete</button>
  )}
</section>
