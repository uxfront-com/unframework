---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const names = ["Cy", "Al"].toSorted((a, b) => compare(a, b));
const count = 0 as number;

function compare(a: string, b: string): number {
  return a < b ? -1 : a > b ? 1 : 0;
}
---

<section
  class:list={["name-sorter", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Names"}
  style={style}
  {...attrs}
>
  <p>Names: {names.join(", ")}</p>
  <p>Added: {count}</p>
  <button type="button">Add Bo</button>
  <button type="button">Report</button>
</section>
