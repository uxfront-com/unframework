---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const colour = "none" as string;
---

<section
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Colours"}
  class:list={[className]}
  style={style}
  {...attrs}
>
  <select size="3" aria-label="Colour">
    <option value="red">Red</option>
    <option value="green">Green</option>
    <option value="blue">Blue</option>
  </select>
  <output>Picked: {colour}</output>
</section>
