---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const log = [] as string[];
const status = "idle" as string;
---

<section
  class:list={["picker", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Picker"}
  style={style}
  {...attrs}
>
  <div class="choices" role="presentation">
    <button type="button">Alpha</button>
    <button type="button">Beta</button>
  </div>
  <ol aria-label="Log">
    {log.map((entry) => (
      <li>{entry}</li>
    ))}
  </ol>
  <p role="status">{status}</p>
  <button type="button">Start</button>
</section>
