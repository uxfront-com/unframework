{
  "version": 1,
  "steps": [
    {
      "action": "rerender {\"name\":\"Grace\"}",
      "dom": [
        "<section aria-label=\"Welcome\" class=\"welcome-banner\">",
        "  <h2>",
        "    \"Welcome, Ada\"",
        "  </h2>",
        "  <p>",
        "    \"Signed in as Grace\"",
        "  </p>",
        "  <ul>",
        "    <li>",
        "      \"Set up your profile\"",
        "    </li>",
        "    <li>",
        "      \"Invite your team\"",
        "    </li>",
