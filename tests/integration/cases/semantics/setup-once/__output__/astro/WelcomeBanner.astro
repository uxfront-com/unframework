---
import type { HTMLAttributes } from "astro/types";

export interface WelcomeBannerProps {
  name: string;
}

interface Props extends WelcomeBannerProps, Omit<HTMLAttributes<"section">, "name"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { name, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const greeting = `Welcome, ${name}`;
const tips = ["Set up your profile", "Invite your team"];
---

<section
  class:list={["welcome-banner", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Welcome"}
  style={style}
  {...attrs}
>
  <h2>{greeting}</h2>
  <p>Signed in as {name}</p>
  <ul>
    {tips.map((tip) => (
      <li>{tip}</li>
    ))}
  </ul>
</section>
