---
import type { HTMLAttributes } from "astro/types";

export interface Entry {
  id: string;
  label: string;
}

export interface ChecklistProps {
  entries: Entry[];
}

interface Props extends ChecklistProps, Omit<HTMLAttributes<"ul">, "entries"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { entries, class: className, style, ...attrs } = Astro.props;
---

<ul class:list={["checklist", className]} style={style} {...attrs}>
  {entries.map((entry) => (
    <li>
      <label>{entry.label}<input name={`note-${entry.id}`} aria-label={`Note for ${entry.label}`} /></label>
    </li>
  ))}
</ul>
