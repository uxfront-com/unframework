{
  "version": 1,
  "steps": [
    {
      "action": "type getByRole('textbox', { name: 'Note for Bread' }) \"wholemeal\"",
      "dom": [
        "<ul class=\"checklist\">",
        "  <li>",
        "    <label>",
        "      \"Milk\"",
        "      <input aria-label=\"Note for Milk\" name=\"note-milk\" uf:value=\"\">",
        "    </label>",
        "  </li>",
        "  <li>",
        "    <label>",
        "      \"Bread\"",
        "      <input aria-label=\"Note for Bread\" name=\"note-bread\" uf:focused=\"\" uf:value=\"wholemeal\">",
        "    </label>",
        "  </li>",
        "  <li>",
        "    <label>",
        "      \"Eggs\"",
        "      <input aria-label=\"Note for Eggs\" name=\"note-eggs\" uf:value=\"\">",
        "    </label>",
        "  </li>",
        "</ul>"
      ],
      "aria": [
        "- list:",
        "  - listitem:",
        "    - text: Milk",
        "    - textbox \"Note for Milk\"",
        "  - listitem:",
        "    - text: Bread",
        "    - textbox \"Note for Bread\": wholemeal",
        "  - listitem:",
        "    - text: Eggs",
        "    - textbox \"Note for Eggs\""
      ],
      "events": {}
    },
    {
      "action": "rerender {\"entries\":[{\"id\":\"milk\",\"label\":\"Milk\"},{\"id\":\"bread\",\"label\":\"Rye bread\"},{\"id\":\"tea\",\"label\":\"Tea\"}]}",
      "dom": [
        "<ul class=\"checklist\">",
        "  <li>",
        "    <label>",
        "      \"Milk\"",
        "      <input aria-label=\"Note for Milk\" name=\"note-milk\" uf:value=\"\">",
        "    </label>",
        "  </li>",
        "  <li>",
        "    <label>",
        "      \"Rye bread\"",
        "      <input aria-label=\"Note for Rye bread\" name=\"note-bread\" uf:focused=\"\" uf:value=\"wholemeal\">",
        "    </label>",
        "  </li>",
        "  <li>",
        "    <label>",
        "      \"Tea\"",
        "      <input aria-label=\"Note for Tea\" name=\"note-tea\" uf:value=\"\">",
        "    </label>",
        "  </li>",
        "</ul>"
      ],
      "aria": [
        "- list:",
        "  - listitem:",
        "    - text: Milk",
        "    - textbox \"Note for Milk\"",
        "  - listitem:",
        "    - text: Rye bread",
        "    - textbox \"Note for Rye bread\": wholemeal",
        "  - listitem:",
        "    - text: Tea",
        "    - textbox \"Note for Tea\""
      ],
      "events": {}
    }
  ]
}
