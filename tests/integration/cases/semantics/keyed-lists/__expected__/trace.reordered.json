{
  "version": 1,
  "steps": [
    {
      "action": "type getByRole('textbox', { name: 'Note for Milk' }) \"oat\"",
      "dom": [
        "<ul class=\"checklist\">",
        "  <li>",
        "    <label>",
        "      \"Milk\"",
        "      <input aria-label=\"Note for Milk\" name=\"note-milk\" uf:focused=\"\" uf:value=\"oat\">",
        "    </label>",
        "  </li>",
        "  <li>",
        "    <label>",
        "      \"Bread\"",
        "      <input aria-label=\"Note for Bread\" name=\"note-bread\" uf:value=\"\">",
        "    </label>",
        "  </li>",
        "  <li>",
        "    <label>",
        "      \"Eggs\"",
        "      <input aria-label=\"Note for Eggs\" name=\"note-eggs\" uf:value=\"\">",
        "    </label>",
        "  </li>",
        "</ul>"
      ],
      "aria": [
        "- list:",
        "  - listitem:",
        "    - text: Milk",
        "    - textbox \"Note for Milk\": oat",
