---
import { useTeardown } from "./useTeardown";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "name"> {
  name: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { name, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const { title } = useTeardown(() => name);
---

<section
  class:list={["panel", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : title}
  style={style}
  {...attrs}
>
  <h2>{title}</h2>
</section>
