---
import Panel from "./Panel.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, ...attrs } = Astro.props;

const showA = true as boolean;
const showB = true as boolean;
const entries = [] as string[];
---

<div class:list={["board", className]} style={style} {...attrs}>
  {showA ? (
    <Panel name="a" />
  ) : null}
  {showB ? (
    <Panel name="b" />
  ) : null}
  <button type="button">Hide a</button>
  <button type="button">Hide b</button>
  <output>{entries.join(", ")}</output>
</div>
