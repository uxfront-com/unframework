---
import Panel from "./Panel.astro";

interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const showA = true as boolean;
const showB = true as boolean;
const entries = [] as string[];
---

<div class:list={["board", className]} style={style} {...scopeAttributes(Astro.props)}>
  {showA ? (
    <Panel name="a" />
  ) : null}
  {showB ? (
    <Panel name="b" />
  ) : null}
  <button type="button">Hide a</button>
  <button type="button">Hide b</button>
  <output>{entries.join(", ")}</output>
</div>
