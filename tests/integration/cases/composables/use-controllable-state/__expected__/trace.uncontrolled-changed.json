{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Three' })",
      "dom": [
        "<section aria-label=\"Rating\" class=\"rating\">",
        "  <p role=\"status\">",
        "    \"Rated 3 of 3\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Two\"",
        "  </button>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Three\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Rating\":",
        "  - status: Rated 3 of 3",
        "  - button \"Two\"",
        "  - button \"Three\""
      ],
      "events": {
        "change": [
          [
            3
          ]
        ]
      }
    }
  ]
}
