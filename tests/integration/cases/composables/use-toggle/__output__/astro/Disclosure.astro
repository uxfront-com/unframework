---
import { useToggle } from "./useToggle";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const { on } = useToggle(false);
---

<section
  class:list={["disclosure", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Shipping"}
  style={style}
  {...attrs}
>
  <button type="button" aria-expanded={on}>Shipping details</button>
  {on ? (
    <div class="panel">
      <p>Orders ship within two days.</p>
      <button type="button">Close</button>
    </div>
  ) : null}
</section>
