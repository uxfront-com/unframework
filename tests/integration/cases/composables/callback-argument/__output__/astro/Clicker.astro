---
import { useCounter } from "./useCounter";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const message = "Keep going" as string;
const { count, step } = useCounter(3);
---

<section
  class:list={["clicker", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Clicker"}
  style={style}
  {...attrs}
>
  <p role="status">Count: {count}</p>
  <p>{message}</p>
  <button type="button">Add {step}</button>
  <button type="button">Reset</button>
</section>
