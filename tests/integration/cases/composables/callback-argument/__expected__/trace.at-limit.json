{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Add 1' })",
      "dom": [
        "<section aria-label=\"Clicker\" class=\"clicker\">",
        "  <p role=\"status\">",
        "    \"Count: 3\"",
        "  </p>",
        "  <p>",
        "    \"Reached 3\"",
        "  </p>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Add 1\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Reset\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Clicker\":",
        "  - status: \"Count: 3\"",
        "  - paragraph: Reached 3",
        "  - button \"Add 1\"",
        "  - button \"Reset\""
      ],
      "events": {
        "limit": [
          [
            3
          ]
        ]
      }
    }
  ]
}
