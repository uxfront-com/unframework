---
import { useTotal } from "./useTotal";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "price"> {
  price: number;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { price, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const quantity = 1 as number;
const { total, label } = useTotal(
  () => price,
  () => quantity,
);
---

<section
  class:list={["basket", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Basket"}
  style={style}
  {...attrs}
>
  <p role="status">Total: {total}</p>
  <p>{label}</p>
  <button type="button">Add one</button>
</section>
