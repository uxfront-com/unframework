---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "name" | "done"> {
  name: string;
  done: boolean;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { name, done, class: className, style, role, ...attrs } = Astro.props;
---

<div
  role={"role" in Astro.props ? role : "listitem"}
  class:list={["row", { done }, className]}
  style={style}
  {...attrs}
>{name}{done ? " (done)" : ""}</div>
