---
interface Props {
  name: string;
  done: boolean;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { name, done, class: className, style } = Astro.props;
---

<div
  role="listitem"
  class:list={["row", { done }, className]}
  style={style}
>{name}{done ? " (done)" : ""}</div>
