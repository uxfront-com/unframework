---
import Row from "./Row.astro";
import type { HTMLAttributes } from "astro/types";

export interface Task {
  id: number;
  name: string;
  done: boolean;
}

interface Props extends Omit<HTMLAttributes<"div">, "initial"> {
  initial: Task[];
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { initial, class: className, style, ...attrs } = Astro.props;

const tasks = initial;
---

<div class:list={[className]} style={style} {...attrs}>
  <div role="list" aria-label="Tasks">
    {tasks.map((task) => (
      <Row name={task.name} done={task.done} />
    ))}
  </div>
  <button type="button">Add a task</button>
  <button type="button">Finish the first</button>
</div>
