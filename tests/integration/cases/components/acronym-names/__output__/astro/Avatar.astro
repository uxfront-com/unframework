---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"button">, "imageURL" | "userID"> {
  imageURL: string;
  userID: number;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  imageURL,
  userID,
  class: className,
  style,
  type,
  "data-user": dataUser,
  ...attrs
} = Astro.props;
---

<button
  type={"type" in Astro.props ? type : "button"}
  data-user={"data-user" in Astro.props ? dataUser : userID}
  class:list={[className]}
  style={style}
  {...attrs}
>User {userID}: {imageURL}</button>
