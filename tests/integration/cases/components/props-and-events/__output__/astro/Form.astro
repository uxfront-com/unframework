---
import Field from "./Field.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "city"> {
  city: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { city, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const cleared = "nothing" as string;
---

<section
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Address"}
  class:list={[className]}
  style={style}
  {...attrs}
>
  <Field label="Street" />
  <Field label={city} tone="warn" />
  <output>Cleared: {cleared}</output>
</section>
