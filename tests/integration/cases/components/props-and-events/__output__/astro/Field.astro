---
import type { HTMLAttributes } from "astro/types";

export interface FieldProps {
  label: string;
  tone?: "info" | "warn";
}

interface Props extends FieldProps, Omit<HTMLAttributes<"div">, "label" | "tone"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { label, tone = "info", class: className, style, ...attrs } = Astro.props;
---

<div class:list={["field", tone, className]} style={style} {...attrs}>
  <span>{label}</span>
  <button type="button">Clear {label}</button>
</div>
