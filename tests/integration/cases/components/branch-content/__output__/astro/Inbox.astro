---
import Notice from "./Notice.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "unread"> {
  unread: number;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { unread, class: className, style, ...attrs } = Astro.props;

const count = unread;
---

<div class:list={["inbox", className]} style={style} {...attrs}>
  {count > 0 ? (
    <Notice text={`${count} unread`} tone="info" />
  ) : (
    <Notice text="All read" tone="quiet" />
  )}
  <button type="button">Mark all read</button>
</div>
