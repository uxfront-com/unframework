---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"p">, "text" | "tone"> {
  text: string;
  tone: "info" | "quiet";
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { text, tone, class: className, style, role, ...attrs } = Astro.props;
---

<p
  role={"role" in Astro.props ? role : "status"}
  class:list={["notice", tone, className]}
  style={style}
  {...attrs}
>{text}</p>
