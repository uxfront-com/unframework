---
import Badge from "./Badge.astro";
import Tag from "./Pill.astro";

interface Props {
  state: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { state, class: className, style } = Astro.props;
---

<p class:list={["status", className]} style={style}>
  <Badge text="Build" />
  <Tag text={state} />
</p>
