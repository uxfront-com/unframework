---
import Badge from "./Badge.astro";
import Tag from "./Pill.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"p">, "state"> {
  state: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { state, class: className, style, ...attrs } = Astro.props;
---

<p class:list={["status", className]} style={style} {...attrs}>
  <Badge text="Build" />
  <Tag text={state} />
</p>
