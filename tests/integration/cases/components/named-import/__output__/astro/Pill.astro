---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"span">, "text"> {
  text: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { text, class: className, style, ...attrs } = Astro.props;
---

<span class:list={["pill", className]} style={style} {...attrs}>{text}</span>
