---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "from"> {
  from: number;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { from, class: className, style, ...attrs } = Astro.props;
---

<div class:list={["level", className]} style={style} {...attrs}>
  <span>{from}</span>
  {from > 0 ? (
    <Astro.self from={from - 1} />
  ) : (
    <strong>Liftoff</strong>
  )}
</div>
