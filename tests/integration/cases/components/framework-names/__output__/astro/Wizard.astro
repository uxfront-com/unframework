---
import KeepAlive from "./KeepAlive.astro";
import Transition from "./Transition.astro";
import TransitionComponent from "./TransitionComponent.astro";

interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;
---

<section aria-label="Wizard" class:list={[className]} style={style}>
  <Transition step="details" />
  <TransitionComponent />
  <KeepAlive level={2} />
</section>
