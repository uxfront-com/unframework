---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"p">, "step"> {
  step: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { step, class: className, style, ...attrs } = Astro.props;
---

<p class:list={["step", className]} style={style} {...attrs}>Step: {step}</p>
