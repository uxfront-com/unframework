---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "level"> {
  level: number;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { level, class: className, style, ...attrs } = Astro.props;
---

<div class:list={["level", className]} style={style} {...attrs}>
  <span>Level {level}</span>
  {level > 0 ? (
    <Astro.self level={level - 1} />
  ) : null}
</div>
