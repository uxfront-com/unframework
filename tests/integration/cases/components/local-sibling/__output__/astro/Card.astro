---
import CardIcon from "./CardIcon.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "title"> {
  title: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, class: className, style, ...attrs } = Astro.props;
---

<div class:list={["card", className]} style={style} {...attrs}>
  <CardIcon symbol="+" />
  <h3>{title}</h3>
  <CardIcon symbol="-" />
</div>
