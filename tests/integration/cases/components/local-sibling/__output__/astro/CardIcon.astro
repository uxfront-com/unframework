---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"span">, "symbol"> {
  symbol: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { symbol, class: className, style, "aria-hidden": ariaHidden, ...attrs } = Astro.props;
---

<span
  class:list={["icon", className]}
  aria-hidden={"aria-hidden" in Astro.props ? ariaHidden : "true"}
  style={style}
  {...attrs}
>{symbol}</span>
