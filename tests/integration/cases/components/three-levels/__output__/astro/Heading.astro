---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"h3">, "text"> {
  text: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { text, class: className, style, ...attrs } = Astro.props;
---

<h3 class:list={["heading", className]} style={style} {...attrs}>{text}</h3>
