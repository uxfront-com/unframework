---
import Heading from "./Heading.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"section">, "title" | "body"> {
  title: string;
  body: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { title, body, class: className, style, ...attrs } = Astro.props;
---

<section class:list={["section", className]} style={style} {...attrs}>
  <Heading text={title} />
  <p>{body}</p>
</section>
