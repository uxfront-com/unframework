---
import Item from "./Item.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"ul">, "entries"> {
  entries: string[];
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { entries, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;
---

<ul
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Menu"}
  class:list={[className]}
  style={style}
  {...attrs}
>
  {entries.map((entry) => (
    <Item label={entry} />
  ))}
</ul>
