{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Grace Hopper' })",
      "dom": [
        "<section aria-label=\"Contacts\" class=\"contact-list\">",
        "  <ul>",
        "    <li>",
        "      <button aria-pressed=\"false\" type=\"button\">",
        "        \"Ada Lovelace\"",
        "      </button>",
        "      <button aria-label=\"Remove Ada Lovelace\" type=\"button\">",
        "        \"Remove\"",
        "      </button>",
        "    </li>",
        "    <li>",
        "      <button aria-pressed=\"true\" type=\"button\" uf:focused=\"\">",
        "        \"Grace Hopper\"",
        "      </button>",
        "      <button aria-label=\"Remove Grace Hopper\" type=\"button\">",
        "        \"Remove\"",
        "      </button>",
        "    </li>",
        "    <li>",
        "      <button aria-pressed=\"false\" type=\"button\">",
        "        \"Alan Turing\"",
        "      </button>",
        "      <button aria-label=\"Remove Alan Turing\" type=\"button\">",
        "        \"Remove\"",
        "      </button>",
        "    </li>",
        "  </ul>",
        "  <p role=\"status\">",
        "    \"Chosen: grace\"",
        "  </p>",
        "</section>"
      ],
      "aria": [
        "- region \"Contacts\":",
        "  - list:",
        "    - listitem:",
        "      - button \"Ada Lovelace\"",
        "      - button \"Remove Ada Lovelace\": Remove",
        "    - listitem:",
        "      - button \"Grace Hopper\" [pressed]",
        "      - button \"Remove Grace Hopper\": Remove",
        "    - listitem:",
        "      - button \"Alan Turing\"",
        "      - button \"Remove Alan Turing\": Remove",
        "  - status: \"Chosen: grace\""
      ],
      "events": {
        "choose": [
          [
            "grace",
            1
          ]
        ]
      }
    }
  ]
}
