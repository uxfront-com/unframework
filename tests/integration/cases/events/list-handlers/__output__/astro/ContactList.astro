---
export interface Contact {
  id: string;
  name: string;
}

export interface ContactListProps {
  initial: Contact[];
}

interface Props extends ContactListProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { initial, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const contacts = initial;
const chosen = undefined as string | undefined;
---

<section
  class:list={["contact-list", className]}
  aria-label="Contacts"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <ul>
    {contacts.map((contact) => (
      <li>
        <button type="button" aria-pressed={chosen === contact.id}>{contact.name}</button>
        <button type="button" aria-label={`Remove ${contact.name}`}>Remove</button>
      </li>
    ))}
  </ul>
  <p role="status">Chosen: {chosen ?? "nobody"}</p>
</section>
