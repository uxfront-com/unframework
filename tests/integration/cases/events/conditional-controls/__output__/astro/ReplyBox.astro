---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const started = false as boolean;
const suggesting = false as boolean;
const accepted = 0 as number;
---

<section
  class:list={["reply-box", className]}
  aria-label="Reply"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <label>Message<textarea name="message"></textarea></label>
  <p>{started ? "Started" : "Not started"}</p>
  <label>Answer<textarea name="answer"></textarea></label>
  <button type="button" aria-pressed={suggesting}>Suggestions</button>
  <p>Accepted: {accepted}</p>
</section>
