{
  "version": 1,
  "steps": [
    {
      "action": "type getByRole('textbox', { name: 'Comment' }) \"Hi\"",
      "dom": [
        "<section aria-label=\"Composer\" class=\"comment-composer\">",
        "  <label>",
        "    \"Comment\"",
        "    <textarea name=\"comment\" uf:focused=\"\" uf:value=\"Hi\"></textarea>",
        "  </label>",
        "  <form aria-label=\"Tags\">",
        "    <label>",
        "      \"Tag\"",
        "      <input name=\"tag\" uf:value=\"\">",
        "    </label>",
        "    <button type=\"submit\">",
        "      \"Save tags\"",
        "    </button>",
        "  </form>",
        "  <ul aria-label=\"Tag list\"></ul>",
        "  <label>",
        "    \"Code\"",
        "    <input name=\"code\" uf:value=\"\">",
        "  </label>",
        "  <div class=\"panel\" role=\"presentation\">",
        "    <label>",
        "      \"Search\"",
        "      <input name=\"search\" uf:value=\"\">",
        "    </label>",
        "    <p>",
        "      \"Searching for:\"",
        "    </p>",
        "  </div>",
        "  <div class=\"page\" role=\"presentation\">",
        "    <div class=\"tip\" role=\"presentation\" style=\"padding: 12px;\">",
        "      \"Click here to hide this tip.\"",
        "      <button type=\"button\">",
        "        \"More tips\"",
        "      </button>",
        "    </div>",
        "    <div class=\"backdrop\" data-testid=\"backdrop\" role=\"presentation\" style=\"padding: 24px;\">",
        "      <div aria-label=\"Discard draft\" role=\"dialog\">",
        "        <p>",
        "          \"Discard this draft?\"",
        "        </p>",
        "        <button type=\"button\">",
        "          \"Keep\"",
        "        </button>",
        "      </div>",
        "    </div>",
        "  </div>",
        "  <button type=\"button\">",
        "    \"Save\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Upload\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Finish upload\"",
        "  </button>",
        "  <ol aria-label=\"Log\"></ol>",
        "</section>"
      ],
      "aria": [
        "- region \"Composer\":",
        "  - text: Comment",
        "  - textbox \"Comment\": Hi",
        "  - form \"Tags\":",
        "    - text: Tag",
        "    - textbox \"Tag\"",
        "    - button \"Save tags\"",
        "  - list \"Tag list\"",
        "  - text: Code",
        "  - textbox \"Code\"",
        "  - text: Search",
        "  - textbox \"Search\"",
        "  - paragraph: \"Searching for:\"",
        "  - text: Click here to hide this tip.",
        "  - button \"More tips\"",
        "  - dialog \"Discard draft\":",
        "    - paragraph: Discard this draft?",
        "    - button \"Keep\"",
        "  - button \"Save\"",
        "  - button \"Upload\"",
        "  - button \"Finish upload\"",
        "  - list \"Log\""
      ],
      "events": {}
    },
