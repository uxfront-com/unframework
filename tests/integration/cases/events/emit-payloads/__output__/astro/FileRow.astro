---
import type { HTMLAttributes } from "astro/types";

export interface FileInfo {
  path: string;
  size: number;
}

export interface FileRowProps {
  path: string;
  size: number;
}

interface Props extends FileRowProps, Omit<HTMLAttributes<"div">, "path" | "size"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  path,
  size,
  class: className,
  style,
  role,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
---

<div
  class:list={["file-row", className]}
  role={"role" in Astro.props ? role : "group"}
  aria-label={"aria-label" in Astro.props ? ariaLabel : path}
  style={style}
  {...attrs}
>
  <span>{path} ({size} bytes)</span>
  <button type="button">Refresh</button>
  <button type="button">Open</button>
  <button type="button">Archive</button>
  <button type="button">Select</button>
  <button type="button">Share</button>
  <button type="button">Share with a note</button>
</div>
