---
export interface FileInfo {
  path: string;
  size: number;
}

export interface FileRowProps {
  path: string;
  size: number;
}

interface Props extends FileRowProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { path, size, class: className, style } = Astro.props;
---

<div class:list={["file-row", className]} role="group" aria-label={path} style={style}>
  <span>{path} ({size} bytes)</span>
  <button type="button">Refresh</button>
  <button type="button">Open</button>
  <button type="button">Archive</button>
  <button type="button">Select</button>
  <button type="button">Share</button>
  <button type="button">Share with a note</button>
</div>
