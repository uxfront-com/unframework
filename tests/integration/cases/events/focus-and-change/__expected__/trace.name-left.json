{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Inside the card' })",
      "dom": [
        "<section aria-label=\"Profile\" class=\"profile-fields\">",
        "  <div aria-label=\"Name fields\" class=\"name-group\" role=\"group\">",
        "    <label>",
        "      \"Name\"",
        "      <input name=\"name\" uf:value=\"\">",
        "    </label>",
        "  </div>",
        "  <label>",
        "    \"Nickname\"",
        "    <input name=\"nickname\" uf:value=\"\">",
        "  </label>",
        "  <p>",
        "    \"Nickname:\"",
        "  </p>",
        "  <label>",
        "    <input name=\"public\" type=\"checkbox\" uf:checked=\"false\" uf:indeterminate=\"false\">",
        "    \"Public profile\"",
        "  </label>",
        "  <label>",
        "    <input name=\"locked\" type=\"checkbox\" uf:checked=\"false\" uf:indeterminate=\"false\">",
        "    \"Locked\"",
        "  </label>",
        "  <div aria-label=\"Card\" class=\"card\" role=\"group\" tabindex=\"-1\">",
        "    <p>",
        "      \"Card not focused\"",
        "    </p>",
        "    <p>",
        "      \"Card blurs: 0\"",
        "    </p>",
        "    <button type=\"button\" uf:focused=\"\">",
        "      \"Inside the card\"",
        "    </button>",
        "  </div>",
        "  <ol aria-label=\"Log\">",
        "    <li>",
        "      \"name focus\"",
        "    </li>",
        "    <li>",
        "      \"group focusin\"",
        "    </li>",
        "    <li>",
        "      \"name blur\"",
        "    </li>",
        "    <li>",
        "      \"group focusout\"",
        "    </li>",
        "    <li>",
        "      \"card button\"",
        "    </li>",
        "  </ol>",
        "</section>"
      ],
      "aria": [
        "- region \"Profile\":",
        "  - group \"Name fields\":",
        "    - text: Name",
        "    - textbox \"Name\"",
        "  - text: Nickname",
        "  - textbox \"Nickname\"",
        "  - paragraph: \"Nickname:\"",
        "  - checkbox \"Public profile\"",
        "  - text: Public profile",
        "  - checkbox \"Locked\"",
        "  - text: Locked",
        "  - group \"Card\":",
        "    - paragraph: Card not focused",
        "    - paragraph: \"Card blurs: 0\"",
        "    - button \"Inside the card\"",
        "  - list \"Log\":",
        "    - listitem: name focus",
        "    - listitem: group focusin",
        "    - listitem: name blur",
        "    - listitem: group focusout",
        "    - listitem: card button"
      ],
      "events": {}
    }
  ]
}
