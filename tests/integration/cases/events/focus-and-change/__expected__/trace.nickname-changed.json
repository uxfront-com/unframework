{
  "version": 1,
  "steps": [
    {
      "action": "fill getByRole('textbox', { name: 'Nickname' }) \"Grace\"",
      "dom": [
        "<section aria-label=\"Profile\" class=\"profile-fields\">",
        "  <div aria-label=\"Name fields\" class=\"name-group\" role=\"group\">",
        "    <label>",
        "      \"Name\"",
        "      <input name=\"name\" uf:value=\"\">",
        "    </label>",
        "  </div>",
        "  <label>",
        "    \"Nickname\"",
        "    <input name=\"nickname\" uf:focused=\"\" uf:value=\"Grace\">",
        "  </label>",
        "  <p>",
        "    \"Nickname: Ada\"",
        "  </p>",
        "  <label>",
        "    <input name=\"public\" type=\"checkbox\" uf:checked=\"false\" uf:indeterminate=\"false\">",
        "    \"Public profile\"",
        "  </label>",
        "  <label>",
        "    <input name=\"locked\" type=\"checkbox\" uf:checked=\"false\" uf:indeterminate=\"false\">",
        "    \"Locked\"",
        "  </label>",
        "  <div aria-label=\"Card\" class=\"card\" role=\"group\" tabindex=\"-1\">",
        "    <p>",
        "      \"Card not focused\"",
        "    </p>",
        "    <p>",
        "      \"Card blurs: 0\"",
        "    </p>",
        "    <button type=\"button\">",
        "      \"Inside the card\"",
        "    </button>",
        "  </div>",
        "  <ol aria-label=\"Log\"></ol>",
        "</section>"
      ],
      "aria": [
        "- region \"Profile\":",
        "  - group \"Name fields\":",
        "    - text: Name",
        "    - textbox \"Name\"",
        "  - text: Nickname",
        "  - textbox \"Nickname\": Grace",
