        "  - checkbox \"Public profile\"",
        "  - text: Public profile",
        "  - checkbox \"Locked\"",
        "  - text: Locked",
        "  - group \"Card\":",
        "    - paragraph: Card not focused",
        "    - paragraph: \"Card blurs: 0\"",
        "    - button \"Inside the card\"",
        "  - list \"Log\""
      ],
      "events": {}
    },
