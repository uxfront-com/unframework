---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const open = false as boolean;
const status = "draft" as string;
const log = [] as string[];
---

<section
  class:list={["draft-panel", className]}
  aria-label="Draft"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <button type="button" aria-expanded={open}>Options</button>
  {open ? (
    <div class="options" role="group" aria-label="Draft options">
      <button type="button">Close</button>
    </div>
  ) : null}
  <button type="button">Listen</button>
  <button type="button">Stop listening</button>
  <button type="button">Handle</button>
  <button type="button">Save</button>
  <p role="status">{open ? "Options open" : "Options closed"}, {status}</p>
  <ol aria-label="Log">
    {log.map((line) => (
      <li>{line}</li>
    ))}
  </ol>
</section>
