{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Listen' })",
      "dom": [
        "<section aria-label=\"Draft\" class=\"draft-panel\">",
        "  <button aria-expanded=\"false\" type=\"button\">",
        "    \"Options\"",
        "  </button>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Listen\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Stop listening\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Handle\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Save\"",
        "  </button>",
        "  <p role=\"status\">",
        "    \"Options closed, draft\"",
        "  </p>",
        "  <ol aria-label=\"Log\"></ol>",
        "</section>"
      ],
      "aria": [
        "- region \"Draft\":",
        "  - button \"Options\"",
        "  - button \"Listen\"",
        "  - button \"Stop listening\"",
        "  - button \"Handle\"",
        "  - button \"Save\"",
        "  - status: Options closed, draft",
        "  - list \"Log\""
      ],
      "events": {}
    },
    {
      "action": "keyboard \"{Escape}\"",
      "dom": [
        "<section aria-label=\"Draft\" class=\"draft-panel\">",
        "  <button aria-expanded=\"false\" type=\"button\">",
        "    \"Options\"",
        "  </button>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Listen\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Stop listening\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Handle\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Save\"",
        "  </button>",
        "  <p role=\"status\">",
        "    \"Options closed, draft\"",
        "  </p>",
        "  <ol aria-label=\"Log\">",
        "    <li>",
        "      \"key Escape\"",
        "    </li>",
        "  </ol>",
        "</section>"
      ],
      "aria": [
        "- region \"Draft\":",
        "  - button \"Options\"",
        "  - button \"Listen\"",
        "  - button \"Stop listening\"",
        "  - button \"Handle\"",
        "  - button \"Save\"",
        "  - status: Options closed, draft",
        "  - list \"Log\":",
        "    - listitem: key Escape"
      ],
      "events": {
        "key": [
          [
            "Escape"
          ]
        ]
      }
    }
  ]
}
