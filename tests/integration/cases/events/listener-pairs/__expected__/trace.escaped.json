{
  "version": 1,
  "steps": [
    {
      "action": "keyboard \"{Escape}\"",
      "dom": [
        "<section aria-label=\"Draft\" class=\"draft-panel\">",
        "  <button aria-expanded=\"false\" type=\"button\" uf:focused=\"\">",
        "    \"Options\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Listen\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Stop listening\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Handle\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Save\"",
        "  </button>",
        "  <p role=\"status\">",
        "    \"Options closed, draft\"",
        "  </p>",
        "  <ol aria-label=\"Log\"></ol>",
        "</section>"
      ],
      "aria": [
        "- region \"Draft\":",
        "  - button \"Options\"",
        "  - button \"Listen\"",
        "  - button \"Stop listening\"",
        "  - button \"Handle\"",
        "  - button \"Save\"",
        "  - status: Options closed, draft",
        "  - list \"Log\""
      ],
      "events": {
        "closed": [
          [
            "escape"
          ]
        ]
      }
    }
  ]
}
