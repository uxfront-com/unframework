{
  "version": 1,
  "steps": [
    {
      "action": "wheel getByRole('group', { name: 'Volume' }) {\"direction\":\"down\"}",
      "dom": [
        "<section aria-label=\"Event options\" class=\"event-log\">",
        "  <div class=\"panel\" role=\"presentation\">",
        "    <button type=\"button\">",
        "      \"Inside\"",
        "    </button>",
        "    <button type=\"button\">",
        "      \"Stop here\"",
        "    </button>",
        "  </div>",
        "  <button type=\"button\">",
        "    \"Only once\"",
        "  </button>",
        "  <div class=\"reward\" role=\"presentation\">",
        "    <button type=\"button\">",
        "      \"Claim the reward\"",
        "    </button>",
        "  </div>",
        "  <div aria-label=\"Volume\" class=\"volume\" role=\"group\">",
        "    <output>",
        "      \"4\"",
        "    </output>",
        "  </div>",
        "  <ol aria-label=\"Log\"></ol>",
        "</section>"
      ],
      "aria": [
        "- region \"Event options\":",
        "  - button \"Inside\"",
        "  - button \"Stop here\"",
        "  - button \"Only once\"",
        "  - button \"Claim the reward\"",
        "  - group \"Volume\":",
        "    - status: \"4\"",
        "  - list \"Log\""
      ],
      "events": {}
    }
  ]
}
