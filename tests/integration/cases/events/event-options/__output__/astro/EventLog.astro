---
const log = [] as string[];
const volume = 5 as number;
---

<section class="event-log" aria-label="Event options">
  <div class="panel" role="presentation">
    <button type="button">Inside</button>
    <button type="button">Stop here</button>
  </div>
  <button type="button">Only once</button>
  <div class="reward" role="presentation">
    <button type="button">Claim the reward</button>
  </div>
  <div class="volume" role="group" aria-label="Volume">
    <output>{volume}</output>
  </div>
  <ol aria-label="Log">
    {log.map((entry) => (
      <li>{entry}</li>
    ))}
  </ol>
</section>
