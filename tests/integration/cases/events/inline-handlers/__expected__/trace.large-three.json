{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Add one' })",
      "dom": [
        "<section aria-label=\"Shirt order\" class=\"shirt-order\">",
        "  <p role=\"status\">",
        "    \"2 x size M\"",
        "  </p>",
        "  <div aria-label=\"Size\" role=\"group\">",
        "    <button aria-pressed=\"false\" type=\"button\" value=\"S\">",
        "      \"Small\"",
        "    </button>",
        "    <button aria-pressed=\"true\" type=\"button\" value=\"M\">",
        "      \"Medium\"",
        "    </button>",
        "    <button aria-pressed=\"false\" type=\"button\" value=\"L\">",
        "      \"Large\"",
        "    </button>",
        "  </div>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Add one\"",
        "  </button>",
        "  <label>",
        "    \"Note\"",
        "    <input name=\"note\" uf:value=\"\">",
        "  </label>",
        "  <p>",
        "    \"Note:\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Reset\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Shirt order\":",
        "  - status: 2 x size M",
        "  - group \"Size\":",
        "    - button \"Small\"",
        "    - button \"Medium\" [pressed]",
        "    - button \"Large\"",
        "  - button \"Add one\"",
        "  - text: Note",
        "  - textbox \"Note\"",
        "  - paragraph: \"Note:\"",
        "  - button \"Reset\""
      ],
      "events": {}
    },
