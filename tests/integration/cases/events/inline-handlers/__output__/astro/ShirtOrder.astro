---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const size = "M" as string;
const quantity = 1 as number;
const note = "" as string;
---

<section
  class:list={["shirt-order", className]}
  aria-label="Shirt order"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <p role="status">{`${quantity} x size ${size}`}</p>
  <div role="group" aria-label="Size">
    <button type="button" value="S" aria-pressed={size === "S"}>Small</button>
    <button type="button" value="M" aria-pressed={size === "M"}>Medium</button>
    <button type="button" value="L" aria-pressed={size === "L"}>Large</button>
  </div>
  <button type="button">Add one</button>
  <label>Note<input name="note" /></label>
  <p>Note: {note}</p>
  <button type="button">Reset</button>
</section>
