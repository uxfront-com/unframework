---
export interface CityPickerProps {
  cities: string[];
}

interface Props extends CityPickerProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { cities, class: className, style } = Astro.props;

function uniqueId(): string {
  const locals = Astro.locals as { ufIdCount?: number };
  locals.ufIdCount = (locals.ufIdCount ?? 0) + 1;
  return `uf-id-${locals.ufIdCount}`;
}

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const listId = uniqueId();
const query = "" as string;
const open = false as boolean;
const active = -1 as number;
const chosen = "" as string;
const notes = [] as string[];
const matches = cities.filter((city) => city.toLowerCase().startsWith(query.toLowerCase()));
---

<section
  class:list={["city-picker", className]}
  aria-label="Trip"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <form role="search" aria-label="Destination">
    <label>City<input
      type="search"
      name="city"
      role="combobox"
      aria-autocomplete="list"
      aria-controls={open ? listId : undefined}
      aria-expanded={open}
      aria-activedescendant={open && active >= 0 ? `${listId}-${active}` : undefined}
    /></label>
    {open ? (
      <div id={listId} role="listbox" aria-label="Cities">
        {matches.map((city, index) => (
          <button
            type="button"
            id={`${listId}-${index}`}
            role="option"
            tabindex="-1"
            aria-selected={index === active}
          >{city}</button>
        ))}
      </div>
    ) : null}
    <button type="submit">Search</button>
  </form>
  <p role="status">{chosen === "" ? "No city chosen" : `Chosen: ${chosen}`}</p>
  <label>Note<textarea name="note"></textarea></label>
  <ul aria-label="Notes">
    {notes.map((note) => (
      <li>{note}</li>
    ))}
  </ul>
</section>
