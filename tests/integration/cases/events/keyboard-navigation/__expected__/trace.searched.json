{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Search' })",
      "dom": [
        "<section aria-label=\"Trip\" class=\"city-picker\">",
        "  <form aria-label=\"Destination\" role=\"search\">",
        "    <label>",
        "      \"City\"",
        "      <input aria-autocomplete=\"list\" aria-expanded=\"false\" name=\"city\" role=\"combobox\" type=\"search\" uf:value=\"\">",
        "    </label>",
        "    <button type=\"submit\" uf:focused=\"\">",
        "      \"Search\"",
        "    </button>",
        "  </form>",
        "  <p role=\"status\">",
        "    \"No city chosen\"",
        "  </p>",
        "  <label>",
        "    \"Note\"",
        "    <textarea name=\"note\" uf:value=\"\"></textarea>",
        "  </label>",
        "  <ul aria-label=\"Notes\"></ul>",
        "</section>"
      ],
      "aria": [
        "- region \"Trip\":",
        "  - search \"Destination\":",
        "    - text: City",
        "    - combobox \"City\"",
        "    - button \"Search\"",
        "  - status: No city chosen",
        "  - text: Note",
        "  - textbox \"Note\"",
        "  - list \"Notes\""
      ],
      "events": {}
    }
  ]
}
