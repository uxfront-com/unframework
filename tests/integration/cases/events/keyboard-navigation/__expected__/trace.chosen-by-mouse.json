{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('option', { name: 'Basel' })",
      "dom": [
        "<section aria-label=\"Trip\" class=\"city-picker\">",
        "  <form aria-label=\"Destination\" role=\"search\">",
        "    <label>",
        "      \"City\"",
        "      <input aria-autocomplete=\"list\" aria-expanded=\"false\" name=\"city\" role=\"combobox\" type=\"search\" uf:focused=\"\" uf:value=\"Ba\">",
        "    </label>",
        "    <button type=\"submit\">",
        "      \"Search\"",
        "    </button>",
        "  </form>",
        "  <p role=\"status\">",
        "    \"Chosen: Basel\"",
        "  </p>",
        "  <label>",
        "    \"Note\"",
        "    <textarea name=\"note\" uf:value=\"\"></textarea>",
        "  </label>",
        "  <ul aria-label=\"Notes\"></ul>",
        "</section>"
      ],
      "aria": [
        "- region \"Trip\":",
        "  - search \"Destination\":",
        "    - text: City",
        "    - combobox \"City\": Ba",
        "    - button \"Search\"",
        "  - status: \"Chosen: Basel\"",
        "  - text: Note",
        "  - textbox \"Note\"",
        "  - list \"Notes\""
      ],
      "events": {
        "chose": [
          [
            "Basel"
          ]
        ]
      }
    }
  ]
}
