{
  "version": 1,
  "steps": [
    {
      "action": "type getByRole('textbox', { name: 'Note' }) \"Pack light{Enter}\"",
      "dom": [
        "<section aria-label=\"Trip\" class=\"city-picker\">",
        "  <form aria-label=\"Destination\" role=\"search\">",
        "    <label>",
        "      \"City\"",
        "      <input aria-autocomplete=\"list\" aria-expanded=\"false\" name=\"city\" role=\"combobox\" type=\"search\" uf:value=\"\">",
        "    </label>",
        "    <button type=\"submit\">",
        "      \"Search\"",
        "    </button>",
        "  </form>",
        "  <p role=\"status\">",
        "    \"No city chosen\"",
        "  </p>",
        "  <label>",
        "    \"Note\"",
        "    <textarea name=\"note\" uf:focused=\"\" uf:value=\"\"></textarea>",
        "  </label>",
        "  <ul aria-label=\"Notes\">",
        "    <li>",
        "      \"Pack light\"",
        "    </li>",
        "  </ul>",
        "</section>"
      ],
      "aria": [
        "- region \"Trip\":",
        "  - search \"Destination\":",
        "    - text: City",
        "    - combobox \"City\"",
        "    - button \"Search\"",
        "  - status: No city chosen",
        "  - text: Note",
        "  - textbox \"Note\"",
        "  - list \"Notes\":",
        "    - listitem: Pack light"
      ],
      "events": {
        "noted": [
          [
            "Pack light"
          ]
        ]
      }
    }
  ]
}
