                "event": "KeyboardEvent",
                "span": {
                  "start": 400,
                  "end": 420
                }
              }
            ],
            "body": {
              "code": "{\n    if (event.key === \"Enter\") event.preventDefault();\n    if (event.key === \"ArrowDown\") {\n      active.value = (active.value + 1) % commands.length;\n    } else if (event.key === \"ArrowUp\") {\n      active.value = (active.value + commands.length - 1) % commands.length;\n    } else if (event.key === \"Enter\") {\n      emit(\"run\", commands[active.value] ?? query.value);\n    } else if (event.key === \"Escape\") {\n      active.value = 0;\n      emit(\"dismiss\");\n    }\n  }",
              "span": {
                "start": 422,
                "end": 889
