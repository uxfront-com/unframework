---
export interface CommandMenuProps {
  commands: string[];
}

interface Props extends CommandMenuProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { commands, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const active = 0 as number;
---

<section
  class:list={["command-menu", className]}
  aria-label="Command menu"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <form role="search" aria-label="Commands">
    <label>Command<input name="command" /></label>
  </form>
  <ul aria-label="Suggestions">
    {commands.map((command, index) => (
      <li aria-current={index === active ? "true" : undefined}>{command}</li>
    ))}
  </ul>
  <label>Shortcut name<input name="shortcut" /></label>
</section>
