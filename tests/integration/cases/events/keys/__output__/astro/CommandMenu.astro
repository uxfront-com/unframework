---
import type { HTMLAttributes } from "astro/types";

export interface CommandMenuProps {
  commands: string[];
}

interface Props extends CommandMenuProps, Omit<HTMLAttributes<"section">, "commands"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { commands, class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const active = 0 as number;
---

<section
  class:list={["command-menu", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Command menu"}
  style={style}
  {...attrs}
>
  <form role="search" aria-label="Commands">
    <label>Command<input name="command" /></label>
  </form>
  <ul aria-label="Suggestions">
    {commands.map((command, index) => (
      <li aria-current={index === active ? "true" : undefined}>{command}</li>
    ))}
  </ul>
  <label>Shortcut name<input name="shortcut" /></label>
</section>
