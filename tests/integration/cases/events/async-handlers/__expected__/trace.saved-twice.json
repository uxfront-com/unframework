{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Save the draft' })",
      "dom": [
        "<section aria-label=\"Draft\" class=\"save-draft\">",
        "  <p role=\"status\">",
        "    \"Saved, attempt 1\"",
        "  </p>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Save the draft\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Draft\":",
        "  - status: Saved, attempt 1",
        "  - button \"Save the draft\""
      ],
      "events": {
        "saved": [
          [
            1,
            "Saved, attempt 1"
          ]
        ]
      }
    },
    {
      "action": "click getByRole('button', { name: 'Save the draft' })",
      "dom": [
        "<section aria-label=\"Draft\" class=\"save-draft\">",
        "  <p role=\"status\">",
        "    \"Saved, attempt 2\"",
        "  </p>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Save the draft\"",
        "  </button>",
        "</section>"
      ],
      "aria": [
        "- region \"Draft\":",
        "  - status: Saved, attempt 2",
        "  - button \"Save the draft\""
      ],
      "events": {
        "saved": [
          [
            2,
            "Saved, attempt 2"
          ]
        ]
      }
    }
  ]
}
