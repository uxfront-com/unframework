---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const status = "Not saved" as string;
---

<section
  class:list={["save-draft", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Draft"}
  style={style}
  {...attrs}
>
  <p role="status">{status}</p>
  <button type="button">Save the draft</button>
</section>
