---
export interface Meeting {
  id: number;
  title: string;
  done: boolean;
}

export interface Organiser {
  name: string;
}

export interface MeetingListProps {
  meetings: Meeting[];
  organiser?: Organiser;
}

interface Props extends MeetingListProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { meetings, organiser, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const rooms = ["Atlas", "Borealis"];
const log = [] as string[];
const lastKey = "none" as string;
const clicks = 0 as number;
const upcoming = meetings.filter((meeting) => !meeting.done);
---

<section
  class:list={["meeting-list", className]}
  aria-label="Meetings"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <ul aria-label="Upcoming">
    {upcoming.map((event) => (
      <li>
        <button type="button">{event.title}</button>
      </li>
    ))}
  </ul>
  <ul aria-label="Rooms">
    {rooms.map((room) => (
      <li>
        <button type="button">{room}</button>
      </li>
    ))}
  </ul>
  {organiser ? (
    <button type="button">{`Thank ${organiser.name}`}</button>
  ) : (
    <p>No organiser</p>
  )}
  <button type="button">Track</button>
  <p>Clicks: {clicks}</p>
  <label>Filter<input name="filter" /></label>
  <p>Last key: {lastKey}</p>
  <ol aria-label="Log">
    {log.map((line) => (
      <li>{line}</li>
    ))}
  </ol>
</section>
