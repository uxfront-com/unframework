      "action": "click getByRole('button', { name: 'Track' })",
      "dom": [
        "<section aria-label=\"Meetings\" class=\"meeting-list\">",
        "  <ul aria-label=\"Upcoming\">",
        "    <li>",
        "      <button type=\"button\">",
        "        \"Standup\"",
        "      </button>",
        "    </li>",
        "    <li>",
        "      <button type=\"button\">",
        "        \"Review\"",
        "      </button>",
        "    </li>",
        "  </ul>",
