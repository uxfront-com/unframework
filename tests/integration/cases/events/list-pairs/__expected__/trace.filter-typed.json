{
  "version": 1,
  "steps": [
    {
      "action": "type getByRole('textbox', { name: 'Filter' }) \"ok\"",
      "dom": [
        "<section aria-label=\"Meetings\" class=\"meeting-list\">",
        "  <ul aria-label=\"Upcoming\">",
        "    <li>",
        "      <button type=\"button\">",
        "        \"Standup\"",
        "      </button>",
        "    </li>",
        "    <li>",
        "      <button type=\"button\">",
        "        \"Review\"",
        "      </button>",
        "    </li>",
        "  </ul>",
        "  <ul aria-label=\"Rooms\">",
        "    <li>",
        "      <button type=\"button\">",
        "        \"Atlas\"",
        "      </button>",
        "    </li>",
        "    <li>",
        "      <button type=\"button\">",
        "        \"Borealis\"",
        "      </button>",
        "    </li>",
        "  </ul>",
        "  <button type=\"button\">",
        "    \"Thank Ada\"",
        "  </button>",
        "  <button type=\"button\">",
        "    \"Track\"",
        "  </button>",
        "  <p>",
        "    \"Clicks: 0\"",
        "  </p>",
        "  <label>",
        "    \"Filter\"",
        "    <input name=\"filter\" uf:focused=\"\" uf:value=\"ok\">",
        "  </label>",
        "  <p>",
        "    \"Last key: k\"",
        "  </p>",
        "  <ol aria-label=\"Log\"></ol>",
        "</section>"
      ],
      "aria": [
        "- region \"Meetings\":",
        "  - list \"Upcoming\":",
        "    - listitem:",
        "      - button \"Standup\"",
        "    - listitem:",
        "      - button \"Review\"",
        "  - list \"Rooms\":",
        "    - listitem:",
        "      - button \"Atlas\"",
        "    - listitem:",
        "      - button \"Borealis\"",
        "  - button \"Thank Ada\"",
        "  - button \"Track\"",
        "  - paragraph: \"Clicks: 0\"",
        "  - text: Filter",
        "  - textbox \"Filter\": ok",
        "  - paragraph: \"Last key: k\"",
        "  - list \"Log\""
      ],
      "events": {}
    }
  ]
}
