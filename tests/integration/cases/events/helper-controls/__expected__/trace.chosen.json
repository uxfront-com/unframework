{
  "version": 1,
  "steps": [
    {
      "action": "selectOptions getByRole('combobox', { name: 'Scope' }) [\"team\"]",
      "dom": [
        "<section aria-label=\"Quick actions\" class=\"quick-actions\">",
        "  <label>",
        "    \"Search\"",
        "    <input name=\"query\" uf:value=\"\">",
        "  </label>",
        "  <p>",
        "    \"Query:\"",
        "  </p>",
        "  <label>",
        "    \"Note\"",
        "    <input name=\"note\" uf:value=\"\">",
        "  </label>",
        "  <label>",
        "    \"Scope\"",
        "    <select name=\"scope\">",
        "      <option uf:selected=\"false\" value=\"mine\">",
        "        \"Mine\"",
        "      </option>",
        "      <option uf:selected=\"true\" value=\"team\">",
        "        \"Team\"",
        "      </option>",
        "    </select>",
        "  </label>",
        "  <ul aria-label=\"Actions\">",
        "    <li>",
        "      <label>",
        "        \"Shortcut for Copy\"",
        "        <input name=\"Copy\" uf:value=\"\">",
        "      </label>",
        "      <button type=\"button\">",
        "        \"Run Copy\"",
        "      </button>",
        "    </li>",
        "    <li>",
        "      <label>",
        "        \"Shortcut for Paste\"",
        "        <input name=\"Paste\" uf:value=\"\">",
        "      </label>",
        "      <button type=\"button\">",
        "        \"Run Paste\"",
        "      </button>",
        "    </li>",
        "  </ul>",
        "  <p>",
        "    \"Last key: none\"",
        "  </p>",
        "  <form aria-label=\"Subscribe\" class=\"subscribe\">",
        "    <p>",
        "      \"Subscriptions: 0\"",
        "    </p>",
        "    <button type=\"submit\">",
        "      \"Subscribe\"",
        "    </button>",
        "  </form>",
        "</section>"
      ],
      "aria": [
        "- region \"Quick actions\":",
        "  - text: Search",
        "  - textbox \"Search\"",
        "  - paragraph: \"Query:\"",
        "  - text: Note",
        "  - textbox \"Note\"",
        "  - text: Scope",
        "  - combobox \"Scope\":",
        "    - option \"Mine\"",
        "    - option \"Team\" [selected]",
        "  - list \"Actions\":",
        "    - listitem:",
        "      - text: Shortcut for Copy",
        "      - textbox \"Shortcut for Copy\"",
        "      - button \"Run Copy\"",
        "    - listitem:",
        "      - text: Shortcut for Paste",
        "      - textbox \"Shortcut for Paste\"",
        "      - button \"Run Paste\"",
        "  - paragraph: \"Last key: none\"",
        "  - form \"Subscribe\":",
        "    - paragraph: \"Subscriptions: 0\"",
        "    - button \"Subscribe\""
      ],
      "events": {}
    },
    {
