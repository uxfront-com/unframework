---
export interface QuickActionsProps {
  actions: string[];
}

interface Props extends QuickActionsProps {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { actions, class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const query = "" as string;
const lastKey = "none" as string;
const subscriptions = 0 as number;
---

<section
  class:list={["quick-actions", className]}
  aria-label="Quick actions"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <label>Search<input name="query" /></label>
  <p>Query: {query}</p>
  <label>Note<input name="note" /></label>
  <label>Scope<select
    name="scope"
  ><option value="mine">Mine</option><option value="team">Team</option></select></label>
  <ul aria-label="Actions">
    {actions.map((action) => (
      <li>
        <label>{`Shortcut for ${action}`}<input name={action} /></label>
        <button type="button">{`Run ${action}`}</button>
      </li>
    ))}
  </ul>
  <p>Last key: {lastKey}</p>
  <form class="subscribe" aria-label="Subscribe">
    <p>Subscriptions: {subscriptions}</p>
    <button type="submit">Subscribe</button>
  </form>
</section>
