{
  "version": 1,
  "steps": [
    {
      "action": "type getByLabel('Name') \"Ada\"",
      "dom": [
        "<form aria-label=\"Sign up\" class=\"signup-form\">",
        "  <label>",
        "    \"Name\"",
        "    <input name=\"name\" uf:focused=\"\" uf:value=\"Ada\">",
        "  </label>",
        "  <label>",
        "    \"Email\"",
        "    <input name=\"email\" type=\"email\" uf:value=\"\">",
        "  </label>",
        "  <label>",
        "    \"Plan\"",
        "    <select name=\"plan\">",
        "      <option uf:selected=\"true\" value=\"free\">",
        "        \"Free\"",
        "      </option>",
        "      <option uf:selected=\"false\" value=\"pro\">",
        "        \"Pro\"",
        "      </option>",
        "    </select>",
        "  </label>",
        "  <label>",
        "    <input name=\"newsletter\" type=\"checkbox\" uf:checked=\"false\" uf:indeterminate=\"false\">",
        "    \"Send me the newsletter\"",
        "  </label>",
        "  <p role=\"status\">",
        "    \"Name: ; email: ; plan: free; newsletter: no; focus: name\"",
        "  </p>",
        "  <button type=\"submit\">",
        "    \"Sign up\"",
        "  </button>",
        "</form>"
      ],
      "aria": [
        "- form \"Sign up\":",
        "  - text: Name",
        "  - textbox \"Name\": Ada",
        "  - text: Email",
        "  - textbox \"Email\"",
        "  - text: Plan",
        "  - combobox \"Plan\":",
        "    - option \"Free\" [selected]",
        "    - option \"Pro\"",
        "  - checkbox \"Send me the newsletter\"",
        "  - text: Send me the newsletter",
        "  - status: \"Name: ; email: ; plan: free; newsletter: no; focus: name\"",
        "  - button \"Sign up\""
      ],
      "events": {}
    }
  ]
}
