{
  "version": 1,
  "steps": [
    {
      "action": "selectOptions getByRole('combobox', { name: 'Plan' }) [\"pro\"]",
      "dom": [
        "<form aria-label=\"Sign up\" class=\"signup-form\">",
        "  <label>",
        "    \"Name\"",
        "    <input name=\"name\" uf:value=\"\">",
        "  </label>",
        "  <label>",
        "    \"Email\"",
        "    <input name=\"email\" type=\"email\" uf:value=\"\">",
        "  </label>",
        "  <label>",
        "    \"Plan\"",
        "    <select name=\"plan\">",
        "      <option uf:selected=\"false\" value=\"free\">",
        "        \"Free\"",
        "      </option>",
        "      <option uf:selected=\"true\" value=\"pro\">",
        "        \"Pro\"",
        "      </option>",
        "    </select>",
        "  </label>",
        "  <label>",
        "    <input name=\"newsletter\" type=\"checkbox\" uf:checked=\"false\" uf:indeterminate=\"false\">",
        "    \"Send me the newsletter\"",
        "  </label>",
        "  <p role=\"status\">",
        "    \"Name: ; email: ; plan: pro; newsletter: no; focus: none\"",
        "  </p>",
        "  <button type=\"submit\">",
        "    \"Sign up\"",
        "  </button>",
        "</form>"
      ],
      "aria": [
        "- form \"Sign up\":",
        "  - text: Name",
        "  - textbox \"Name\"",
        "  - text: Email",
        "  - textbox \"Email\"",
        "  - text: Plan",
        "  - combobox \"Plan\":",
        "    - option \"Free\"",
        "    - option \"Pro\" [selected]",
        "  - checkbox \"Send me the newsletter\"",
        "  - text: Send me the newsletter",
        "  - status: \"Name: ; email: ; plan: pro; newsletter: no; focus: none\"",
        "  - button \"Sign up\""
      ],
      "events": {}
    },
