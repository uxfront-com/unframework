---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const fullName = "" as string;
const email = "" as string;
const plan = "free" as string;
const newsletter = false as boolean;
const focused = "none" as string;
---

<form
  class:list={["signup-form", className]}
  aria-label="Sign up"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <label>Name<input name="name" /></label>
  <label>Email<input name="email" type="email" /></label>
  <label>Plan<select
    name="plan"
  ><option value="free">Free</option><option value="pro">Pro</option></select></label>
  <label><input name="newsletter" type="checkbox" />Send me the newsletter</label>
  <p
    role="status"
  >{`Name: ${fullName}; email: ${email}; plan: ${plan}; newsletter: ${newsletter ? "yes" : "no"}; focus: ${focused}`}</p>
  <button type="submit">Sign up</button>
</form>
