{
  "version": 1,
  "steps": [
    {
      "action": "keyboard \"d\"",
      "dom": [
        "<section aria-label=\"Comment\" class=\"comment-card\">",
        "  <label>",
        "    \"Comment\"",
        "    <textarea name=\"comment\" rows=\"2\" style=\"height: 4.5em;\" uf:focused=\"\" uf:value=\"a\\nb\\ncd\"></textarea>",
        "  </label>",
        "  <div class=\"meter\" role=\"presentation\">",
        "    <div class=\"fill\" style=\"width: 6%;\"></div>",
        "  </div>",
        "  <p>",
        "    \"6 characters\"",
        "  </p>",
        "  <div aria-pressed=\"false\" class=\"like\" role=\"button\" tabindex=\"0\">",
        "    \"Like\"",
        "  </div>",
        "</section>"
      ],
      "aria": [
        "- region \"Comment\":",
        "  - text: Comment",
        "  - textbox \"Comment\": a b cd",
        "  - paragraph: 6 characters",
        "  - button \"Like\""
      ],
      "events": {}
    }
  ]
}
