---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const text = "" as string;
const liked = false as boolean;
---

<section
  class:list={["comment-card", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Comment"}
  style={style}
  {...attrs}
>
  <label>Comment<textarea name="comment" rows="2"></textarea></label>
  <div class="meter" role="presentation">
    <div class="fill" style={{ width: `${Math.min(text.length, 100)}%` }}></div>
  </div>
  <p>{text.length} characters</p>
  <div class="like" role="button" tabindex="0" aria-pressed={liked}>Like</div>
</section>
