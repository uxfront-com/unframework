---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style, "aria-label": ariaLabel, ...attrs } = Astro.props;

const saves = 0 as number;
const lastKey = "none" as string;
const tags = [] as string[];
---

<section
  class:list={["note-editor", className]}
  aria-label={"aria-label" in Astro.props ? ariaLabel : "Note"}
  style={style}
  {...attrs}
>
  <button type="button">Save</button>
  <label>Title<input name="title" /></label>
  <label>Body<textarea name="body"></textarea></label>
  <p role="status">Saved {saves} times, last key {lastKey}</p>
  <button type="button">Save and close</button>
  <label>Tag<input name="tag" /></label>
  <button type="button">Add tag</button>
  <p>Tags: {tags.join(", ")}</p>
</section>
