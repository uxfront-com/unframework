{
  "version": 1,
  "steps": [
    {
      "action": "type getByLabel('Tag') \"work\"",
      "dom": [
        "<section aria-label=\"Note\" class=\"note-editor\">",
        "  <button type=\"button\">",
        "    \"Save\"",
        "  </button>",
        "  <label>",
        "    \"Title\"",
        "    <input name=\"title\" uf:value=\"\">",
        "  </label>",
        "  <label>",
        "    \"Body\"",
        "    <textarea name=\"body\" uf:value=\"\"></textarea>",
        "  </label>",
        "  <p role=\"status\">",
        "    \"Saved 0 times, last key none\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Save and close\"",
        "  </button>",
        "  <label>",
        "    \"Tag\"",
        "    <input name=\"tag\" uf:focused=\"\" uf:value=\"work\">",
        "  </label>",
        "  <button type=\"button\">",
        "    \"Add tag\"",
        "  </button>",
        "  <p>",
        "    \"Tags: home\"",
        "  </p>",
        "</section>"
      ],
      "aria": [
        "- region \"Note\":",
        "  - button \"Save\"",
        "  - text: Title",
        "  - textbox \"Title\"",
        "  - text: Body",
        "  - textbox \"Body\"",
        "  - status: Saved 0 times, last key none",
        "  - button \"Save and close\"",
        "  - text: Tag",
        "  - textbox \"Tag\": work",
        "  - button \"Add tag\"",
        "  - paragraph: \"Tags: home\""
      ],
      "events": {}
    },
    {
      "action": "click getByRole('button', { name: 'Add tag' })",
      "dom": [
        "<section aria-label=\"Note\" class=\"note-editor\">",
        "  <button type=\"button\">",
        "    \"Save\"",
        "  </button>",
        "  <label>",
        "    \"Title\"",
        "    <input name=\"title\" uf:value=\"\">",
        "  </label>",
        "  <label>",
        "    \"Body\"",
        "    <textarea name=\"body\" uf:value=\"\"></textarea>",
        "  </label>",
        "  <p role=\"status\">",
        "    \"Saved 0 times, last key none\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Save and close\"",
        "  </button>",
        "  <label>",
        "    \"Tag\"",
        "    <input name=\"tag\" uf:value=\"\">",
        "  </label>",
        "  <button type=\"button\" uf:focused=\"\">",
        "    \"Add tag\"",
        "  </button>",
        "  <p>",
        "    \"Tags: home, work\"",
        "  </p>",
        "</section>"
      ],
      "aria": [
        "- region \"Note\":",
        "  - button \"Save\"",
        "  - text: Title",
        "  - textbox \"Title\"",
        "  - text: Body",
        "  - textbox \"Body\"",
        "  - status: Saved 0 times, last key none",
        "  - button \"Save and close\"",
        "  - text: Tag",
        "  - textbox \"Tag\"",
        "  - button \"Add tag\"",
        "  - paragraph: \"Tags: home, work\""
      ],
      "events": {
        "tagged": [
          [
            "work",
            "click"
          ]
        ]
      }
    }
  ]
}
