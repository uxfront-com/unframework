{
  "version": 1,
  "steps": [
    {
      "action": "type getByLabel('Title') \"a\"",
      "dom": [
        "<section aria-label=\"Note\" class=\"note-editor\">",
        "  <button type=\"button\">",
        "    \"Save\"",
        "  </button>",
        "  <label>",
        "    \"Title\"",
        "    <input name=\"title\" uf:focused=\"\" uf:value=\"a\">",
        "  </label>",
        "  <label>",
        "    \"Body\"",
        "    <textarea name=\"body\" uf:value=\"\"></textarea>",
        "  </label>",
        "  <p role=\"status\">",
        "    \"Saved 0 times, last key a\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Save and close\"",
        "  </button>",
        "  <label>",
        "    \"Tag\"",
        "    <input name=\"tag\" uf:value=\"\">",
        "  </label>",
        "  <button type=\"button\">",
        "    \"Add tag\"",
        "  </button>",
        "  <p>",
        "    \"Tags:\"",
        "  </p>",
        "</section>"
      ],
      "aria": [
        "- region \"Note\":",
        "  - button \"Save\"",
        "  - text: Title",
        "  - textbox \"Title\": a",
        "  - text: Body",
        "  - textbox \"Body\"",
        "  - status: Saved 0 times, last key a",
        "  - button \"Save and close\"",
        "  - text: Tag",
        "  - textbox \"Tag\"",
        "  - button \"Add tag\"",
        "  - paragraph: \"Tags:\""
      ],
      "events": {}
    },
    {
      "action": "type getByLabel('Body') \"b\"",
      "dom": [
        "<section aria-label=\"Note\" class=\"note-editor\">",
        "  <button type=\"button\">",
        "    \"Save\"",
        "  </button>",
        "  <label>",
        "    \"Title\"",
        "    <input name=\"title\" uf:value=\"a\">",
        "  </label>",
        "  <label>",
        "    \"Body\"",
        "    <textarea name=\"body\" uf:focused=\"\" uf:value=\"b\"></textarea>",
        "  </label>",
        "  <p role=\"status\">",
        "    \"Saved 0 times, last key b\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Save and close\"",
        "  </button>",
        "  <label>",
        "    \"Tag\"",
        "    <input name=\"tag\" uf:value=\"\">",
        "  </label>",
        "  <button type=\"button\">",
        "    \"Add tag\"",
        "  </button>",
        "  <p>",
        "    \"Tags:\"",
        "  </p>",
        "</section>"
      ],
      "aria": [
        "- region \"Note\":",
        "  - button \"Save\"",
        "  - text: Title",
        "  - textbox \"Title\": a",
        "  - text: Body",
        "  - textbox \"Body\": b",
        "  - status: Saved 0 times, last key b",
        "  - button \"Save and close\"",
        "  - text: Tag",
        "  - textbox \"Tag\"",
        "  - button \"Add tag\"",
        "  - paragraph: \"Tags:\""
      ],
      "events": {}
    },
    {
      "action": "keyboard \"{Escape}\"",
      "dom": [
        "<section aria-label=\"Note\" class=\"note-editor\">",
        "  <button type=\"button\">",
        "    \"Save\"",
        "  </button>",
        "  <label>",
        "    \"Title\"",
        "    <input name=\"title\" uf:value=\"a\">",
        "  </label>",
        "  <label>",
        "    \"Body\"",
        "    <textarea name=\"body\" uf:focused=\"\" uf:value=\"b\"></textarea>",
        "  </label>",
        "  <p role=\"status\">",
        "    \"Saved 0 times, last key Escape\"",
        "  </p>",
        "  <button type=\"button\">",
        "    \"Save and close\"",
        "  </button>",
        "  <label>",
        "    \"Tag\"",
        "    <input name=\"tag\" uf:value=\"\">",
        "  </label>",
        "  <button type=\"button\">",
        "    \"Add tag\"",
        "  </button>",
        "  <p>",
        "    \"Tags:\"",
        "  </p>",
        "</section>"
      ],
      "aria": [
        "- region \"Note\":",
        "  - button \"Save\"",
        "  - text: Title",
        "  - textbox \"Title\": a",
        "  - text: Body",
        "  - textbox \"Body\": b",
        "  - status: Saved 0 times, last key Escape",
        "  - button \"Save and close\"",
        "  - text: Tag",
        "  - textbox \"Tag\"",
        "  - button \"Add tag\"",
        "  - paragraph: \"Tags:\""
      ],
      "events": {}
    }
  ]
}
