{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Reset' })",
      "dom": [
        "<section aria-label=\"Listener order\" class=\"listener-order\">",
        "  <div class=\"toolbar\" role=\"presentation\">",
        "    <button type=\"button\">",
        "      \"Save\"",
        "    </button>",
        "    <button type=\"button\">",
        "      \"Send\"",
        "    </button>",
        "    <button type=\"button\" uf:focused=\"\">",
        "      \"Reset\"",
        "    </button>",
        "  </div>",
        "  <div class=\"panel\" role=\"presentation\">",
        "    <button type=\"button\">",
        "      \"Inside\"",
        "    </button>",
        "  </div>",
        "  <button type=\"button\">",
        "    \"Outside\"",
        "  </button>",
        "  <div class=\"claim\" role=\"presentation\">",
        "    <button type=\"button\">",
        "      \"Stop\"",
        "    </button>",
        "    <button type=\"button\">",
        "      \"Pass\"",
        "    </button>",
        "  </div>",
        "  <div aria-label=\"Outer zone\" class=\"outer-zone\" role=\"group\">",
        "    <div aria-label=\"Inner zone\" class=\"inner-zone\" role=\"group\">",
        "      \"Scroll here\"",
        "    </div>",
        "  </div>",
        "  <p>",
        "    \"Resets: 1\"",
        "  </p>",
        "  <ol aria-label=\"Log\">",
        "    <li>",
        "      \"reset\"",
        "    </li>",
        "    <li>",
        "      \"toolbar\"",
        "    </li>",
        "  </ol>",
        "</section>"
      ],
      "aria": [
        "- region \"Listener order\":",
        "  - button \"Save\"",
        "  - button \"Send\"",
        "  - button \"Reset\"",
        "  - button \"Inside\"",
        "  - button \"Outside\"",
        "  - button \"Stop\"",
        "  - button \"Pass\"",
        "  - group \"Outer zone\":",
        "    - group \"Inner zone\": Scroll here",
        "  - paragraph: \"Resets: 1\"",
        "  - list \"Log\":",
        "    - listitem: reset",
        "    - listitem: toolbar"
      ],
      "events": {}
    },
