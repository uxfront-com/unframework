---
interface Props {
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { class: className, style } = Astro.props;

/** The scope attributes of the styled parents that render this component, for its root. */
function scopeAttributes(props: object): Record<string, ""> {
  const scope: Record<string, ""> = {};
  for (const name of Object.keys(props)) if (name.startsWith("data-uf-")) scope[name] = "";
  return scope;
}

const log = [] as string[];
const resets = 0 as number;
---

<section
  class:list={["listener-order", className]}
  aria-label="Listener order"
  style={style}
  {...scopeAttributes(Astro.props)}
>
  <div class="toolbar" role="presentation">
    <button type="button">Save</button>
    <button type="button">Send</button>
    <button type="button">Reset</button>
  </div>
  <div class="panel" role="presentation">
    <button type="button">Inside</button>
  </div>
  <button type="button">Outside</button>
  <div class="claim" role="presentation">
    <button type="button">Stop</button>
    <button type="button">Pass</button>
  </div>
  <div class="outer-zone" role="group" aria-label="Outer zone">
    <div class="inner-zone" role="group" aria-label="Inner zone">Scroll here</div>
  </div>
  <p>Resets: {resets}</p>
  <ol aria-label="Log">
    {log.map((entry) => (
      <li>{entry}</li>
    ))}
  </ol>
</section>
