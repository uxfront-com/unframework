---
import type { HTMLAttributes } from "astro/types";
import "virtual:styleframe.css";

interface Props extends Omit<HTMLAttributes<"section">, "text" | "dark"> {
  text: string;
  dark?: boolean;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const {
  text,
  dark = false,
  class: className,
  style,
  "data-theme": dataTheme,
  ...attrs
} = Astro.props;
---

<section
  data-theme={"data-theme" in Astro.props ? dataTheme : dark ? "dark" : "light"}
  class:list={["_padding:md _background-color:surface _color:text", className]}
  style={style}
  {...attrs}
>{text}</section>
