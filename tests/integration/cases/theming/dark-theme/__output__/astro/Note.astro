---
import type { HTMLAttributes } from "astro/types";
import "virtual:styleframe.css";

interface Props extends Omit<HTMLAttributes<"p">, "text"> {
  text: string;
  class?: string;
  style?: Record<string, string | number | undefined>;
}

const { text, class: className, style, ...attrs } = Astro.props;
---

<p
  class:list={["_padding:md _background-color:surface _color:text", className]}
  style={style}
  {...attrs}
>{text}</p>
