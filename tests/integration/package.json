    "test": "node scripts/run.ts",
    "test:update": "node scripts/run.ts --update",
    "test:canaries": "node scripts/canaries.ts",
    "test:budgets:update": "node scripts/budgets.ts --update",
    "budgets": "node scripts/budgets.ts",
