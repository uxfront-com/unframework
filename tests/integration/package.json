{
  "name": "@unframework/integration",
  "version": "0.0.0",
  "private": true,
  "description": "The integration corpus and its harness: every case compiled to all seven targets and verified at every live layer.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-browser.ts",
    "test": "node scripts/run.ts",
    "test:update": "node scripts/run.ts --update",
    "test:canaries": "node scripts/canaries.ts",
    "test:baselines": "bash scripts/baselines.sh update",
    "test:baselines:check": "bash scripts/baselines.sh check",
    "summary": "node scripts/summary.ts",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.cases.json"
  },
  "devDependencies": {
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/core": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/platform-server": "catalog:",
    "@fontsource/inter": "catalog:",
    "@qwik.dev/core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@unframework/codegen": "workspace:*",
    "@unframework/compiler": "workspace:*",
    "@unframework/diagnostics": "workspace:*",
    "@unframework/ir": "workspace:*",
    "@unframework/target-angular": "workspace:*",
    "@unframework/target-astro": "workspace:*",
    "@unframework/target-qwik": "workspace:*",
    "@unframework/target-react": "workspace:*",
    "@unframework/target-solid": "workspace:*",
    "@unframework/target-svelte": "workspace:*",
    "@unframework/target-vue": "workspace:*",
    "@unframework/testing": "workspace:*",
    "@unframework/unplugin": "workspace:*",
    "@uxfront/typescript-config": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "ajv": "catalog:",
    "astro": "catalog:",
    "axe-core": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rxjs": "catalog:",
    "solid-js": "catalog:",
    "svelte": "catalog:",
    "tslib": "catalog:",
    "unframework": "workspace:*",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
