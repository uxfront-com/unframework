{
  // Checks the app's .uf.tsx and .uf.ts files against unframework's JSX types (ADR-0073):
  // `tsc --noEmit -p tsconfig.uf.json`.
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "unframework"
  },
  "include": ["**/*.uf.tsx", "**/*.uf.ts"],
  "exclude": ["dist"]
}
