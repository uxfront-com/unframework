{
  // Checks the app's `.uf.tsx` and `.uf.ts` files against `@uxfront/unframework`'s JSX types (ADR-0080):
  // `pnpm exec tsc --noEmit -p tsconfig.uf.json`.
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "@uxfront/unframework"
  },
  "include": ["**/*.uf.tsx", "**/*.uf.ts"],
  "exclude": ["dist"]
}
