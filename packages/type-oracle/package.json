{
  "name": "@unframework/type-oracle",
  "version": "0.0.0",
  "private": true,
  "description": "The TypeOracle interface and the syntactic resolver.",
  "keywords": [
    "oxc",
    "types",
    "unframework"
  ],
  "homepage": "https://github.com/uxfront-com/unframework/tree/main/packages/type-oracle#readme",
  "bugs": "https://github.com/uxfront-com/unframework/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxfront-com/unframework.git",
    "directory": "packages/type-oracle"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./contract": {
        "types": "./dist/contract.d.ts",
        "default": "./dist/contract.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "oxc-parser": "catalog:",
    "oxc-resolver": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@uxfront/typescript-config": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  }
}
