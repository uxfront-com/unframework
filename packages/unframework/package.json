{
  "name": "@uxfront/unframework",
  "version": "0.1.0",
  "description": "Write a component once, get native React, Vue, Svelte, Solid, Angular, Qwik and Astro: the authoring API and JSX types for .uf.tsx components.",
  "keywords": [
    "angular",
    "astro",
    "compiler",
    "components",
    "jsx",
    "qwik",
    "react",
    "solid",
    "svelte",
    "unframework",
    "vue"
  ],
  "homepage": "https://github.com/uxfront-com/unframework/tree/main/packages/unframework#readme",
  "bugs": "https://github.com/uxfront-com/unframework/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxfront-com/unframework.git",
    "directory": "packages/unframework"
  },
  "bin": {
    "unframework": "bin/unframework.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./cli": "./src/cli.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "./cli": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      },
      "./jsx-runtime": {
        "types": "./dist/jsx-runtime.d.ts",
        "default": "./dist/jsx-runtime.js"
      },
      "./jsx-dev-runtime": {
        "types": "./dist/jsx-dev-runtime.d.ts",
        "default": "./dist/jsx-dev-runtime.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit && tsc --noEmit -p probes/tsconfig.json",
    "probes": "node scripts/run-probes.ts",
    "test": "vitest run",
    "vendor:jsx": "node scripts/vendor-jsx.ts"
  },
  "dependencies": {
    "@unframework.dev/cli": "workspace:*",
    "@unframework.dev/compiler": "workspace:*",
    "csstype": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@unframework.dev/testing": "workspace:*",
    "@unframework.dev/visual": "workspace:*",
    "@uxfront/typescript-config": "catalog:",
    "@vue/runtime-dom": "3.5.43",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "@unframework.dev/testing": "workspace:*",
    "@unframework.dev/visual": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@unframework.dev/testing": {
      "optional": true
    },
    "@unframework.dev/visual": {
      "optional": true
    }
  }
}
