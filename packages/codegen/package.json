{
  "name": "@unframework/codegen",
  "version": "0.0.0",
  "private": true,
  "description": "The Unframework target kit: defineTarget, the JS, JSX and markup printers with each syntax's escaping, the import manager and the oxfmt formatting step.",
  "keywords": [
    "codegen",
    "compiler",
    "target",
    "unframework"
  ],
  "homepage": "https://github.com/uxfront-com/unframework/tree/main/packages/codegen#readme",
  "bugs": "https://github.com/uxfront-com/unframework/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxfront-com/unframework.git",
    "directory": "packages/codegen"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./toolchain-node": "./src/toolchain-node/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./toolchain-node": {
        "types": "./dist/toolchain-node/index.d.ts",
        "default": "./dist/toolchain-node/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@oxc-project/types": "catalog:",
    "@standard-schema/spec": "catalog:",
    "@unframework/diagnostics": "workspace:*",
    "@unframework/ir": "workspace:*",
    "@unframework/parser": "workspace:*",
    "magic-string": "catalog:",
    "oxc-codegen": "catalog:",
    "oxfmt": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@unframework/analyzer": "workspace:*",
    "@uxfront/typescript-config": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
