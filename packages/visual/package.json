{
  "name": "@unframework.dev/visual",
  "version": "0.0.0",
  "private": true,
  "description": "Visual parity and the preview for a project's examples: discovers *.example.uf.tsx files, renders each on every target and compares geometry and pixels, live or against committed baselines, writes the run's report, and shows every example and component side by side on every target. Private until its first release.",
  "keywords": [
    "unframework"
  ],
  "homepage": "https://github.com/uxfront-com/unframework/tree/main/packages/visual#readme",
  "bugs": "https://github.com/uxfront-com/unframework/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxfront-com/unframework.git",
    "directory": "packages/visual"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./cli": "./src/cli.ts",
    "./frame": "./src/preview/frame.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "./cli": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      },
      "./frame": {
        "types": "./dist/preview/frame.d.ts",
        "default": "./dist/preview/frame.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@unframework.dev/codegen": "workspace:*",
    "@unframework.dev/compiler": "workspace:*",
    "@unframework.dev/diagnostics": "workspace:*",
    "@unframework.dev/ir": "workspace:*",
    "@unframework.dev/testing": "workspace:*",
    "@unframework.dev/unplugin": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@uxfront/typescript-config": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "@vitest/browser-playwright": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
