{
  "name": "@unframework/visual",
  "version": "0.0.0",
  "private": true,
  "description": "The Storybook preset and story generator of the visual harness: one catalogue per target, generated from a list of stories.",
  "keywords": [
    "unframework"
  ],
  "homepage": "https://github.com/uxfront-com/unframework/tree/main/packages/visual#readme",
  "bugs": "https://github.com/uxfront-com/unframework/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxfront-com/unframework.git",
    "directory": "packages/visual"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./preset": "./src/preset.ts",
    "./preview": "./src/preview.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./preset": {
        "types": "./dist/preset.d.ts",
        "default": "./dist/preset.js"
      },
      "./preview": {
        "types": "./dist/preview.d.ts",
        "default": "./dist/preview.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@unframework/testing": "workspace:*",
    "@unframework/unplugin": "workspace:*",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@uxfront/typescript-config": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
