{
	"name": "@unframework.dev/target-solid2",
	"version": "0.2.0",
	"description": "The Solid 2 target of the Unframework compiler, selected as solid@2: emits idiomatic Solid 2 components from the portable IR, declares their capabilities, and provides the toolchain the tests use.",
	"keywords": [
		"compiler",
		"solid",
		"unframework"
	],
	"homepage": "https://unframework.dev",
	"bugs": "https://github.com/uxfront-com/unframework/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/uxfront-com/unframework.git",
		"directory": "packages/target-solid2"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./toolchain": "./src/toolchain/index.ts",
		"./toolchain/client": "./src/toolchain/client.ts",
		"./toolchain/hydrate": "./src/toolchain/hydrate.ts",
		"./toolchain/server": "./src/toolchain/server.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./toolchain": {
				"types": "./dist/toolchain/index.d.ts",
				"default": "./dist/toolchain/index.js"
			},
			"./toolchain/client": {
				"types": "./dist/toolchain/client.d.ts",
				"default": "./dist/toolchain/client.js"
			},
			"./toolchain/hydrate": {
				"types": "./dist/toolchain/hydrate.d.ts",
				"default": "./dist/toolchain/hydrate.js"
			},
			"./toolchain/server": {
				"types": "./dist/toolchain/server.d.ts",
				"default": "./dist/toolchain/server.js"
			},
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@unframework.dev/codegen": "workspace:*",
		"@unframework.dev/ir": "workspace:*"
	},
	"devDependencies": {
		"@solidjs/compiler": "catalog:solid2",
		"@solidjs/vite-plugin": "catalog:solid2",
		"@solidjs/web": "catalog:solid2",
		"@types/node": "catalog:",
		"@uxfront/typescript-config": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"playwright": "catalog:",
		"solid-js": "catalog:solid2",
		"tsdown": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
