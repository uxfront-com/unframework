        "<button type=\"button\" uf:focused=\"\">",
        "  \"Save\"",
        "</button>",
        "<p role=\"status\">",
        "  \"Saved\"",
        "</p>"
      ],
      "aria": [
        "- button \"Save\"",
        "- status: Saved"
      ],
      "events": {
        "saved": [
          []
        ]
      }
    }
  ]
}
