{
  "name": "@unframework/analyzer",
  "version": "0.0.0",
  "private": true,
  "description": "The Unframework analyser: scopes, macros and semantic checks over the parsed source, and lowering of the returned JSX into the portable IR.",
  "keywords": [
    "analyzer",
    "compiler",
    "jsx",
    "unframework"
  ],
  "homepage": "https://github.com/uxfront-com/unframework/tree/main/packages/analyzer#readme",
  "bugs": "https://github.com/uxfront-com/unframework/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxfront-com/unframework.git",
    "directory": "packages/analyzer"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@typescript-eslint/scope-manager": "catalog:",
    "@unframework/diagnostics": "workspace:*",
    "@unframework/ir": "workspace:*",
    "@unframework/parser": "workspace:*"
  },
  "devDependencies": {
    "@angular/compiler": "catalog:",
    "@babel/core": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/node": "catalog:",
    "@uxfront/typescript-config": "catalog:",
    "parse5": "catalog:",
    "svelte": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
