{
  "name": "@unframework.dev/target-ember",
  "version": "0.0.0",
  "private": true,
  "description": "The Ember 7.4 target of the Unframework compiler: emits `.gts` components from the portable IR, declares their capabilities, and provides the toolchain the tests use.",
  "keywords": [
    "compiler",
    "ember",
    "unframework"
  ],
  "homepage": "https://unframework.dev",
  "bugs": "https://github.com/uxfront-com/unframework/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxfront-com/unframework.git",
    "directory": "packages/target-ember"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./toolchain": "./src/toolchain/index.ts",
    "./toolchain/client": "./src/toolchain/client.ts",
    "./toolchain/server": "./src/toolchain/server.ts",
    "./toolchain/hydrate": "./src/toolchain/hydrate.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./toolchain": {
        "types": "./dist/toolchain/index.d.ts",
        "default": "./dist/toolchain/index.js"
      },
      "./toolchain/client": {
        "types": "./dist/toolchain/client.d.ts",
        "default": "./dist/toolchain/client.js"
      },
      "./toolchain/server": {
        "types": "./dist/toolchain/server.d.ts",
        "default": "./dist/toolchain/server.js"
      },
      "./toolchain/hydrate": {
        "types": "./dist/toolchain/hydrate.d.ts",
        "default": "./dist/toolchain/hydrate.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@unframework.dev/codegen": "workspace:*",
    "@unframework.dev/ir": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@glimmer/component": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/node": "catalog:",
    "@uxfront/typescript-config": "catalog:",
    "babel-plugin-ember-template-compilation": "catalog:",
    "content-tag": "catalog:",
    "decorator-transforms": "catalog:",
    "ember-source": "catalog:",
    "ember-strict-application-resolver": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vite-ember-ssr": "catalog:",
    "vitest": "catalog:"
  }
}
