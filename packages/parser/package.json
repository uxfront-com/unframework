{
  "name": "@unframework/parser",
  "version": "0.0.0",
  "private": true,
  "description": "Parses Unframework sources: .uf.tsx and .uf.ts files into a TS-ESTree AST with spans (oxc), component discovery, and stylesheets (lightningcss).",
  "keywords": [
    "compiler",
    "oxc",
    "parser",
    "unframework"
  ],
  "homepage": "https://github.com/uxfront-com/unframework/tree/main/packages/parser#readme",
  "bugs": "https://github.com/uxfront-com/unframework/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxfront-com/unframework.git",
    "directory": "packages/parser"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "lightningcss": "catalog:",
    "oxc-parser": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@uxfront/typescript-config": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
