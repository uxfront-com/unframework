{
  "name": "@unframework/unplugin",
  "version": "0.0.0",
  "private": true,
  "description": "The Unframework bundler plugin: imports of .uf.tsx files compile to the selected framework, and that framework's own plugin finishes the job.",
  "keywords": [
    "rolldown",
    "rollup",
    "unframework",
    "unplugin",
    "vite",
    "webpack"
  ],
  "homepage": "https://github.com/uxfront-com/unframework/tree/main/packages/unplugin#readme",
  "bugs": "https://github.com/uxfront-com/unframework/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxfront-com/unframework.git",
    "directory": "packages/unplugin"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./bun": "./src/bun.ts",
    "./esbuild": "./src/esbuild.ts",
    "./farm": "./src/farm.ts",
    "./rolldown": "./src/rolldown.ts",
    "./rollup": "./src/rollup.ts",
    "./rsbuild": "./src/rsbuild.ts",
    "./rspack": "./src/rspack.ts",
    "./unloader": "./src/unloader.ts",
    "./vite": "./src/vite.ts",
    "./webpack": "./src/webpack.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./bun": {
        "types": "./dist/bun.d.ts",
        "default": "./dist/bun.js"
      },
      "./esbuild": {
        "types": "./dist/esbuild.d.ts",
        "default": "./dist/esbuild.js"
      },
      "./farm": {
        "types": "./dist/farm.d.ts",
        "default": "./dist/farm.js"
      },
      "./rolldown": {
        "types": "./dist/rolldown.d.ts",
        "default": "./dist/rolldown.js"
      },
      "./rollup": {
        "types": "./dist/rollup.d.ts",
        "default": "./dist/rollup.js"
      },
      "./rsbuild": {
        "types": "./dist/rsbuild.d.ts",
        "default": "./dist/rsbuild.js"
      },
      "./rspack": {
        "types": "./dist/rspack.d.ts",
        "default": "./dist/rspack.js"
      },
      "./unloader": {
        "types": "./dist/unloader.d.ts",
        "default": "./dist/unloader.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "./webpack": {
        "types": "./dist/webpack.d.ts",
        "default": "./dist/webpack.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@unframework/codegen": "workspace:*",
    "@unframework/compiler": "workspace:*",
    "@unframework/diagnostics": "workspace:*",
    "@unframework/parser": "workspace:*",
    "magic-string": "catalog:",
    "unplugin": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@uxfront/typescript-config": "catalog:",
    "astro": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
