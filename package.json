{
  "name": "unframework-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:update": "pnpm --filter @unframework/integration test:update",
    "test:canaries": "pnpm --filter @unframework/integration test:canaries",
    "test:baselines": "pnpm --filter @unframework/integration test:baselines",
    "test:baselines:check": "pnpm --filter @unframework/integration test:baselines:check",
    "new:package": "node scripts/new-package.ts",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@uxfront/oxfmt-config": "^0.1.0",
    "@uxfront/oxlint-config": "^0.1.0",
    "@uxfront/typescript-config": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "turbo": "^2.11.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
