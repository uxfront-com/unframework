# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
# Nuxt builds, and the visual report fixtures rendered by @unframework.dev/visual's tests
.output/


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# The v1 compiler, kept locally for reference only
packages/compiler-v1

# Unframework test harness
.uf-cache
tests/integration/.reports
tests/integration/.canary
tests/integration/.live
# The scratch of a project's run (`unframework test`): the update ledger, live captures, diffs
tests/e2e/design-system/.reports
tests/e2e/design-system/.live
# The same scratch of the fixture projects the testing and visual packages' tests run
packages/*/test/fixtures/*/.reports
packages/*/test/fixtures/*/.live
# A visual run's generated specs, captures and report (`unframework visual`, ADR-0087)
.unframework/
tests/e2e/.tarballs/
# Vitest browser mode attachments and failure screenshots
.vitest-attachments
__screenshots__/**/*-darwin.png
__screenshots__/**/*-win32.png
.uf-tmp
.vitest
